---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';
import { headline, fmtX, money } from '../../lib/headline.ts';
const reports = (await getCollection('reports')).sort((a, b) => b.data.date - a.data.date);
const href = (r) => `/research/${r.id.replace(/^\d{4}-\d{2}-/, '')}`;
const h = headline();
const noteOne = reports.find((report) => report.data.note === 1);
---
<Base title="Research notes — Solvency" description="Research notes on the real cost of AI coding models, re-derived from the underlying data by the test suite.">
  <div class="wrap pt-10">
    <p class="eyebrow">Solvency research</p>
    <h1 class="h-page mt-3">Research notes</h1>
    <p class="lede mt-4 max-w-2xl">Each note is re-derived from the datasets by the test suite before it is published, so a table in a note can never drift from the data behind it.</p>

    <div class="mt-8 card card-pad flex flex-wrap items-center justify-between gap-4">
      <div class="max-w-xl">
        <p class="label">Headline finding</p>
        <p class="mt-2 text-[var(--color-ink)] leading-relaxed">
          <strong>{h.cheap.m.display_name}</strong> is {fmtX(h.inX)} cheaper than {h.dear.m.display_name} per input token and{' '}
          {fmtX(h.outX)} per output token — but <strong class="t-better">▼ {fmtX(h.solvedX)}</strong> cheaper per solved task
          ({money(h.cheap.cost)} vs {money(h.dear.cost)}).
        </p>
      </div>
      {noteOne && <Share url={new URL(href(noteOne), Astro.site).href} compact />}
    </div>

    <ul class="mt-10 grid gap-4">
      {reports.map((r) => (
        <li class="card overflow-hidden">
          <a href={href(r)} class="block card-pad hover:bg-[var(--color-panel-2)] transition-colors group">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <p class="eyebrow">Note {String(r.data.note).padStart(2, '0')}</p>
              <p class="small">published {r.data.date.toISOString().slice(0, 10)}</p>
            </div>
            <h2 class="mt-2 font-[family-name:var(--font-display)] text-2xl font-semibold tracking-tight text-[var(--color-ink)] group-hover:underline">{r.data.title}</h2>
            <p class="mt-2 text-[var(--color-muted)] max-w-3xl leading-relaxed">{r.data.description}</p>
            <p class="mt-4 small text-[var(--color-ink)]">Read the note →</p>
          </a>
          <div class="card-head border-t" data-note-share>
            <p class="small">Share Note {String(r.data.note).padStart(2, '0')}</p>
            <Share url={new URL(href(r), Astro.site).href} text={`${r.data.title}: ${r.data.description}`} compact />
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
