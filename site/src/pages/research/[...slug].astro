---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Share from '../../components/Share.astro';
import { sources, shortSourceName } from '../../lib/data.ts';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((report) => ({
    params: { slug: report.id.replace(/^\d{4}-\d{2}-/, '') },
    props: { report },
  }));
}

const { report } = Astro.props;
const { Content, headings } = await render(report);
const d = report.data;
const stamp = d.date.toISOString().slice(0, 10);
const priceStamp = d.price_verified?.toISOString().slice(0, 10) ?? stamp;
const url = new URL(Astro.url.pathname, Astro.site).href;
const toc = headings.filter((h) => h.depth === 2);
const srcNames = d.pdf_sources ?? sources.map((s) => shortSourceName(s.benchmark)).join(' · ');
const reportMethod = d.pdf_method ?? 'cost ÷ pass rate';
const shareText = `${d.title}: ${d.description}`;
// Per-note stat card (scripts/og-cards.ts -> site/public/og/cards/note-NN.png),
// keyed the same way the article's own eyebrow numbers the note.
const ogCard = `/og/cards/note-${String(d.note).padStart(2, '0')}.png`;
---
<Base title={`${d.title}, Solvency`} description={d.description} og={ogCard} type="article">
  <article class="wrap pt-10">
    <header class="measure">
      <p class="eyebrow">Research note {String(d.note).padStart(2, '0')}</p>
      <h1 class="h-display mt-3">{d.title}</h1>
      <p class="lede mt-5 text-[var(--color-muted)]">{d.description}</p>
    </header>

    <div class="mt-8 card overflow-hidden">
      <dl class="grid grid-cols-2 sm:grid-cols-4 font-mono text-[11px] divide-x divide-[var(--color-rule)]">
        <div class="px-4 py-3"><dt class="label">Published</dt><dd class="mt-1 text-[var(--color-ink)]">{stamp}</dd></div>
        <div class="px-4 py-3"><dt class="label">Prices verified</dt><dd class="mt-1 text-[var(--color-ink)]">{priceStamp}</dd></div>
        <div class="px-4 py-3"><dt class="label">Sources</dt><dd class="mt-1 text-[var(--color-ink)]">{srcNames}</dd></div>
        <div class="px-4 py-3"><dt class="label">Method</dt><dd class="mt-1 text-[var(--color-ink)]">{reportMethod}</dd></div>
      </dl>
      <div class="card-head border-t border-b-0">
        <p class="small">Every table in this note is re-derived from the datasets by the test suite.</p>
        <Share url={url} text={shareText} compact />
      </div>
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)]">
      <nav aria-label="Contents" class="hidden lg:block">
        <div class="sticky top-20 toc">
          <p class="label mb-3">Contents</p>
          {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          <a href="#share" class="mt-4 text-[var(--color-accent)]">Share this note</a>
        </div>
      </nav>
      <div class="prose measure min-w-0"><Content /></div>
    </div>

    <section id="share" class="mt-16 measure lg:ml-[calc(14rem+2.5rem)] card card-pad" aria-label="Share this note">
      <p class="eyebrow">Share this note</p>
      <p class="mt-1 text-sm text-[var(--color-muted)]">The share text comes from this note's published title and description.</p>
      <Share url={url} text={shareText} class="mt-4" />
    </section>
  </article>
</Base>
