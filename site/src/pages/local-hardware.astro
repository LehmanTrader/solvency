---
/**
 * PROTOTYPE — Local Rig Composer (drag-and-drop), deliberately unlinked from
 * the nav, same rollout pattern as /composer-preview (operator direction
 * 2026-08-26: "The local rig UI needs to be something similar to the Compose
 * UI where people can drag and drop various PC components to get their
 * desired build").
 *
 * Drag parts from the shelf into the bay. When the bay's parts exactly match
 * a reference rig profile (the only combinations with a recorded
 * power/throughput profile), quoteRig prices it: build cost, amortization,
 * energy per attempt, $/attempt — and $/solved only once a pass rate is
 * supplied, per the engine's fail-closed rule. Any other combination gates
 * honestly: Solvency does not synthesize a throughput profile for hardware
 * nobody measured.
 */
import Base from '../layouts/Base.astro';
import { RIG_CATALOG, ELECTRICITY_DEFAULT, DEFAULT_WORKLOAD, DEFAULT_HORIZON_MONTHS } from '../lib/rig-catalog.ts';
import { models, bestResultFor, extrasFor, tiers, assumptions } from '../lib/data.ts';
import { costPerSolvedTask, defaultOptions } from '../lib/engine.ts';

// Cloud comparators: the measured leaderboard, computed server-side once.
const opts = defaultOptions(assumptions);
const cloud = models
  .map((m) => {
    const r = bestResultFor(m.model_id);
    if (!r || r.cost_basis !== 'measured_by_source') return null;
    const v = costPerSolvedTask(m as any, 'heavy', tiers.heavy, r.pass_rate, opts, extrasFor(r)).value;
    return v ? { id: m.model_id, name: m.display_name, perSolved: Number(v.naive.toFixed(2)) } : null;
  })
  .filter(Boolean)
  .sort((a: any, b: any) => a!.perSolved - b!.perSolved);

// The parts shelf: every component of every reference rig, deduped by id.
const shelf = RIG_CATALOG.flatMap((e) => e.components.map((c) => ({
  id: c.componentId, label: c.label, condition: c.condition, priceUsd: c.priceUsd, rig: e.id,
})));
const CATALOG_LITE = RIG_CATALOG.map((e) => ({
  id: e.id, name: e.name, family: e.family, summary: e.summary,
  componentIds: e.components.map((c) => c.componentId),
  components: e.components, resale: e.resale, power: e.power, throughput: e.throughput,
  model: e.model, defaultHorizonMonths: e.defaultHorizonMonths,
}));
---
<Base title="Local Rig Composer — Solvency"
      description="Prototype: drag PC components into a bay and price the build the way the Composer prices an agent stack — TCO-modelled cost per attempt, honest Missing until a pass rate exists.">
  <main id="main" class="wrap py-10">
    <p class="label">Local rig composer · preview</p>
    <div class="cp-appbar" style="border-bottom:1px solid var(--color-rule);padding-bottom:1.1rem;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:.75rem 2rem">
      <div><p class="eyebrow">Local Rig Composer</p><h1 class="h-page">Build the box.</h1></div>
      <p style="max-width:34rem;color:var(--color-muted);font-size:.92rem;line-height:1.5">Drag parts into a rig, price it against cloud per solved task, and find your break-even volume — dated part prices, stated power costs.</p>
    </div>
    <p class="mt-2 small">Saved rigs and fleet exports are a planned <a class="link" href="/pricing#pro">Pro</a> feature — everything on this page is free.</p>
    <p class="mt-3 max-w-[62ch] text-[var(--color-body)]">
      Drag parts from the shelf into the bay — or use the Add buttons. A build that matches a
      measured reference profile gets a full quote: hardware amortized over {DEFAULT_HORIZON_MONTHS} months,
      wall power at your electricity rate, cost per attempt, and break-even against a measured
      cloud model. A combination nobody has profiled says so instead of guessing.
    </p>

    <div class="grid gap-4 md:grid-cols-3 mt-6" aria-live="polite">
      <div class="card card-pad"><p class="label">Build cost</p><p class="h-card num mt-1" id="lr-build">—</p></div>
      <div class="card card-pad"><p class="label">Per attempt</p><p class="h-card num mt-1" id="lr-attempt">—</p></div>
      <div class="card card-pad"><p class="label">Per solved task</p><p class="h-card num mt-1" id="lr-solved">Missing</p><p class="small" id="lr-solved-why">Needs a pass rate — never estimated.</p></div>
    </div>

    <div class="grid gap-6 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] mt-8">
      <section aria-labelledby="lr-shelf-h">
        <h2 id="lr-shelf-h" class="h-card">Parts shelf</h2>
        <p class="small mt-1">Every part carries its verified or template price.</p>
        <ul id="lr-shelf" class="mt-3 grid gap-2" role="list">
          {shelf.map((p) => (
            <li class="lr-part card" draggable="true" data-part={p.id} data-rig={p.rig}>
              <div class="flex items-start justify-between gap-3 p-3">
                <div class="min-w-0">
                  <p class="text-[0.9rem] leading-snug">{p.label}</p>
                  <p class="small mt-1"><span class={`lr-cond lr-cond-${p.condition}`}>{p.condition}</span> · <span class="num">${p.priceUsd.toLocaleString()}</span></p>
                </div>
                <button type="button" class="btn btn-quiet lr-add" data-part={p.id} aria-label={`Add ${p.label} to the rig bay`}>Add</button>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="lr-bay-h">
        <h2 id="lr-bay-h" class="h-card">Rig bay</h2>
        <div id="lr-bay" class="lr-bay card mt-3" role="list" aria-label="Your build" aria-describedby="lr-bay-hint">
          <p id="lr-bay-hint" class="small lr-bay-empty">Drop parts here.</p>
        </div>
        <p id="lr-profile" class="small mt-2" role="status"></p>

        <div class="card card-pad mt-4" id="lr-quote-card" hidden>
          <p class="ghead"><span class="gword">Quote</span> · <span id="lr-quote-name"></span></p>
          <dl class="grid gap-x-8 gap-y-2 sm:grid-cols-2 mt-3 text-[0.9rem]">
            <div class="flex justify-between gap-4"><dt>Amortization / month</dt><dd class="num" id="lr-amort">—</dd></div>
            <div class="flex justify-between gap-4"><dt>Electricity / attempt</dt><dd class="num" id="lr-power">—</dd></div>
            <div class="flex justify-between gap-4"><dt>Attempt wall time</dt><dd class="num" id="lr-secs">—</dd></div>
            <div class="flex justify-between gap-4"><dt>Monthly, at this volume</dt><dd class="num" id="lr-month">—</dd></div>
          </dl>
          <p class="small mt-3" id="lr-basis"></p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <label class="block"><span class="label">Tasks / month</span>
              <input id="lr-volume" class="ctl mt-2 w-full" type="number" min="1" max="1000000" step="1" value={DEFAULT_WORKLOAD.tasksPerMonth} /></label>
            <label class="block"><span class="label">Electricity $/kWh</span>
              <input id="lr-kwh" class="ctl mt-2 w-full" type="number" min="0" max="2" step="0.0001" value={ELECTRICITY_DEFAULT.usdPerKwh} /></label>
            <label class="block sm:col-span-2"><span class="label">Pass rate % (yours — measured on your model + quant; blank keeps Missing)</span>
              <input id="lr-pass" class="ctl mt-2 w-full" type="number" min="1" max="100" step="0.1" placeholder="never estimated" /></label>
          </div>
          <div class="mt-5 border-t border-[var(--color-rule)] pt-4">
            <p class="label">Break-even vs a measured cloud model</p>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <select id="lr-cloud" class="ctl">
                {cloud.map((c: any) => <option value={c.perSolved}>{c.name} — ${c.perSolved.toFixed(2)}/solved</option>)}
              </select>
              <p class="small" id="lr-break" role="status"></p>
            </div>
          </div>
        </div>

        <div class="card card-pad mt-4 lr-gate" id="lr-gate" hidden>
          <p class="ghead"><span class="gword">No measured profile</span></p>
          <p class="small mt-2" id="lr-gate-why"></p>
          <p class="small mt-2">Solvency prices only hardware combinations with a recorded power and
            throughput profile — it never synthesizes tokens-per-second for a box nobody measured.
            Complete one of the reference builds, or clear the bay.</p>
        </div>
      </section>
    </div>

    <p class="small mt-8 max-w-[68ch]">Basis: <code>local_tco_modeled</code> (rig-cost-v1) — hardware
      amortized against resale over {DEFAULT_HORIZON_MONTHS} months, wall power at the rate above, reference-model
      throughput as recorded per profile. Cloud comparators are the measured leaderboard. Cost per
      solved task appears only with a pass rate you assert for your own model and quant.</p>
  </main>

  <script type="application/json" id="lr-catalog" is:inline set:html={JSON.stringify(CATALOG_LITE)}></script>
  <script type="application/json" id="lr-electricity" is:inline set:html={JSON.stringify(ELECTRICITY_DEFAULT)}></script>
  <script type="application/json" id="lr-workload" is:inline set:html={JSON.stringify(DEFAULT_WORKLOAD)}></script>

  <script>
    import { quoteRig } from '../lib/rig-cost.ts';

    const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
    const catalog = JSON.parse($('lr-catalog').textContent!) as any[];
    const electricityDefault = JSON.parse($('lr-electricity').textContent!) as any;
    const workloadDefault = JSON.parse($('lr-workload').textContent!) as any;
    const money = (v: number, dp = 2) => `$${v.toFixed(dp)}`;

    const bay = $('lr-bay');
    const parts: string[] = [];
    const partById = new Map<string, any>();
    for (const e of catalog) for (const c of e.components) partById.set(c.componentId, c);

    function renderBay() {
      bay.querySelectorAll('.lr-bay-item').forEach((n) => n.remove());
      const empty = bay.querySelector<HTMLElement>('.lr-bay-empty')!;
      empty.hidden = parts.length > 0;
      for (const id of parts) {
        const c = partById.get(id)!;
        const row = document.createElement('div');
        row.className = 'lr-bay-item';
        row.setAttribute('role', 'listitem');
        row.innerHTML = `<span class="min-w-0 text-[0.9rem]">${c.label}</span>
          <span class="num small">$${c.priceUsd.toLocaleString()}</span>
          <button type="button" class="btn btn-quiet" data-remove="${id}" aria-label="Remove ${c.label}">×</button>`;
        bay.appendChild(row);
      }
      quote();
    }

    function matchProfile(): { entry?: any; hint: string } {
      if (!parts.length) return { hint: '' };
      const set = [...parts].sort().join('|');
      const entry = catalog.find((e) => [...e.componentIds].sort().join('|') === set);
      if (entry) return { entry, hint: '' };
      const partial = catalog.find((e) => parts.every((p) => e.componentIds.includes(p)));
      if (partial) {
        const missing = partial.componentIds.filter((p: string) => !parts.includes(p)).map((p: string) => partById.get(p).label);
        return { hint: `On the way to the ${partial.name} profile — still needs: ${missing.join('; ')}.` };
      }
      return { hint: 'These parts span different reference builds; no recorded profile covers the mix.' };
    }

    function quote() {
      const { entry, hint } = matchProfile();
      const gate = $('lr-gate'), card = $('lr-quote-card'), profile = $('lr-profile');
      const buildTotal = parts.reduce((a, id) => a + partById.get(id).priceUsd, 0);
      $('lr-build').textContent = parts.length ? money(buildTotal, 0) : '—';
      if (!entry) {
        card.hidden = true;
        gate.hidden = parts.length === 0;
        $('lr-gate-why').textContent = hint;
        profile.textContent = '';
        $('lr-attempt').textContent = '—';
        $('lr-solved').textContent = 'Missing';
        $('lr-solved-why').textContent = 'Needs a pass rate — never estimated.';
        return;
      }
      gate.hidden = true;
      profile.textContent = `Matched profile: ${entry.name} — ${entry.summary}`;
      const volume = Math.max(1, Number(($('lr-volume') as unknown as HTMLInputElement).value) || workloadDefault.tasksPerMonth);
      const kwh = Math.max(0, Number(($('lr-kwh') as unknown as HTMLInputElement).value) || electricityDefault.usdPerKwh);
      const passPct = Number(($('lr-pass') as unknown as HTMLInputElement).value);
      const model = { ...entry.model };
      if (passPct >= 1 && passPct <= 100) {
        model.passRate = { rate: passPct / 100, benchmark: 'user-supplied benchmark', basis: 'measured_by_user', assertionOrigin: 'user_asserted' };
      }
      const spec = {
        schemaVersion: 1, name: entry.name,
        components: entry.components, resale: entry.resale, power: entry.power, throughput: entry.throughput,
        electricity: { ...electricityDefault, usdPerKwh: kwh, ...(kwh !== electricityDefault.usdPerKwh ? { assertionOrigin: 'user_asserted', region: 'your rate' } : {}) },
        workload: { ...workloadDefault, tasksPerMonth: volume },
        horizonMonths: entry.defaultHorizonMonths,
        model,
      };
      const q = quoteRig(spec as any, '2026-08-26T00:00:00.000Z');
      card.hidden = false;
      $('lr-quote-name').textContent = q.rigName;
      $('lr-attempt').textContent = q.costPerAttemptUsd != null ? money(q.costPerAttemptUsd, 4) : '—';
      $('lr-amort').textContent = q.amortizationPerMonthUsd != null ? money(q.amortizationPerMonthUsd) : '—';
      $('lr-power').textContent = q.electricityPerAttemptUsd != null ? money(q.electricityPerAttemptUsd, 4) : '—';
      $('lr-secs').textContent = q.attemptSeconds != null ? `${q.attemptSeconds.toFixed(0)}s` : '—';
      $('lr-month').textContent = q.monthlyCostUsd != null ? money(q.monthlyCostUsd) : '—';
      $('lr-solved').textContent = q.costPerSolvedTaskUsd != null ? money(q.costPerSolvedTaskUsd, 4) : 'Missing';
      $('lr-solved-why').textContent = q.costPerSolvedTaskUsd != null
        ? `at your asserted ${passPct.toFixed(1)}% pass rate` : 'Needs a pass rate — never estimated.';
      $('lr-basis').textContent = `Throughput ${q.throughput.tokensPerSecond} tok/s (${q.throughput.runtime}, ${q.throughput.method}); power ${q.power.systemWatts}W (${q.power.method}); ${q.missing.length ? 'missing: ' + q.missing.join(', ') : 'no missing inputs'}.`;
      const cloudPerSolved = Number(($('lr-cloud') as unknown as HTMLSelectElement).value);
      const breakEl = $('lr-break');
      if (q.costPerSolvedTaskUsd == null) {
        breakEl.textContent = 'Break-even needs the rig’s cost per solved task — supply a pass rate first.';
      } else if (q.costPerSolvedTaskUsd >= cloudPerSolved) {
        breakEl.textContent = `Not at this volume: the rig’s ${money(q.costPerSolvedTaskUsd, 2)}/solved is not below the cloud’s ${money(cloudPerSolved)}/solved.`;
      } else {
        breakEl.textContent = `Cheaper per solved task than this cloud row at your asserted pass rate — ${money(q.costPerSolvedTaskUsd, 2)} vs ${money(cloudPerSolved)}; hardware is already amortized inside the rig figure.`;
      }
    }

    function add(id: string) { if (!parts.includes(id)) { parts.push(id); renderBay(); } }
    document.querySelectorAll<HTMLElement>('.lr-part').forEach((el) => {
      el.addEventListener('dragstart', (e) => {
        (e as DragEvent).dataTransfer!.setData('text/plain', el.dataset.part!);
        (e as DragEvent).dataTransfer!.effectAllowed = 'copy';
        el.classList.add('lr-dragging');
      });
      el.addEventListener('dragend', () => el.classList.remove('lr-dragging'));
    });
    document.querySelectorAll<HTMLButtonElement>('.lr-add').forEach((b) =>
      b.addEventListener('click', () => add(b.dataset.part!)));
    bay.addEventListener('dragover', (e) => { e.preventDefault(); bay.classList.add('lr-over'); });
    bay.addEventListener('dragleave', () => bay.classList.remove('lr-over'));
    bay.addEventListener('drop', (e) => {
      e.preventDefault(); bay.classList.remove('lr-over');
      const id = (e as DragEvent).dataTransfer!.getData('text/plain');
      if (partById.has(id)) add(id);
    });
    bay.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
      if (btn) { parts.splice(parts.indexOf(btn.dataset.remove!), 1); renderBay(); }
    });
    for (const id of ['lr-volume', 'lr-kwh', 'lr-pass', 'lr-cloud']) $(id).addEventListener('input', quote);
    renderBay();
  </script>

  <style>
    .lr-part { cursor: grab; }
    .lr-part.lr-dragging { opacity: .5; }
    .lr-bay { min-height: 9rem; padding: .75rem; border-style: dashed; transition: border-color .12s, background .12s; }
    .lr-bay.lr-over { border-color: var(--color-purple); background: color-mix(in srgb, var(--color-purple) 6%, transparent); }
    .lr-bay-item { display: flex; align-items: center; justify-content: space-between; gap: .75rem;
      padding: .5rem .25rem; border-top: 1px solid var(--color-rule); }
    .lr-bay-item:first-of-type { border-top: 0; }
    .lr-cond { font-family: var(--font-mono); font-size: .6875rem; text-transform: uppercase; letter-spacing: .06em;
      border: 1px solid var(--color-rule-strong); border-radius: 4px; padding: 0 .3rem; }
    .lr-cond-used { color: var(--color-purple); border-color: var(--color-purple); }
    .lr-gate { border-color: var(--color-rule-strong); }
  </style>
</Base>
