---
/**
 * Homepage — enterprise marketing surface (redesign 2026-08-27 night,
 * xhawk.ai-style brief: dark hero, persona-segmented pitch, product behind
 * its own login at /app). The calculator moved to /calculator (public
 * evidence layer); an inline forwarder below keeps every previously shared
 * "/?tier=..." scenario link resolving. Cross-functional pitch: the same
 * repricing engine serves engineering, operations, marketing and sales —
 * roadmap in docs/roadmap-cross-functional.md.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { models } from '../lib/data.ts';

const latest = (await getCollection('reports')).sort((a, b) => b.data.date - a.data.date)[0];
const latestHref = latest ? `/research/${latest.id.replace(/^\d{4}-\d{2}-/, '')}` : '/research';
const verified = models.reduce((a, m) => (m.last_verified > a ? m.last_verified : a), '');

const personas = [
  { k: 'Engineering', h: 'Which seats earn their fee', p: 'Reprice every Claude Code, Codex and API seat at metered rates. Keep, downgrade or move each one — with the math attached.' },
  { k: 'Operations', h: 'Spend by team, against budget', p: 'One ledger for AI spend across tools and vendors. Budget thresholds, drift alerts, renewal briefs built from what you actually used.' },
  { k: 'Marketing', h: 'Cost per asset, not per token', p: 'Price the content pipeline — per drafted post, image and campaign variant — and right-size models for creative work vs analysis.' },
  { k: 'Sales', h: 'AI cost per deal, attributed', p: 'Cost per enriched lead, per outreach, per qualified meeting. Put real AI numbers into CAC before the board asks.' },
];

const suite = [
  { label: 'Budgets', href: '/build-planner', h: 'Plan a stack before you commit', p: 'The Composer prices whole stacks — orchestrator, workers, harness, access path — from measured pass rates, not list-price arithmetic.', cta: 'Open the Composer →', live: true },
  { label: 'Actuals', href: '/actuals', h: 'Reconcile what you really spent', p: 'Drop in a usage export: seat-by-seat repricing at verified metered rates and a keep / review / move verdict per seat.', cta: 'See how Actuals works →', live: true },
  { label: 'Governance', href: '/app#ops', h: 'Keep spend inside policy', p: 'Budgets by team and tool, threshold alerts, model-mix drift and idle-seat flags — in design partnership now.', cta: 'Preview in the console →', live: false },
];
---
<Base title="Solvency — the AI spend suite"
      description="Budget the work. Reconcile the bill. Right-size the seats. AI spend economics for engineering, operations, marketing and sales — built on first-party task-level benchmarks."
      og="/og/cards/home.png">
  <!-- Old calculator share links resolved to "/?tier=..." before the
       enterprise redesign; forward them to the table's new public home. -->
  <script is:inline>(function(){var q=new URLSearchParams(location.search);if(['tier','volume','variant','highlight','pop','taskcount'].some(function(k){return q.has(k)}))location.replace('/calculator'+location.search+location.hash);})();</script>

  <section class="hero-dark">
    <div class="wrap pt-14 pb-16 md:pt-20 md:pb-20">
      <p class="eyebrow" style="color:#8FA0D8">The AI spend suite</p>
      <h1 class="hero-h mt-4">AI is priced in tokens.<br />Your business buys outcomes.</h1>
      <p class="hero-p mt-5 max-w-2xl">Solvency prices the outcome — per solved task, per produced asset, per closed deal — so every team's AI budget, bill and seat count stands on a measured number.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-accent" style="font-size:.9rem;padding:.7rem 1.2rem" href="/app">Open the console</a>
        <a class="btn hero-btn-ghost" style="font-size:.9rem;padding:.7rem 1.2rem" href="/research">See the evidence</a>
      </div>
      <div class="hero-stats mt-12">
        <div><b>{models.length}</b><span>models on verified metered rates</span></div>
        <div><b>First-party</b><span>agentic bench, journaled runs</span></div>
        <div><b>Fail closed</b><span>missing numbers reported, never guessed</span></div>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="mt-16" aria-labelledby="teams-h">
      <p class="eyebrow">Every team that spends on AI</p>
      <h2 class="h-section mt-2" id="teams-h">One engine, four ledgers</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {personas.map((t) => (
          <div class="card card-pad">
            <p class="label" style="color:var(--color-accent)">{t.k}</p>
            <h3 class="h-card mt-2">{t.h}</h3>
            <p class="small mt-2">{t.p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-16" aria-labelledby="suite-h">
      <p class="eyebrow">The suite</p>
      <h2 class="h-section mt-2" id="suite-h">Budget it. Reconcile it. Govern it.</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {suite.map((s) => (
          <a class="card card-pad block suite-door" href={s.href}>
            <p class="label" style="color:var(--color-accent)">{s.label}{!s.live && <span class="small" style="color:var(--color-muted)"> · preview</span>}</p>
            <h3 class="h-card mt-1">{s.h}</h3>
            <p class="small mt-2">{s.p}</p>
            <p class="mt-3 font-semibold" style="color:var(--color-accent)">{s.cta}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-16 card card-pad" aria-labelledby="ev-h">
      <div class="md:flex md:items-start md:justify-between gap-8">
        <div class="max-w-2xl">
          <p class="eyebrow">Why trust the numbers</p>
          <h2 class="h-section mt-2" id="ev-h">The suite sits on an instrument, not a spreadsheet</h2>
          <p class="small mt-3">Under every budget and verdict: our own benchmark harness — hidden-test agentic tasks, journaled runs, measured harness overheads — plus a metered-rate catalog verified {verified}. Where a number does not exist, it is reported as missing.</p>
        </div>
        <div class="mt-5 md:mt-0 shrink-0 space-y-2 text-sm">
          <p><a class="link" href="/calculator">The ranked table →</a></p>
          <p><a class="link" href={latestHref}>Latest research note →</a></p>
          <p><a class="link" href="/methodology">How the numbers are made →</a></p>
        </div>
      </div>
    </section>

    <section class="mt-16 mb-4 text-center hero-dark rounded-xl" aria-labelledby="cta-h">
      <div class="py-12 px-6">
        <h2 class="h-section" id="cta-h" style="color:#fff">Put a number under your AI spend</h2>
        <p class="hero-p mt-3 max-w-xl mx-auto">The console is free while we build with design partners. Bring one usage export; leave with seat verdicts.</p>
        <div class="mt-6 flex justify-center gap-3">
          <a class="btn btn-accent" style="font-size:.9rem;padding:.7rem 1.2rem" href="/app">Open the console</a>
          <a class="btn hero-btn-ghost" style="font-size:.9rem;padding:.7rem 1.2rem" href="mailto:robertdhanda@gmail.com?subject=Solvency%20design%20partner">Become a design partner</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .hero-dark { background: #0C1122; color: #B9C0D4; }
    .hero-dark { background: radial-gradient(1200px 500px at 20% -10%, #1A2342 0%, #0C1122 55%); }
    .hero-h { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.08; color: #fff; letter-spacing: -.01em; }
    .hero-p { font-size: 1.02rem; line-height: 1.6; color: #B9C0D4; }
    .hero-btn-ghost { color: #fff; border-color: #3A4468; background: transparent; }
    .hero-btn-ghost:hover { background: #1A2342; border-color: #8FA0D8; color: #fff; }
    .hero-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; max-width: 46rem; }
    .hero-stats b { display: block; font-family: var(--font-mono); font-size: 1.25rem; color: #fff; font-variant-numeric: tabular-nums; }
    .hero-stats span { font-size: .78rem; color: #8FA0D8; }
    .suite-door { transition: border-color .12s, transform .12s; }
    .suite-door:hover { border-color: var(--color-accent); transform: translateY(-2px); }
  </style>
</Base>
