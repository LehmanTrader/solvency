---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Calculator from '../components/Calculator.astro';
import Provenance from '../components/Provenance.astro';
import { headline, fmtX } from '../lib/headline.ts';
import { DEFAULTS, compute, allChartRows } from '../lib/calc.ts';
import { scatterPareto } from '../lib/charts.ts';
import { sources } from '../lib/data.ts';

const latest = (await getCollection('reports')).sort((a, b) => b.data.date - a.data.date)[0];
const latestHref = latest ? `/research/${latest.id.replace(/^\d{4}-\d{2}-/, '')}` : '/research';
const h = headline();
const aa = sources.find((s) => s.benchmark === 'aa-coding-agent-index');

// Chart B at the defaults; the island re-renders it with the visitor's settings.
const { rows } = compute(DEFAULTS);
const all = allChartRows(rows, DEFAULTS);
const lead = all.find((r) => r.basis === 'measured')?.id;
const scatterWide = scatterPareto(all, { width: 720, compact: false, lead });
const scatterNarrow = scatterPareto(all, { width: 350, height: 350, compact: true, lead });

const how = [
  { k: 'The number', v: 'cost per solved task = cost per attempt ÷ pass rate', n: 'What it costs to get a task finished, not what a token costs.' },
  { k: 'Measured', v: 'the benchmark observed the cost', n: 'No Solvency assumption is inside these figures. Tier and assumptions cannot move them.' },
  { k: 'Modelled', v: 'pass rate published, cost from verified prices', n: 'Solvency\'s loop model, labelled as an assumption and adjustable. Never ranked against measured rows.' },
];
---
<Base title="Solvency — which AI coding model is cheapest per solved task"
      description="Which AI coding model is cheapest for your tasks and volume? Cost per solved task from measured benchmark runs and verified prices, with a source and date on every number.">
  <div class="wrap pt-8 md:pt-10">
    <div class="max-w-4xl mx-auto">
      <Calculator />
      <p class="mt-6 text-[var(--color-body)] leading-relaxed max-w-[64ch]">
        Token price predicts almost nothing: {h.cheap.m.display_name} is {fmtX(h.outX)} cheaper per output token than{' '}
        {h.dear.m.display_name} — and <strong class="text-[var(--color-ink)]">{fmtX(h.solvedX)} cheaper per solved task</strong>.{' '}
        <a class="link" href={latestHref}>Read the note →</a>
      </p>
    </div>

    <section id="frontier" class="mt-20 max-w-4xl mx-auto" aria-labelledby="frontier-h">
      <h2 id="frontier-h" class="h-section">Why not just pick the top score?</h2>
      <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_15rem] items-start">
        <div class="card card-pad" id="scatter">
          <div class="hidden sm:block" data-chart data-layout="wide" data-w="720" set:html={scatterWide}></div>
          <div class="sm:hidden" data-chart data-layout="narrow" data-w="350" set:html={scatterNarrow}></div>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-3">
            <label class="small inline-flex items-center gap-2 min-h-11 cursor-pointer"><input id="scatter-stale" type="checkbox" class="size-4 accent-[var(--color-ink)]" /> Show stale pass rates</label>
            <Provenance class="mt-0" source={aa?.attribution} href={aa?.attribution_url} verified={aa?.last_verified} />
          </div>
        </div>
        <div class="text-sm leading-relaxed text-[var(--color-body)]">
          <p>Lower and to the right is better. The line joins the measured models nobody beats on both axes.</p>
          <p class="mt-3 text-[var(--color-muted)]">Modelled points move with your tier and assumptions; measured points never do. Hover or focus a point for its pass rate, cost and harness; click it for the model page.</p>
          <a class="link small mt-4 inline-block" href="/methodology">See how the frontier is computed →</a>
        </div>
      </div>
    </section>

    <section id="how" class="mt-20 max-w-4xl mx-auto" aria-labelledby="how-h">
      <h2 id="how-h" class="h-section">How it is computed</h2>
      <div class="tile-grid mt-6 sm:grid-cols-3">
        {how.map((t) => (
          <div class="tile">
            <p class="label">{t.k}</p>
            <p class="mt-2 font-mono text-sm text-[var(--color-ink)]">{t.v}</p>
            <p class="mt-2 text-sm text-[var(--color-muted)] leading-relaxed">{t.n}</p>
          </div>
        ))}
      </div>
      <p class="small mt-3"><a class="link" href="/methodology">Methodology</a> · <a class="link" href="/methodology#sources">Sources</a> · <a class="link" href={latestHref}>Research note {String(latest?.data.note ?? 1).padStart(2, '0')}</a></p>
    </section>
  </div>
</Base>
