---
/**
 * Homepage rebuild #3 (2026-08-28 evening, operator direction): cursor-driven
 * product demos replace the static story boxes ("that should be an animated
 * demo of the console at work with the mouse clicking around"), feature
 * cards carry illustrations, prose is sans (readability pass in global.css),
 * and the copy carries no em dashes anywhere. Demos: DemoActuals in the
 * hero (light console window on the dark ground, xhawk pattern), then
 * DemoBudget / DemoActuals-full / DemoGovern as the three workflow
 * sections. Scroll reveals and the share-link forwarder carry over.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DemoActuals from '../components/DemoActuals.astro';
import DemoBudget from '../components/DemoBudget.astro';
import DemoGovern from '../components/DemoGovern.astro';
import { models } from '../lib/data.ts';

const latest = (await getCollection('reports')).sort((a, b) => b.data.date - a.data.date)[0];
const latestHref = latest ? `/research/${latest.id.replace(/^\d{4}-\d{2}-/, '')}` : '/research';
const verified = models.reduce((a, m) => (m.last_verified > a ? m.last_verified : a), '');
const DEMO = 'mailto:robertdhanda@gmail.com?subject=Solvency%20demo&body=Team%20size%2C%20AI%20tools%20in%20use%2C%20roughly%20what%20you%20spend%20monthly%3A';

const ART = {
  actuals: `<svg viewBox="0 0 120 56" fill="none"><rect x="4" y="8" width="66" height="7" rx="3.5" fill="#5B45E0"/><circle cx="112" cy="11.5" r="5" fill="#1E7A3D" opacity=".85"/><rect x="4" y="24" width="40" height="7" rx="3.5" fill="#8E80E6"/><circle cx="112" cy="27.5" r="5" fill="#B8860B" opacity=".8"/><rect x="4" y="40" width="18" height="7" rx="3.5" fill="#C9CCD6"/><circle cx="112" cy="43.5" r="5" fill="#D32F2F" opacity=".8"/><rect x="78" y="8" width="26" height="7" rx="3.5" fill="#E3E5EB"/><rect x="52" y="24" width="52" height="7" rx="3.5" fill="#E3E5EB"/><rect x="30" y="40" width="74" height="7" rx="3.5" fill="#E3E5EB"/></svg>`,
  budgets: `<svg viewBox="0 0 120 56" fill="none"><rect x="4" y="6" width="52" height="12" rx="6" fill="#E3E5EB"/><rect x="4" y="22" width="72" height="12" rx="6" fill="#8E80E6"/><rect x="4" y="38" width="44" height="12" rx="6" fill="#E3E5EB"/><rect x="84" y="14" width="32" height="28" rx="7" fill="#5B45E0"/><text x="100" y="32" text-anchor="middle" font-family="monospace" font-size="10" fill="#fff">$0.61</text></svg>`,
  hardware: `<svg viewBox="0 0 120 56" fill="none"><rect x="10" y="8" width="26" height="40" rx="5" fill="#191B22"/><circle cx="23" cy="16" r="2.5" fill="#8E80E6"/><rect x="16" y="24" width="14" height="3" rx="1.5" fill="#3A4468"/><rect x="16" y="31" width="14" height="3" rx="1.5" fill="#3A4468"/><path d="M78 18a12 12 0 0 1 24 2 9 9 0 0 1-2 17.8H76A11 11 0 0 1 78 18z" fill="#E3E5EB"/><path d="M48 28h20m0 0-5-5m5 5-5 5" stroke="#5B45E0" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  ops: `<svg viewBox="0 0 120 56" fill="none"><rect x="6" y="24" width="82" height="9" rx="4.5" fill="#E3E5EB"/><rect x="6" y="24" width="60" height="9" rx="4.5" fill="#5B45E0"/><rect x="72" y="18" width="3" height="21" rx="1.5" fill="#D32F2F"/><path d="M104 16a8 8 0 0 1 8 8v6l3 4h-22l3-4v-6a8 8 0 0 1 8-8z" fill="#B8860B" opacity=".85"/><circle cx="104" cy="38" r="2.6" fill="#B8860B"/></svg>`,
  marketing: `<svg viewBox="0 0 120 56" fill="none"><rect x="8" y="12" width="34" height="34" rx="6" fill="#E3E5EB" transform="rotate(-6 8 12)"/><rect x="34" y="8" width="34" height="36" rx="6" fill="#8E80E6"/><circle cx="45" cy="20" r="5" fill="#fff" opacity=".85"/><path d="M36 38l9-9 7 6 8-9 8 12" stroke="#fff" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/><rect x="82" y="18" width="30" height="14" rx="7" fill="#5B45E0"/><text x="97" y="28" text-anchor="middle" font-family="monospace" font-size="8.6" fill="#fff">$/asset</text></svg>`,
  sales: `<svg viewBox="0 0 120 56" fill="none"><path d="M16 8h64L64 30v16l-16 6V30L16 8z" fill="#E3E5EB"/><path d="M28 12h40L56 27v13l-8 3V27L28 12z" fill="#8E80E6"/><circle cx="98" cy="16" r="7" fill="#5B45E0"/><circle cx="106" cy="34" r="5" fill="#8E80E6"/><circle cx="94" cy="44" r="3.6" fill="#C9CCD6"/><text x="98" y="19.4" text-anchor="middle" font-family="monospace" font-size="8.4" fill="#fff">$</text></svg>`,
};

const features = [
  { href: '/app#actuals', tag: 'Actuals', live: true, art: ART.actuals, h: 'Seat verdicts from real usage', p: 'Drop an export and every seat gets keep, review, or move, priced in your browser.' },
  { href: '/app#budgets', tag: 'Budgets', live: true, art: ART.budgets, h: 'Price a stack before you commit', p: 'Orchestrator, workers, and harness quoted from measured pass rates.' },
  { href: '/app#hardware', tag: 'Hardware', live: true, art: ART.hardware, h: 'Local rig vs cloud break-even', p: 'Apple Silicon and used-GPU builds priced per solved task.' },
  { href: '/app#ops', tag: 'Operations', live: false, art: ART.ops, h: 'Budgets, drift and idle-seat alerts', p: 'Spend by team and tool, flagged before the invoice lands.' },
  { href: '/app#marketing', tag: 'Marketing', live: false, art: ART.marketing, h: 'Cost per produced asset', p: 'Price the content pipeline per post, image and variant.' },
  { href: '/app#sales', tag: 'Sales', live: false, art: ART.sales, h: 'AI cost per deal, attributed', p: 'Per-lead and per-meeting costs that survive CAC math.' },
];
---
<Base title="Solvency · the AI spend suite"
      description="Budget the work. Reconcile the bill. Right-size the seats. AI spend economics for engineering, operations, marketing and sales, built on first-party task-level benchmarks."
      og="/og/cards/home.png">
  <script is:inline>(function(){var q=new URLSearchParams(location.search);if(['tier','volume','variant','highlight','pop','taskcount'].some(function(k){return q.has(k)}))location.replace('/calculator'+location.search+location.hash);})();</script>

  <section class="hero-dark hero-main">
    <div class="wrap pt-14 pb-16 md:pt-20 md:pb-24 hero-grid">
      <div>
        <p class="eyebrow" style="color:#8FA0D8" data-reveal>The AI spend suite</p>
        <h1 class="hero-h mt-4" data-reveal="1" data-d=".08s">AI is priced in tokens.<br />Your business buys outcomes.</h1>
        <p class="hero-p mt-5" style="max-width:30rem" data-reveal="1" data-d=".16s">Budget the work, reconcile the bill, right-size the seats. Measured numbers for every team that spends on AI.</p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal="1" data-d=".24s">
          <a class="btn btn-accent btn-lg" href={DEMO} data-analytics="hero-demo">Request a demo</a>
          <a class="btn hero-btn-ghost btn-lg" href="/app">Open the console</a>
        </div>
        <div class="hero-stats mt-10" data-reveal="1" data-d=".32s">
          <div><b>{models.length}</b><span>models on verified rates</span></div>
          <div><b>First-party</b><span>bench, journaled runs</span></div>
          <div><b>Fail closed</b><span>missing is never guessed</span></div>
        </div>
      </div>
      <div class="hero-demo" data-parallax data-reveal="1" data-d=".2s">
        <DemoActuals />
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="mt-20" aria-labelledby="story-h">
      <p class="eyebrow" data-reveal>See it work</p>
      <h2 class="h-section mt-2" id="story-h" data-reveal="1" data-d=".06s">Three workflows, one console</h2>

      <div class="story mt-10">
        <div class="story-row" data-reveal>
          <div class="story-copy">
            <p class="story-n">01</p>
            <h3 class="h-card">Budget it</h3>
            <p class="story-p mt-2">Compose the stack, watch the quote reprice as you change it, save the plan. Every figure comes from measured pass rates.</p>
          </div>
          <div class="story-demo"><DemoBudget /></div>
        </div>

        <div class="story-row rev" data-reveal>
          <div class="story-copy">
            <p class="story-n">02</p>
            <h3 class="h-card">Reconcile it</h3>
            <p class="story-p mt-2">Drop the usage export your vendor already gives you. Seats reprice at metered rates, and one click opens the model mix behind any verdict.</p>
          </div>
          <div class="story-demo"><DemoActuals full={true} /></div>
        </div>

        <div class="story-row" data-reveal>
          <div class="story-copy">
            <p class="story-n">03</p>
            <h3 class="h-card">Govern it</h3>
            <p class="story-p mt-2">Set the threshold, arm the alert, and hear about the overrun before the invoice does. Budgets live per team and per tool.</p>
          </div>
          <div class="story-demo"><DemoGovern /></div>
        </div>
      </div>
    </section>

    <section class="mt-20" aria-labelledby="feat-h">
      <p class="eyebrow" data-reveal>Inside the console</p>
      <h2 class="h-section mt-2" id="feat-h" data-reveal="1" data-d=".06s">One login. Every AI ledger.</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f, i) => (
          <a class="card feat block" href={f.href} data-reveal="1" data-d={`${(i % 3) * 0.08}s`}>
            <span class="feat-art" aria-hidden="true"><Fragment set:html={f.art} /></span>
            <span class="feat-body">
              <p class="label" style="color:var(--color-accent)">{f.tag}{!f.live && <span class="small" style="color:var(--color-muted)"> · preview</span>}</p>
              <h3 class="h-card mt-1">{f.h}</h3>
              <p class="small mt-2">{f.p}</p>
            </span>
          </a>
        ))}
      </div>
      <p class="small mt-6" data-reveal>Engineering, operations, marketing, sales. Same engine, four ledgers. <a class="link" href={DEMO}>Request a demo</a> or <a class="link" href="/app">open the console</a>.</p>
    </section>

    <section class="mt-20 card card-pad" aria-labelledby="ev-h" data-reveal>
      <div class="md:flex md:items-center md:justify-between gap-8">
        <div class="max-w-xl">
          <p class="eyebrow">The receipts</p>
          <h2 class="h-card mt-2" id="ev-h">Built on an instrument, not a spreadsheet</h2>
          <p class="small mt-2">First-party agentic bench, journaled runs, and a metered catalog verified {verified}. Where a number does not exist, it is reported as missing.</p>
        </div>
        <div class="mt-5 md:mt-0 shrink-0 space-y-2 text-sm">
          <p><a class="link" href="/calculator">The ranked table →</a></p>
          <p><a class="link" href={latestHref}>Latest research note →</a></p>
          <p><a class="link" href="/methodology">Methodology →</a></p>
        </div>
      </div>
    </section>

    <section class="mt-20 mb-4 text-center hero-dark rounded-xl" aria-labelledby="cta-h" data-reveal>
      <div class="py-12 px-6">
        <h2 class="h-section" id="cta-h" style="color:#fff">Put a number under your AI spend</h2>
        <p class="hero-p mt-3 max-w-xl mx-auto">Free while we build with design partners. Bring one usage export and leave with seat verdicts.</p>
        <div class="mt-6 flex justify-center gap-3">
          <a class="btn btn-accent btn-lg" href={DEMO} data-analytics="footer-demo">Request a demo</a>
          <a class="btn hero-btn-ghost btn-lg" href="/app">Open the console</a>
        </div>
      </div>
    </section>
  </div>

  <style>
    .hero-dark { background: radial-gradient(1200px 500px at 20% -10%, #1A2342 0%, #0C1122 55%); color: #B9C0D4; }
    .hero-main { position: relative; overflow: hidden; }
    .hero-main::after { content: ""; position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(700px 320px at 82% 30%, rgba(91,69,224,.16), transparent 70%);
      animation: hero-breathe 9s ease-in-out infinite alternate; }
    @keyframes hero-breathe { from { opacity: .5; transform: translateY(0); } to { opacity: 1; transform: translateY(14px); } }
    .hero-grid { display: grid; gap: 3rem; align-items: center; position: relative; z-index: 1; }
    @media (min-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 36rem); } }
    .hero-h { font-family: var(--font-serif); font-size: clamp(1.9rem, 4.4vw, 3.2rem); line-height: 1.08; color: #fff; letter-spacing: -.01em; }
    .hero-p { font-family: var(--font-sans); font-size: 1.05rem; line-height: 1.65; color: #B9C0D4; }
    .btn-lg { font-size: .9rem; padding: .7rem 1.2rem; }
    .hero-btn-ghost { color: #fff; border-color: #3A4468; background: transparent; }
    .hero-btn-ghost:hover { background: #1A2342; border-color: #8FA0D8; color: #fff; }
    .hero-stats { display: grid; grid-template-columns: repeat(3, auto); gap: 1.4rem; justify-content: start; }
    .hero-stats b { display: block; font-family: var(--font-mono); font-size: 1.15rem; color: #fff; font-variant-numeric: tabular-nums; }
    .hero-stats span { font-family: var(--font-sans); font-size: .74rem; color: #8FA0D8; }
    .hero-demo { will-change: transform; }

    [data-reveal] { opacity: 0; transform: translateY(18px);
      transition: opacity .55s ease var(--d, 0s), transform .65s cubic-bezier(.22,1,.36,1) var(--d, 0s); }
    [data-reveal].in { opacity: 1; transform: none; }

    .story { display: flex; flex-direction: column; gap: 4rem; }
    .story-row { display: grid; gap: 1.8rem; align-items: center; }
    @media (min-width: 820px) {
      .story-row { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); }
      .story-row.rev { grid-template-columns: minmax(0, 1fr) minmax(0, 20rem); }
      .story-row.rev .story-copy { order: 2; }
      .story-row.rev .story-demo { order: 1; }
    }
    .story-n { font-family: var(--font-mono); font-size: .7rem; color: var(--color-accent); letter-spacing: .12em; margin-bottom: .3rem; }
    .story-p { font-family: var(--font-sans); font-size: .92rem; line-height: 1.65; color: var(--color-body); max-width: 34ch; }

    .feat { display: flex; flex-direction: column; overflow: hidden; transition: border-color .15s, transform .2s cubic-bezier(.22,1,.36,1), opacity .55s ease var(--d, 0s), box-shadow .2s; }
    .feat:hover { border-color: var(--color-accent); transform: translateY(-3px); box-shadow: 0 14px 30px -18px rgba(10, 14, 35, .35); }
    .feat-art { display: block; padding: 1.1rem 1.25rem .4rem; background: var(--color-panel-2); }
    .feat-art svg { display: block; width: 100%; height: auto; max-height: 74px; }
    .feat-body { display: block; padding: .9rem 1.25rem 1.1rem; }

    @media (prefers-reduced-motion: reduce) {
      [data-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
      .hero-main::after { animation: none; }
      .hero-demo { transform: none !important; }
    }
  </style>

  <script>
    for (const el of document.querySelectorAll<HTMLElement>('[data-d]')) el.style.setProperty('--d', el.dataset.d!);

    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealed = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (reduce) {
      revealed.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
      revealed.forEach((el) => io.observe(el));

      const frame = document.querySelector<HTMLElement>('[data-parallax]');
      if (frame) {
        let raf = 0;
        const tick = () => { raf = 0; frame.style.transform = `translateY(${Math.min(scrollY, 900) * -0.045}px)`; };
        addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
      }
    }
  </script>
</Base>
