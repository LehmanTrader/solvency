---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((report) => ({
    params: { slug: report.id.replace(/^\d{4}-\d{2}-/, '') },
    props: { report },
  }));
}

const { report } = Astro.props;
const { Content } = await render(report);
const d = report.data;
const stamp = d.date.toISOString().slice(0, 10);
---
<Base title={`${d.title} — Solvency`} description={d.description}>
  <article>
    <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-[var(--color-accent)]">
      Research Note {String(d.note).padStart(2, '0')}
    </p>
    <h1 class="mt-3 font-mono text-4xl sm:text-5xl font-bold leading-[1.08] tracking-tight text-[var(--color-ink)]">
      {d.title}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-[var(--color-muted)]">{d.description}</p>

    <dl class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-y-4 gap-x-6 border-y border-[var(--color-rule)] py-4 font-mono text-[11px]">
      <div><dt class="uppercase tracking-[0.14em] text-[var(--color-muted)]">Verified</dt><dd class="mt-1 text-[var(--color-ink)]">{stamp}</dd></div>
      <div><dt class="uppercase tracking-[0.14em] text-[var(--color-muted)]">Sources</dt><dd class="mt-1 text-[var(--color-ink)]">AA · SEAL · Aider</dd></div>
      <div><dt class="uppercase tracking-[0.14em] text-[var(--color-muted)]">Method</dt><dd class="mt-1 text-[var(--color-ink)]">cost ÷ pass rate</dd></div>
      <div><dt class="uppercase tracking-[0.14em] text-[var(--color-muted)]">Status</dt><dd class="mt-1 text-[var(--color-accent)]">Phase 0</dd></div>
    </dl>

    <div class="prose mt-10"><Content /></div>
  </article>
</Base>
