  function renderInvalidDraft(draft: BuildPlanV1, issues: BuildPlanIssue[]) {
    lastDraftValid = false;
    markPlanIssues(issues);
    byId('b-role-count').textContent = `${draft.roles.length} role${draft.roles.length === 1 ? '' : 's'}`;
    byId('b-attempt').textContent = 'Missing';
    byId('b-solved').textContent = 'Missing';
    byId('b-solved').classList.add('missing');
    byId('b-solved-note').textContent = 'Resolve the plan errors below';
    byId('b-month').textContent = 'Missing';
    byId('b-month-note').textContent = 'No quote is calculated from invalid inputs';
    byId('b-attempts').textContent = 'Missing';

    const messages = byId('b-messages'); messages.replaceChildren();
    const list = document.createElement('ul');
    list.className = 'small list-disc pl-5 text-[var(--color-worse)]';
    for (const issue of issues) {
      const item = document.createElement('li'); item.textContent = issueMessage(issue); list.appendChild(item);
    }
    messages.appendChild(list);

    const breakdown = byId('b-breakdown'); breakdown.replaceChildren();
    const row = document.createElement('tr');
    const unavailable = cell('Cost contribution is unavailable until the plan inputs are valid.');
    unavailable.colSpan = 5; row.appendChild(unavailable); breakdown.appendChild(row);
    const ledger = byId('b-ledger'); ledger.replaceChildren();
    const ledgerItem = document.createElement('li');
    ledgerItem.textContent = 'Assumption provenance is unavailable until the plan inputs are valid.';
    ledger.appendChild(ledgerItem);

    for (const id of ['b-export-json', 'b-export-csv', 'b-export-png']) byId<HTMLButtonElement>(id).disabled = true;
    byId('b-export-ready').textContent = 'Resolve the plan errors above before exporting.';
    byId<HTMLButtonElement>('b-save-version').disabled = true;
    byId<HTMLButtonElement>('b-duplicate').disabled = true;
    renderWorkspace();
  }

  function render() {
    if (!rolesEl.children.length) return;
    byId('b-export-status').textContent = '';
    byId('b-export-error').textContent = '';
    const draft = readPlan();
    const validated = validateUntrustedBuildPlanV1(draft, eligibleModels);
    if (!validated.ok) {
      renderInvalidDraft(draft, validated.issues);
      return;
    }
    clearPlanIssueControls();
    lastPlan = validated.value;
    lastQuote = validated.quote;
    lastDraftValid = true;
    byId('b-role-count').textContent = `${lastPlan.roles.length} role${lastPlan.roles.length === 1 ? '' : 's'}`;
    byId('b-attempt').textContent = money(lastQuote.buildAttemptCostUsd);
    byId('b-solved').textContent = money(lastQuote.variableCostPerSuccessfulBuildUsd);
    byId('b-solved').classList.toggle('missing', lastQuote.variableCostPerSuccessfulBuildUsd === null);
    byId('b-solved-note').textContent = lastQuote.variableCostPerSuccessfulBuildUsd === null ? 'Success rate not supplied' : 'Variable spend ÷ whole-system success';
    byId('b-month').textContent = money(lastQuote.monthlyCostUsd);
    byId('b-month-note').textContent = lastQuote.monthlyCostUsd === null ? 'Successful-build volume needs a success rate' : 'Variable + fixed harness spend';
    byId('b-attempts').textContent = lastQuote.attemptedBuildsPerMonth === null ? 'Missing' : lastQuote.attemptedBuildsPerMonth.toLocaleString(undefined, { maximumFractionDigits: 1 });

    const messages = byId('b-messages'); messages.replaceChildren();
    const lines = lastQuote.errors.length ? lastQuote.errors : lastQuote.warnings;
    if (!lines.length) {
      const p = document.createElement('p'); p.className = 'small'; p.textContent = lastQuote.missing.includes('endToEndSuccess.rate')
        ? 'Quote valid. Cost per completed build remains missing until you supply a whole-system success rate.'
        : 'Quote valid. Every role uses its own model rate and token profile.'; messages.appendChild(p);
    } else {
      const ul = document.createElement('ul'); ul.className = `small list-disc pl-5 ${lastQuote.errors.length ? 'text-[var(--color-worse)]' : ''}`;
      for (const line of lines) { const li = document.createElement('li'); li.textContent = line; ul.appendChild(li); }
      messages.appendChild(ul);
    }

    const breakdown = byId('b-breakdown'); breakdown.replaceChildren();
    for (const role of lastQuote.roles) {
      const tr = document.createElement('tr');
      tr.append(cell(role.label), cell(role.modelName), cell(role.expectedInvocations.toLocaleString(undefined, { maximumFractionDigits: 2 }), true), cell(money(role.costPerInvocationUsd), true), cell(money(role.costPerBuildAttemptUsd), true));
      breakdown.appendChild(tr);
    }
    if (lastPlan.harness.fixedCostPerBuildAttemptUsd > 0) {
      const tr = document.createElement('tr'); tr.append(cell('Harness overhead'), cell(lastPlan.harness.name), cell('1', true), cell(money(lastPlan.harness.fixedCostPerBuildAttemptUsd), true), cell(money(lastPlan.harness.fixedCostPerBuildAttemptUsd), true)); breakdown.appendChild(tr);
    }

    const ledger = byId('b-ledger'); ledger.replaceChildren();
    const harnessLi = document.createElement('li'); harnessLi.textContent = `${lastPlan.harness.name}${lastPlan.harness.version ? ` ${lastPlan.harness.version}` : ''} · ${lastPlan.harness.configBasis.replaceAll('_', ' ')} · origin ${lastPlan.harness.assertionOrigin!.replaceAll('_', ' ')}`; ledger.appendChild(harnessLi);
    for (const role of lastQuote.roles) {
      const li = document.createElement('li');
      li.textContent = `${role.label}: ${role.modelName} · ${role.priceBasis.replaceAll('_', ' ')} · price origin ${role.priceAssertionOrigin.replaceAll('_', ' ')}${role.priceLastVerified ? ` · price verified ${role.priceLastVerified}` : ''} · usage ${role.usageBasis.replaceAll('_', ' ')} · usage origin ${role.usageAssertionOrigin.replaceAll('_', ' ')}`;
      ledger.appendChild(li);
    }
    const successLi = document.createElement('li'); successLi.textContent = lastPlan.endToEndSuccess
      ? `Whole-system success: ${(lastPlan.endToEndSuccess.rate * 100).toFixed(1)}% · ${lastPlan.endToEndSuccess.basis.replaceAll('_', ' ')} · origin ${lastPlan.endToEndSuccess.assertionOrigin!.replaceAll('_', ' ')}`
      : 'Whole-system success: not supplied; solved-build cost is intentionally missing.'; ledger.appendChild(successLi);
    for (const id of ['b-export-json', 'b-export-csv', 'b-export-png']) byId<HTMLButtonElement>(id).disabled = !lastQuote.valid;
    byId('b-export-ready').textContent = lastQuote.valid ? 'Current quote ready to export.' : 'Fix the quote errors above before exporting.';
    byId<HTMLButtonElement>('b-save-version').disabled = !lastQuote.valid;
    byId<HTMLButtonElement>('b-duplicate').disabled = !lastQuote.valid;
    renderWorkspace();
  }

  function markOperationSettingsChanged(target: HTMLInputElement | HTMLSelectElement) {
    if (target.id.startsWith('b-share-')) {
      byId('b-share-error').textContent = '';
      byId('b-share-status').textContent = snapshots.length ? 'Draft settings changed; save to apply.' : '';
    }
    if (target.id.startsWith('b-alert-')) {
      byId('b-alert-error').textContent = '';
      byId('b-alert-status').textContent = snapshots.length ? 'Draft settings changed; save to apply.' : '';
      byId<HTMLInputElement>('b-alert-threshold').removeAttribute('aria-invalid');
      if (target.id === 'b-alert-trigger') renderAlertThreshold();
      else syncOperationControls();
    }
  }

  form.addEventListener('input', (event) => {
    const target = event.target as HTMLInputElement | HTMLSelectElement;
    if (target.closest('#build-operations')) {
      markOperationSettingsChanged(target);
      return;
    }
    const role = target.closest('[data-role]');
    if (role && target.matches('[data-field="label"]')) renumber();
    if (role && target.matches('[data-field="custom-toggle"]')) {
      const on = (target as HTMLInputElement).checked;
      (role.querySelector('.custom-prices') as HTMLElement).hidden = !on;
      if (on) seedCustomPrices(role);
    }
    if (role && target.matches('[data-field="model"]') && field<HTMLInputElement>(role, 'custom-toggle').checked) {
      for (const name of ['custom-input', 'custom-cache', 'custom-output']) field<HTMLInputElement>(role, name).value = '';
      seedCustomPrices(role);
    }
    render();
    if (!editedValidQuoteTracked && lastDraftValid && lastQuote.valid) {
      editedValidQuoteTracked = true;
      track('build_quote_first_edit_valid', { path: location.pathname, role_count: String(lastPlan.roles.length), custom_prices: String(lastPlan.roles.some((item) => Boolean(item.priceOverride))) });
    }
  });
  form.addEventListener('focusout', (event) => {
    const target = event.target as HTMLInputElement;
    const canonicalTextField = ['b-name', 'b-harness', 'b-version'].includes(target.id)
      || target.matches('[data-field="label"]');
    if (!canonicalTextField) return;
    const canonical = target.value.normalize('NFC').trim();
    if (target.value === canonical) return;
    target.value = canonical;
    if (target.matches('[data-field="label"]')) renumber();
    render();
  });
  byId('b-add-role').addEventListener('click', () => addRole());
  byId('b-export-json').addEventListener('click', () => exportCurrent('json'));
  byId('b-export-csv').addEventListener('click', () => exportCurrent('csv'));
  byId('b-export-png').addEventListener('click', () => exportCurrent('png'));
  byId('b-save-version').addEventListener('click', () => {
    if (!lastDraftValid || !lastQuote.valid) return;
    const snapshot = createBuildSnapshot(snapshots, currentPlanId, crypto.randomUUID(), lastPlan, eligibleModels);
    snapshots.push(snapshot);
    baselineSnapshotId ??= snapshot.snapshotId;
    byId('b-workspace-message').textContent = `Saved ${snapshot.plan.name} version ${snapshot.version} in this tab.`;
    renderWorkspace();
  });
  byId('b-duplicate').addEventListener('click', () => {
    if (!lastDraftValid || !lastQuote.valid) return;
    const source = createBuildSnapshot(snapshots, currentPlanId, crypto.randomUUID(), lastPlan, eligibleModels);
    snapshots.push(source);
    const newPlanId = crypto.randomUUID();
    const duplicate = duplicateBuildSnapshot(source, newPlanId, crypto.randomUUID(), `${lastPlan.name} copy`, eligibleModels);
    snapshots.push(duplicate);
    baselineSnapshotId = source.snapshotId;
    currentPlanId = newPlanId;
    applyPlan(duplicate.plan);
    byId('b-workspace-message').textContent = `Duplicated ${source.plan.name}; the original is now the comparison baseline.`;
    renderWorkspace();
  });

  byId('b-share-save').addEventListener('click', () => {
    const error = byId('b-share-error'), status = byId('b-share-status'); error.textContent = ''; status.textContent = '';
    try {
      const rawExpiry = byId<HTMLSelectElement>('b-share-expiry').value;
      const expiry = rawExpiry === 'none' ? null : Number(rawExpiry) as ShareExpiryDays;
      shareDraft = createShareDraft(snapshots, byId<HTMLSelectElement>('b-share-version').value, expiry, byId<HTMLInputElement>('b-share-export').checked);
      renderShareDraft(); status.textContent = 'Share settings saved in this tab. No link was created or copied.';
      track('build_share_draft_save', { path: location.pathname, expiry: rawExpiry, allow_export: String(shareDraft.allowQuoteExport) });
    } catch (cause) { error.textContent = cause instanceof Error ? cause.message : 'Could not save the share draft.'; }
  });
  byId('b-share-remove').addEventListener('click', () => {
    shareDraft = null; renderShareDraft(); byId('b-share-error').textContent = '';
    byId('b-share-status').textContent = 'Share draft removed. No remote link existed.'; byId<HTMLButtonElement>('b-share-save').focus();
  });

  byId('b-alert-trigger').addEventListener('change', () => markOperationSettingsChanged(byId<HTMLSelectElement>('b-alert-trigger')));
  byId('b-alert-save').addEventListener('click', () => {
    const error = byId('b-alert-error'), status = byId('b-alert-status'), threshold = byId<HTMLInputElement>('b-alert-threshold');
    error.textContent = ''; status.textContent = ''; threshold.removeAttribute('aria-invalid');
    try {
      const trigger = byId<HTMLSelectElement>('b-alert-trigger').value as BuildAlertTrigger;
      const draft = createAlertDraft(snapshots, {
        alertId: editingAlertId ?? crypto.randomUUID(), snapshotId: byId<HTMLSelectElement>('b-alert-version').value,
        trigger, threshold: trigger === 'model_price_change' ? null : Number(threshold.value),
        baselineSnapshotId: byId<HTMLSelectElement>('b-alert-baseline').value || null,
      });
      const existing = alertDrafts.findIndex((item) => item.alertId === draft.alertId);
      if (existing >= 0) alertDrafts.splice(existing, 1, draft); else alertDrafts.push(draft);
      editingAlertId = null; byId<HTMLButtonElement>('b-alert-save').textContent = 'Save alert draft'; renderAlerts(); syncOperationControls();
      status.textContent = 'Alert draft saved in this tab. Monitoring and email are off.';
      track('build_alert_draft_save', { path: location.pathname, trigger });
    } catch (cause) {
      error.textContent = cause instanceof Error ? cause.message : 'Could not save the alert draft.';
      if (/threshold/i.test(error.textContent)) { threshold.setAttribute('aria-invalid', 'true'); threshold.focus(); }
    }
  });

  byId('b-pro-interest').addEventListener('click', () => {
    const status = byId('b-pro-interest-status');
    const emitted = track('build_pro_price_interest', { path: location.pathname, price_hypothesis: '19_monthly' });
    if (signedIn()) status.textContent = emitted ? 'Thanks—this click was sent as a directional research signal. Nothing was charged.' : 'You are signed in, but analytics is unavailable. Nothing was charged.';
    else {
      const opened = openSignUp('build-pro-price-interest', 'Share interest in Build Composer Pro at $19/month. No checkout or charge.');
      status.textContent = opened ? 'Free-account sign-up opened. There is no checkout or charge.' : 'Sign-up is unavailable in this preview. There is no checkout or charge.';
    }
  });

  addRole({
    roleId: 'orchestrator', kind: 'orchestrator', label: 'Orchestrator', modelId: 'claude-fable-5', expectedInvocationsPerBuildAttempt: 1,
    usagePerInvocation: { uncachedInputTokens: 100000, cacheReadTokens: 0, cacheWriteTokens: 0, outputTokens: 10000, basis: 'template_assumption' },
  });
  addRole({
    roleId: 'worker-pool', kind: 'worker', label: 'Worker pool', modelId: 'gpt-5.6-luna', expectedInvocationsPerBuildAttempt: 6,
    usagePerInvocation: { uncachedInputTokens: 20000, cacheReadTokens: 30000, cacheWriteTokens: 0, outputTokens: 2000, basis: 'template_assumption' },
  });
  renderAlertThreshold();
  track('build_planner_view', { path: location.pathname });
</script>

