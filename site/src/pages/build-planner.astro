  const cleanCanvasText = (text: string) => text.replace(/[\u0000-\u001f\u007f-\u009f]/g, ' ').replace(/\s+/g, ' ').trim();
  function fitCanvasText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number): string {
    const clean = cleanCanvasText(text);
    if (ctx.measureText(clean).width <= maxWidth) return clean;
    let result = clean;
    while (result.length && ctx.measureText(`${result}…`).width > maxWidth) result = result.slice(0, -1);
    return `${result}…`;
  }
  function wrapCanvasText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number, maxLines: number): string[] {
    const words = cleanCanvasText(text).split(' ').filter(Boolean);
    const lines: string[] = [];
    let line = '';
    for (const word of words) {
      const next = line ? `${line} ${word}` : word;
      if (ctx.measureText(next).width <= maxWidth || !line) line = next;
      else { lines.push(line); line = word; if (lines.length === maxLines - 1) break; }
    }
    if (line && lines.length < maxLines) lines.push(line);
    const original = words.join(' ');
    if (lines.join(' ') !== original && lines.length) lines[lines.length - 1] = fitCanvasText(ctx, `${lines.at(-1)}…`, maxWidth);
    return lines;
  }

  function downloadBlob(blob: Blob, filename: string) {
    const href = URL.createObjectURL(blob);
    const anchor = document.createElement('a'); anchor.href = href; anchor.download = filename; anchor.hidden = true;
    document.body.appendChild(anchor); anchor.click(); anchor.remove();
    setTimeout(() => URL.revokeObjectURL(href), 0);
  }

  async function buildPngBlob(plan: BuildPlanV1, quote: ReturnType<typeof quoteBuildPlan>): Promise<Blob> {
    const summary = buildExportSummary(plan, quote);
    const width = 1200;
    const noticeReserve = 160;
    const height = Math.min(2200, 700 + summary.roles.length * 48 + noticeReserve);
    const canvas = document.createElement('canvas'); canvas.width = width; canvas.height = height;
    const ctx = canvas.getContext('2d'); if (!ctx) throw new Error('PNG rendering is unavailable in this browser.');
    ctx.fillStyle = '#0A0C0D'; ctx.fillRect(0, 0, width, height);
    ctx.strokeStyle = '#2C3338'; ctx.lineWidth = 2; ctx.strokeRect(48, 48, width - 96, height - 96);
    ctx.fillStyle = '#E0A02E'; ctx.fillRect(72, 74, 7, 28);
    ctx.fillStyle = '#F4F1EA'; ctx.font = '700 22px ui-monospace, monospace'; ctx.fillText('SOLVENCY · BUILD QUOTE', 96, 98);
    ctx.fillStyle = '#A7ADB3'; ctx.font = '16px ui-monospace, monospace'; ctx.fillText(`Generated ${new Date(summary.quotedAt).toISOString()} · ${summary.engineVersion}`, 72, 132);
    ctx.fillStyle = '#F4F1EA'; ctx.font = '700 38px system-ui, sans-serif'; ctx.fillText(fitCanvasText(ctx, summary.planName, 1056), 72, 188);
    ctx.fillStyle = '#A7ADB3'; ctx.font = '18px ui-monospace, monospace'; ctx.fillText(fitCanvasText(ctx, `Harness: ${summary.harness}`, 1056), 72, 222);

    summary.metrics.forEach((metric, index) => {
      const col = index % 2, row = Math.floor(index / 2), x = 72 + col * 540, y = 260 + row * 116;
      ctx.fillStyle = '#111519'; ctx.fillRect(x, y, 516, 92); ctx.strokeStyle = '#2C3338'; ctx.strokeRect(x, y, 516, 92);
      ctx.fillStyle = '#A7ADB3'; ctx.font = '14px ui-monospace, monospace'; ctx.fillText(metric.label.toUpperCase(), x + 18, y + 28);
      ctx.fillStyle = metric.value.startsWith('Missing') ? '#B8A47A' : '#F4F1EA'; ctx.font = '700 24px ui-monospace, monospace'; ctx.fillText(fitCanvasText(ctx, metric.value, 480), x + 18, y + 64);
    });

    const rolesY = 516;
    ctx.fillStyle = '#A7ADB3'; ctx.font = '14px ui-monospace, monospace';
    ctx.fillText('ROLE', 72, rolesY); ctx.fillText('MODEL', 380, rolesY); ctx.fillText('CALLS', 760, rolesY); ctx.fillText('COST / BUILD', 900, rolesY);
    ctx.strokeStyle = '#2C3338'; ctx.beginPath(); ctx.moveTo(72, rolesY + 14); ctx.lineTo(1128, rolesY + 14); ctx.stroke();
    summary.roles.forEach((role, index) => {
      const y = rolesY + 52 + index * 48;
      ctx.fillStyle = '#F4F1EA'; ctx.font = '17px ui-monospace, monospace'; ctx.fillText(fitCanvasText(ctx, role.label, 280), 72, y);
      ctx.fillStyle = '#CCD0D2'; ctx.fillText(fitCanvasText(ctx, role.modelName, 350), 380, y);
      ctx.fillText(role.expectedInvocations.toLocaleString('en-US', { maximumFractionDigits: 2 }), 760, y);
      ctx.fillStyle = '#F4F1EA'; ctx.fillText(role.costPerBuildAttempt, 900, y);
      ctx.fillStyle = '#727B82'; ctx.font = '12px ui-monospace, monospace'; ctx.fillText(fitCanvasText(ctx, `${role.priceBasis.replaceAll('_', ' ')} · usage ${role.usageBasis.replaceAll('_', ' ')}${role.priceLastVerified ? ` · verified ${role.priceLastVerified}` : ''}`, 1056), 72, y + 19);
    });
    const footerY = rolesY + 78 + summary.roles.length * 48;
    ctx.fillStyle = '#A7ADB3'; ctx.font = '14px system-ui, sans-serif';
    let y = footerY;
    for (const notice of summary.notices) {
      for (const line of wrapCanvasText(ctx, notice, 1056, 2)) { ctx.fillText(line, 72, y); y += 20; }
      y += 6;
    }
    return await new Promise<Blob>((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Could not encode the PNG file.')), 'image/png'));
  }

  async function exportCurrent(format: BuildExportFormat) {
    const status = byId('b-export-status'), error = byId('b-export-error'); status.textContent = ''; error.textContent = '';
    for (const id of ['b-export-json', 'b-export-csv', 'b-export-png']) byId<HTMLButtonElement>(id).setAttribute('aria-busy', 'true');
    try {
      const validated = validateUntrustedBuildPlanV1(readPlan(), eligibleModels);
      if (!validated.ok) {
        render();
        throw new Error('Resolve the current plan errors before exporting.');
      }
      const { value: plan, quote } = validated;
      if (format === 'json') downloadBlob(new Blob([buildExportJson(plan, quote)], { type: 'application/json;charset=utf-8' }), buildExportFilename(plan.name, format));
      else if (format === 'csv') downloadBlob(new Blob([buildExportCsv(plan, quote)], { type: 'text/csv;charset=utf-8' }), buildExportFilename(plan.name, format));
      else downloadBlob(await buildPngBlob(plan, quote), buildExportFilename(plan.name, format));
      status.textContent = `Downloaded ${format.toUpperCase()}. The file was generated locally.`;
      track('build_export', { path: location.pathname, format, role_count: String(plan.roles.length), custom_prices: String(plan.roles.some((role) => Boolean(role.priceOverride))) });
    } catch (cause) {
      error.textContent = cause instanceof Error ? `${cause.message} Nothing was uploaded.` : `Couldn’t create the ${format.toUpperCase()} file. Nothing was uploaded. Try again.`;
    } finally {
      for (const id of ['b-export-json', 'b-export-csv', 'b-export-png']) byId<HTMLButtonElement>(id).removeAttribute('aria-busy');
    }
  }

