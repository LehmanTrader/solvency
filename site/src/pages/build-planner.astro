---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { models } from '../lib/data.ts';
import { BUILD_PLAN_LIMITS } from '../lib/build-plan-limits.ts';
import { CLERK_ENABLED } from '../lib/clerk.ts';

const currentModels = models.filter((model) => model.status === 'current');
const ACCOUNT_PLANS_ENABLED = import.meta.env.PUBLIC_ACCOUNT_PLANS_ENABLED === 'true';
const PRODUCT_INTENTS_ENABLED = import.meta.env.PUBLIC_PRODUCT_INTENTS_ENABLED === 'true';
const ACCOUNT_PLAN_PREVIEW_MAX_PLANS = 20;
const ACCOUNT_PLAN_PREVIEW_MAX_VERSIONS = 100;
const harnessExamples = [
  'Custom harness', 'Hermes Agent', 'Claude Code', 'Codex', 'Pi', 'Grok Build',
  'Cursor', 'OpenCode', 'OpenHands', 'Goose',
];
---
<Base title="Build Composer — budget any agent stack — Solvency"
      description="Price any agent harness or custom orchestration: assign different models to orchestrator and worker roles, enter routing volume and token usage, and see cost per build and monthly spend.">
  <div class="wrap pt-8 md:pt-12" id="build-planner">
    <p class="eyebrow">Build Composer · preview</p>
    <h1 class="h-page mt-3">Budget any agent stack.</h1>
    <p class="mt-4 lede max-w-3xl">
      Name any harness—or your own custom harness—then assign a model, expected calls and token
      profile to every orchestrator, worker or fallback role. The quote prices the role mix and
      expected routing volume you enter.
    </p>

    <section class="mt-6 card card-pad grid gap-4 sm:grid-cols-[1fr_auto] items-start" aria-labelledby="composer-access-title">
      <div>
        <p class="label">Current access · open preview</p>
        <h2 class="h-card mt-2" id="composer-access-title">No subscription or Pro entitlement is active.</h2>
        <p class="small mt-2 max-w-3xl">Build pricing, sensitivity, tab-only versions and local downloads work now. Account plans appear only when the storage preview is enabled. {ACCOUNT_PLANS_ENABLED
          ? 'A signed-in user can create and revoke unlisted links for a selected account plan and save inactive alert settings; no scheduled check or email is running.'
          : 'Unlisted-link delivery and monitoring remain settings-only prototypes: no link, scheduled check or email is created.'}</p>
        <a class="link inline-block mt-3" href="#packaging">Compare today’s preview with planned Pro ↓</a>
      </div>
      <span class="pill pill-ink">No checkout yet</span>
    </section>

    <form class="mt-8 grid gap-6" id="composer-form" novalidate
          data-account-plans-enabled={ACCOUNT_PLANS_ENABLED ? 'true' : 'false'}
          data-clerk-enabled={CLERK_ENABLED ? 'true' : 'false'}>
      <section class="card overflow-hidden" aria-labelledby="harness-title">
        <div class="card-head">
          <div><p class="label">Step 1</p><h2 class="h-card mt-1" id="harness-title">Harness and workload</h2></div>
          <p class="small">Free-form: presets are suggestions, not restrictions.</p>
        </div>
        <div class="card-pad grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          <label class="block sm:col-span-2">
            <span class="label">Plan name</span>
            <input class="ctl ctl-row mt-2 w-full" id="b-name" maxlength={BUILD_PLAN_LIMITS.maxPlanNameChars} value="Fable orchestrator + lower-cost workers" />
          </label>
          <label class="block sm:col-span-2">
            <span class="label">Harness name</span>
            <input class="ctl ctl-row mt-2 w-full" id="b-harness" list="harness-examples" maxlength={BUILD_PLAN_LIMITS.maxHarnessNameChars} value="Custom harness" autocomplete="off" />
            <datalist id="harness-examples">{harnessExamples.map((name) => <option value={name} />)}</datalist>
            <span class="small block mt-1">Type any public, internal or custom harness.</span>
          </label>
          <label class="block">
            <span class="label">Harness version</span>
            <input class="ctl ctl-row mt-2 w-full" id="b-version" maxlength={BUILD_PLAN_LIMITS.maxHarnessVersionChars} placeholder="optional" />
          </label>
          <label class="block">
            <span class="label">Configuration basis</span>
            <select class="ctl ctl-row mt-2 w-full" id="b-harness-basis">
              <option value="user_supplied">User supplied</option>
              <option value="solvency_template">Solvency template</option>
              <option value="published">Published measurement · user asserted</option>
            </select>
          </label>
          <label class="block">
            <span class="label">Build volume / month</span>
            <input class="ctl ctl-row mt-2 w-full" id="b-volume" type="number" min="1" max={BUILD_PLAN_LIMITS.maxBuildsPerMonth} step="any" value="100" />
          </label>
          <label class="block">
            <span class="label">Volume means</span>
            <select class="ctl ctl-row mt-2 w-full" id="b-volume-basis">
              <option value="attempted_builds">Attempted builds</option>
              <option value="successful_builds">Successful builds</option>
            </select>
          </label>
          <label class="block">
            <span class="label">Harness overhead / attempt</span>
            <span class="money-input mt-2"><span>$</span><input class="ctl ctl-row w-full" id="b-overhead" type="number" min="0" max={BUILD_PLAN_LIMITS.maxFixedCostUsd} step="any" value="0" /></span>
          </label>
          <label class="block">
            <span class="label">Fixed harness cost / month</span>
            <span class="money-input mt-2"><span>$</span><input class="ctl ctl-row w-full" id="b-fixed" type="number" min="0" max={BUILD_PLAN_LIMITS.maxFixedCostUsd} step="any" value="0" /></span>
          </label>
          <label class="block lg:col-span-2">
            <span class="label">End-to-end system success</span>
            <span class="percent-input mt-2"><input class="ctl ctl-row w-full" id="b-success" type="number" min="0.01" max="100" step="any" placeholder="Not supplied" /><span>%</span></span>
            <span class="small block mt-1">Optional. Must describe the whole configured system—not individual model benchmarks.</span>
          </label>
          <label class="block lg:col-span-2">
            <span class="label">Success-rate basis</span>
            <select class="ctl ctl-row mt-2 w-full" id="b-success-basis">
              <option value="user_assumption">User assumption</option>
              <option value="measured_by_user">Measured by you · user asserted</option>
              <option value="published_system_run">Published system run · user asserted</option>
            </select>
          </label>
        </div>
      </section>

      <section aria-labelledby="roles-title">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div><p class="label">Step 2</p><h2 class="h-section mt-1" id="roles-title">Model roles and routing volume</h2></div>
          <button type="button" class="btn" id="b-add-role" data-analytics="build-add-role">Add model role +</button>
        </div>
        <p class="small mt-2 max-w-3xl">Expected calls can be fractional: eight worker tasks routed 75% to one pool become 6 expected calls per build attempt. Preview safety limit: 24 roles.</p>
        <div class="mt-4 grid gap-4" id="b-roles"></div>
      </section>

      <section class="grid gap-4 lg:grid-cols-[.9fr_1.1fr] items-start" aria-labelledby="quote-title">
        <div class="card overflow-hidden lg:sticky lg:top-20">
          <div class="card-head"><div><p class="label">Step 3</p><h2 class="h-card mt-1" id="quote-title">Build quote</h2></div><span class="pill pill-ink" id="b-role-count">0 roles</span></div>
          <div class="tile-grid grid-cols-2" aria-live="polite" aria-atomic="false">
            <div class="tile"><p class="label">Per build attempt</p><p class="tile-v" id="b-attempt">—</p><p class="tile-n">Harness overhead + every expected role call</p></div>
            <div class="tile"><p class="label">Per completed build</p><p class="tile-v" id="b-solved">Missing</p><p class="tile-n" id="b-solved-note">Supply a whole-system success rate</p></div>
            <div class="tile"><p class="label">Monthly spend</p><p class="tile-v" id="b-month">—</p><p class="tile-n" id="b-month-note">At the workload above</p></div>
            <div class="tile"><p class="label">Attempted builds / month</p><p class="tile-v" id="b-attempts">—</p><p class="tile-n">Derived only when inputs permit</p></div>
          </div>
          <div class="card-pad border-t border-[var(--color-rule)]" id="b-messages" aria-live="polite"></div>
          <div class="px-5 py-3 border-t border-[var(--color-rule)] flex flex-wrap gap-2">
            <a class="btn" href="#build-operations">Export options ↓</a>
            <button type="button" class="btn" id="b-save-version" data-analytics="build-save-version">Save in this tab</button>
            <button type="button" class="btn" id="b-duplicate" data-analytics="build-duplicate">Duplicate plan</button>
          </div>
        </div>

        <div class="grid gap-4">
          <div class="card overflow-hidden">
            <div class="card-head"><h3 class="h-card">Cost contribution by role</h3><p class="small">Per attempted build</p></div>
            <p class="small px-5 pt-3 sm:hidden">Swipe the table to see every cost column →</p>
            <div class="tbl-wrap"><table class="tbl">
              <caption>Model role, expected calls, cost per call and contribution to each attempted build</caption>
              <thead><tr><th scope="col">Role</th><th scope="col">Model</th><th scope="col" class="r">Calls</th><th scope="col" class="r">$ / call</th><th scope="col" class="r">$ / build</th></tr></thead>
              <tbody id="b-breakdown"></tbody>
            </table></div>
          </div>
          <div class="card card-pad">
            <h3 class="h-card">Assumption and provenance ledger</h3>
            <ul class="mt-3 ledger" id="b-ledger"></ul>
          </div>
        </div>
      </section>

      <section class="card overflow-hidden" aria-labelledby="workspace-title">
        <div class="card-head">
          <div><p class="label">Step 4 · preview</p><h2 class="h-card mt-1" id="workspace-title">Plan versions and scenario delta</h2></div>
          <span class="pill pill-ink" id="b-version-count">0 saved</span>
        </div>
        <div class="card-pad grid gap-6">
          <div class="grid gap-5 lg:grid-cols-[.8fr_1.2fr]">
            <div>
              <p class="text-sm leading-relaxed text-[var(--color-body)]">Save an immutable quote, duplicate the current architecture, then edit the copy to see its cost delta against a baseline.</p>
              <p class="small mt-2">Preview storage in the list beside this copy is limited to this open tab. It disappears when the tab closes and is never uploaded automatically.</p>
              <div class="b-delta-grid mt-4 grid grid-cols-3 gap-2" aria-label="Delta from selected baseline">
                <div class="delta-tile"><p class="label">Attempt</p><p class="delta-v" id="b-delta-attempt">No baseline</p></div>
                <div class="delta-tile"><p class="label">Solved</p><p class="delta-v" id="b-delta-solved">No baseline</p></div>
                <div class="delta-tile"><p class="label">Monthly</p><p class="delta-v" id="b-delta-month">No baseline</p></div>
              </div>
              <p class="small mt-3" id="b-baseline-label">Save a version to establish a baseline.</p>
              <p class="small mt-2" id="b-workspace-message" aria-live="polite"></p>
            </div>
            <div>
              <h3 class="label">Versions saved in this tab</h3>
              <div class="mt-3 grid gap-2" id="b-snapshots"><p class="small">No versions yet.</p></div>
            </div>
          </div>

          {ACCOUNT_PLANS_ENABLED && (
            <section class="account-workspace border-t border-[var(--color-rule)] pt-6" aria-labelledby="account-workspace-title">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div class="max-w-3xl">
                  <p class="label">Account storage · preview</p>
                  <h3 class="h-card mt-2" id="account-workspace-title">Account plans</h3>
                  <p class="small mt-2">Account plans are free during this preview so you can reopen named versions later. Preview safety limits are {ACCOUNT_PLAN_PREVIEW_MAX_PLANS} account plans and {ACCOUNT_PLAN_PREVIEW_MAX_VERSIONS} immutable versions per plan. These are storage safeguards, not final Free/Pro entitlements; billing is not active. Higher limits are planned for Pro, but upgrades are not available yet. Nothing from the editor is uploaded until you choose an account save action.</p>
                  <a class="link inline-block mt-2" href="#packaging">See planned Pro limits ↓</a>
                </div>
                <span class="pill pill-ink" id="b-account-state" role="status" aria-live="polite" aria-atomic="true">Checking account…</span>
              </div>

              <div class="operation-summary mt-4" id="b-account-recovered" hidden>
                <p class="text-sm font-semibold text-[var(--color-ink)]">A valid draft was recovered after sign-in.</p>
                <p class="small mt-1">It has not replaced the editor and has not been uploaded.</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button type="button" class="btn" id="b-account-restore-recovered">Restore recovered draft</button>
                  <button type="button" class="btn btn-quiet" id="b-account-discard-recovered">Discard recovered draft</button>
                </div>
              </div>

              <div class="mt-4" id="b-account-auth-actions" hidden>
                <p class="small" id="b-account-auth-copy">Sign in or create a free account to save plans and reopen them later. Your current quote and tab-only versions still work.</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <button type="button" class="btn" id="b-account-signin" disabled>Sign in to save</button>
                  <button type="button" class="btn btn-accent" id="b-account-signup" disabled>Create free account</button>
                </div>
              </div>

              <div class="mt-5 grid gap-5 lg:grid-cols-[.85fr_1.15fr]" id="b-account-signed-in" hidden>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <h4 class="label">Plans in your account</h4>
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="small" id="b-account-capacity">0 of {ACCOUNT_PLAN_PREVIEW_MAX_PLANS} plans</span>
                      <button type="button" class="btn btn-quiet" id="b-account-refresh">Refresh</button>
                    </div>
                  </div>
                  <div class="mt-3 grid gap-2" id="b-account-plans" aria-busy="false"><p class="small">Loading account plans…</p></div>
                  <button type="button" class="btn btn-quiet mt-3" id="b-account-more" hidden>Load more plans</button>
                </div>
                <div class="min-w-0">
                  <h4 class="label break-words" id="b-account-selection-title">Current editor</h4>
                  <p class="small mt-2" id="b-account-selection-copy">Save the current valid editor as a new account plan. This does not change versions in this tab.</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    <button type="button" class="btn" id="b-account-save" aria-describedby="b-account-selection-copy">Save current plan to account</button>
                    <button type="button" class="btn btn-quiet" id="b-account-save-new" aria-describedby="b-account-selection-copy" hidden>Save as new account plan</button>
                    <button type="button" class="btn btn-quiet" id="b-account-delete" hidden>Delete account plan</button>
                  </div>
                  <h5 class="label mt-5">Selected plan versions</h5>
                  <div class="mt-3 grid gap-2" id="b-account-versions"><p class="small">Choose a plan to view its versions. The editor will not change.</p></div>
                </div>
              </div>
              <p class="small mt-3" id="b-account-status" role="status" aria-live="polite" aria-atomic="true"></p>
              <p class="small mt-2 text-[var(--color-worse)]" id="b-account-error" role="alert" aria-atomic="true"></p>
            </section>
          )}
        </div>
      </section>

      <section class="card overflow-hidden" aria-labelledby="sensitivity-title">
        <div class="card-head">
          <div><p class="label">Step 5 · preview</p><h2 class="h-card mt-1" id="sensitivity-title">Sensitivity and break-even</h2></div>
          <span class="pill pill-ink">Hypothetical</span>
        </div>
        <div class="card-pad grid gap-8">
          <div>
            <div class="flex flex-wrap items-end justify-between gap-4">
              <div class="max-w-2xl">
                <h3 class="h-card">Move one assumption</h3>
                <p class="small mt-2">Low and high scenarios change only the selected input family across every model role. They are user-controlled hypotheticals, not measured forecasts.</p>
              </div>
              <div class="sens-controls grid grid-cols-[minmax(0,1fr)_8rem] gap-3 w-full sm:w-auto sm:min-w-[28rem]">
                <label class="block"><span class="label">Input family</span><select class="ctl ctl-row mt-2 w-full" id="b-sens-axis">
                  <option value="role_calls">Role calls per build</option>
                  <option value="tokens_per_call">Tokens per call</option>
                  <option value="model_rates">Model token rates</option>
                  <option value="system_success">Whole-system success</option>
                </select></label>
                <label class="block"><span class="label">Range</span><span class="percent-input mt-2"><input class="ctl ctl-row w-full" id="b-sens-range" type="number" min="5" max="90" step="5" value="25" /><span>%</span></span></label>
              </div>
            </div>
            <div class="mt-4 grid gap-3 md:grid-cols-3" aria-label="Low, current and high sensitivity quotes">
              <article class="analysis-card"><p class="label" id="b-sens-low-label">Low · −25%</p><dl class="analysis-metrics"><div><dt>Per attempt</dt><dd id="b-sens-low-attempt">—</dd></div><div><dt>Per completed</dt><dd id="b-sens-low-solved">—</dd></div><div><dt>Monthly</dt><dd id="b-sens-low-month">—</dd></div></dl></article>
              <article class="analysis-card analysis-current"><p class="label">Current plan</p><dl class="analysis-metrics"><div><dt>Per attempt</dt><dd id="b-sens-base-attempt">—</dd></div><div><dt>Per completed</dt><dd id="b-sens-base-solved">—</dd></div><div><dt>Monthly</dt><dd id="b-sens-base-month">—</dd></div></dl></article>
              <article class="analysis-card"><p class="label" id="b-sens-high-label">High · +25%</p><dl class="analysis-metrics"><div><dt>Per attempt</dt><dd id="b-sens-high-attempt">—</dd></div><div><dt>Per completed</dt><dd id="b-sens-high-solved">—</dd></div><div><dt>Monthly</dt><dd id="b-sens-high-month">—</dd></div></dl></article>
            </div>
            <p class="small mt-3" id="b-sens-status">Hypothetical one-variable sensitivity; all other plan inputs are held constant.</p>
            <p class="sr-only" id="b-sens-announcement" aria-live="polite" aria-atomic="true"></p>
          </div>

          <div class="border-t border-[var(--color-rule)] pt-6 grid gap-5 lg:grid-cols-[1fr_auto] lg:items-center">
            <div aria-live="polite" aria-atomic="true">
              <p class="label">Against selected baseline</p>
              <h3 class="h-card mt-2" id="b-break-even">Save a version to calculate break-even.</h3>
              <p class="small mt-2 max-w-3xl" id="b-break-even-detail">Break-even uses a common attempted-build volume: per-attempt role and harness cost × volume, plus each plan's fixed monthly cost. It does not infer success.</p>
            </div>
            <dl class="break-even-inputs" aria-label="Break-even inputs">
              <div><dt>Current / attempt</dt><dd id="b-be-current-attempt">—</dd></div>
              <div><dt>Baseline / attempt</dt><dd id="b-be-baseline-attempt">—</dd></div>
              <div><dt>Current fixed / mo</dt><dd id="b-be-current-fixed">—</dd></div>
              <div><dt>Baseline fixed / mo</dt><dd id="b-be-baseline-fixed">—</dd></div>
            </dl>
          </div>
        </div>
      </section>

      <section class="card overflow-hidden" id="build-operations" aria-labelledby="operations-title">
        <div class="card-head">
          <div><p class="label">Step 6 · preview</p><h2 class="h-card mt-1" id="operations-title">Export, share and monitor</h2></div>
          <span class="pill pill-ink">{ACCOUNT_PLANS_ENABLED ? 'Exports local · account operations preview' : 'Exports local · share and alerts preview'}</span>
        </div>
        <div class="card-pad">
          <p class="text-sm leading-relaxed text-[var(--color-body)] max-w-4xl">
            {ACCOUNT_PLANS_ENABLED
              ? 'Downloads are created in this browser. Account shares and inactive alert settings work only after you sign in and select a saved account plan. Sharing exposes the selected immutable account version; no alert is monitored and no email is sent.'
              : 'Downloads are created in this browser. These share and alert controls save drafts only in this tab; no link is created, no plan is uploaded by these controls and no email is sent.'}
          </p>
          {ACCOUNT_PLANS_ENABLED && <button type="button" class="btn btn-quiet mt-3" id="b-operations-refresh" disabled>Refresh selected plan operations</button>}

          <div class="operation-grid mt-5">
            <article class="operation-card" aria-labelledby="export-title">
              <p class="label">Export</p>
              <h3 class="h-card mt-2" id="export-title">Take the quote with you</h3>
              <p class="small mt-2">Generated locally from the current plan and quote. Missing completed-build cost stays Missing; it is never estimated.</p>
              <div class="mt-4 grid gap-2">
                <button type="button" class="btn" id="b-export-json">Download JSON</button>
                <button type="button" class="btn" id="b-export-csv">Download CSV</button>
                <button type="button" class="btn" id="b-export-png">Download PNG</button>
              </div>
              <p class="small mt-3" id="b-export-ready">Current quote ready to export.</p>
              <p class="small mt-2">Review files before sharing: they can include internal harness names, usage assumptions and custom or contract rates you entered.</p>
              <p class="small mt-2" id="b-export-status" role="status" aria-live="polite"></p>
              <p class="small mt-2 text-[var(--color-worse)]" id="b-export-error" role="alert" aria-atomic="true"></p>
            </article>

            <article class="operation-card" aria-labelledby="share-title">
              <p class="label">Unlisted link · preview</p>
              <h3 class="h-card mt-2" id="share-title">{ACCOUNT_PLANS_ENABLED ? 'Share an immutable account version' : 'Choose how a saved version would open'}</h3>
              <p class="small mt-2">{ACCOUNT_PLANS_ENABLED
                ? 'Anyone with the bearer link can view the saved plan name, internal or custom harness inputs, model choices, usage assumptions and custom or contract rates. Create it only when that disclosure is appropriate.'
                : 'Unlisted links need authenticated storage. Anyone with a future link could view it. Preview the settings now; Solvency will not create or copy a link.'}</p>
              <fieldset class="mt-4 grid gap-3">
                <legend class="sr-only">Unlisted share draft settings</legend>
                <label class="block"><span class="label">Version to share</span><select class="ctl ctl-row mt-2 w-full" id="b-share-version"><option value="">{ACCOUNT_PLANS_ENABLED ? 'Select an account plan first' : 'Save a version first'}</option></select></label>
                <div class="block"><span class="label">Access</span><p class="operation-fixed-value mt-2">Anyone with the unlisted link · view only</p></div>
                <label class="block"><span class="label">Expiry</span><select class="ctl ctl-row mt-2 w-full" id="b-share-expiry"><option value="7">7 days</option><option value="30">30 days</option><option value="none">No expiry</option></select></label>
                <label class="inline-flex items-center gap-2 min-h-11 text-sm text-[var(--color-ink)] cursor-pointer"><input type="checkbox" class="chk" id="b-share-export" checked /> Allow quote export</label>
              </fieldset>
              <div class="mt-3 flex flex-wrap gap-2">
                {ACCOUNT_PLANS_ENABLED
                  ? <button type="button" class="btn" id="b-share-save" disabled>Create unlisted link</button>
                  : <button type="button" class="btn" id="b-share-save" disabled>Save settings in this tab</button>}
                <button type="button" class="btn btn-quiet" id="b-share-remove" hidden>{ACCOUNT_PLANS_ENABLED ? 'Revoke link' : 'Remove draft'}</button>
              </div>
              {ACCOUNT_PLANS_ENABLED && (
                <div class="operation-summary mt-3" id="b-share-created" hidden>
                  <label class="label" for="b-share-url">New bearer URL · shown only after creation</label>
                  <input class="ctl ctl-row mt-2 w-full" id="b-share-url" type="url" readonly autocomplete="off" spellcheck="false" />
                  <div class="mt-2 flex flex-wrap gap-2">
                    <button type="button" class="btn" id="b-share-copy">Copy bearer URL</button>
                    <button type="button" class="btn btn-quiet" id="b-share-hide">Hide bearer URL</button>
                  </div>
                  <p class="small mt-2">Store it securely now. The account list never returns readable bearer tokens.</p>
                </div>
              )}
              <div class="operation-summary mt-3" id="b-share-summary"><p class="small">{ACCOUNT_PLANS_ENABLED ? 'Select a signed-in account plan to load its unlisted links.' : 'No share draft yet. Nothing has left this tab.'}</p></div>
              <p class="small mt-2" id="b-share-status" role="status" aria-live="polite" aria-atomic="true"></p>
              <p class="small mt-2 text-[var(--color-worse)]" id="b-share-error" role="alert" aria-atomic="true"></p>
            </article>

            <article class="operation-card" aria-labelledby="alerts-title">
              <p class="label">Alerts · preview</p>
              <h3 class="h-card mt-2" id="alerts-title">Define what should trigger a re-check</h3>
              <p class="small mt-2">{ACCOUNT_PLANS_ENABLED
                ? 'Save settings for an immutable account version. Every saved setting remains inactive: price monitoring, scheduled checks and email delivery are not running.'
                : 'Draft an alert for a saved version. Price monitoring and email delivery are not running yet.'}</p>
              <fieldset class="mt-4 grid gap-3">
                <legend class="sr-only">Alert draft settings</legend>
                <label class="block"><span class="label">Version to re-check</span><select class="ctl ctl-row mt-2 w-full" id="b-alert-version"><option value="">{ACCOUNT_PLANS_ENABLED ? 'Select an account plan first' : 'Save a version first'}</option></select></label>
                <label class="block"><span class="label">Trigger</span><select class="ctl ctl-row mt-2 w-full" id="b-alert-trigger">
                  <option value="model_price_change">A model price in this plan changes</option>
                  <option value="monthly_spend_above">Monthly spend exceeds</option>
                  <option value="monthly_spend_change_percent">Monthly spend changes by</option>
                  <option value="baseline_delta_percent">Selected version exceeds a baseline by</option>
                </select></label>
                <label class="block" id="b-alert-threshold-wrap" hidden><span class="label" id="b-alert-threshold-label">Threshold</span><span class="operation-threshold mt-2"><span id="b-alert-threshold-prefix"></span><input class="ctl ctl-row w-full" id="b-alert-threshold" type="number" min="0.01" step="0.1" aria-describedby="b-alert-error" /><span id="b-alert-threshold-suffix">%</span></span></label>
                <label class="block" id="b-alert-baseline-wrap" hidden><span class="label">Comparison baseline</span><select class="ctl ctl-row mt-2 w-full" id="b-alert-baseline"><option value="">Choose a saved baseline</option></select></label>
                <p class="small">{ACCOUNT_PLANS_ENABLED ? 'Status: inactive. No monitoring job or delivery channel is attached.' : 'Planned delivery: account email.'}</p>
              </fieldset>
              {ACCOUNT_PLANS_ENABLED
                ? <button type="button" class="btn mt-3" id="b-alert-save" disabled>Save inactive settings</button>
                : <button type="button" class="btn mt-3" id="b-alert-save" disabled>Save inactive draft in this tab</button>}
              <div class="mt-3 grid gap-2" id="b-alert-list"><p class="small">{ACCOUNT_PLANS_ENABLED ? 'Select a signed-in account plan to load inactive alert settings.' : 'No alert drafts. Solvency is not monitoring this plan.'}</p></div>
              <p class="small mt-2" id="b-alert-status" role="status" aria-live="polite" aria-atomic="true"></p>
              <p class="small mt-2 text-[var(--color-worse)]" id="b-alert-error" role="alert" aria-atomic="true"></p>
            </article>
          </div>
        </div>
      </section>
    </form>

    <Section id="packaging" eyebrow="Packaging" title="Preview access now; recurring budget operations later" class="mt-20"
      caption={`There is no upgrade or paid entitlement today. Preview access does not guarantee final tier placement. Safety caps still apply: ${BUILD_PLAN_LIMITS.maxRoles} roles, ${ACCOUNT_PLAN_PREVIEW_MAX_PLANS} account plans and ${ACCOUNT_PLAN_PREVIEW_MAX_VERSIONS} versions per plan.`}>
      <div class="grid gap-4 md:grid-cols-2">
        <div class="card card-pad"><p class="label">Available now · open preview</p><h3 class="h-card mt-2">Build and inspect the budget</h3><ul class="mt-3 text-sm leading-relaxed text-[var(--color-body)] list-disc pl-5"><li>Any harness name and mix of current catalog models</li><li>Editable usage, routing and custom-rate assumptions</li><li>Sensitivity, break-even, tab-only versions and local exports</li><li>Account plans only when the storage preview is enabled</li><li>Public research, methodology and verified catalog remain free</li></ul><p class="small mt-4">{ACCOUNT_PLANS_ENABLED ? 'The account preview can create and revoke unlisted links and persist inactive alert settings. No monitoring or email delivery is running.' : 'Unlisted-link delivery and monitoring are not available; their controls save settings only in this tab.'}</p></div>
        <div class="card card-pad"><p class="label">Pro · planned $19/month hypothesis</p><h3 class="h-card mt-2">Keep the budget current</h3><ul class="mt-3 text-sm leading-relaxed text-[var(--color-body)] list-disc pl-5"><li>Higher plan, version and model-role limits</li><li>Durable custom/contract pricing and observed-usage profiles</li><li>Named architecture history, expanded comparisons and review workflows</li><li>Controlled share links and operational export workflows</li><li>Model-price and budget monitoring for saved plans</li></ul><p class="small mt-4">The intended recurring value is re-planning, review and monitoring—not a paywall on public research.</p><div class="mt-5 border-t border-[var(--color-rule)] pt-4"><h4 class="text-sm font-semibold text-[var(--color-ink)]">Would that recurring workflow be worth $19/month?</h4><button type="button" class="btn mt-3" id="b-pro-interest" aria-describedby="b-pro-interest-help b-pro-interest-status" disabled>I’d consider Pro at $19</button><p class="small mt-2" id="b-pro-interest-help">Requires a free account so one person counts once. Research signal only—no upgrade, checkout, trial, subscription or charge.</p><p class="small mt-2" id="b-pro-interest-status" role="status" aria-live="polite" aria-atomic="true">{!PRODUCT_INTENTS_ENABLED ? 'Account-based research measurement is unavailable in this build. No interest can be submitted or charged.' : CLERK_ENABLED ? 'Free-account sign-up is loading.' : 'Free-account sign-up is unavailable in this build.'}</p></div></div>
      </div>
      <p class="small mt-3">The price is a validation hypothesis. Checkout will be added only after recurring-value evidence is reviewed and a server-authoritative entitlement boundary is ready.</p>
    </Section>
  </div>

  <template id="b-role-template">
    <article class="card role-editor" data-role>
      <div class="card-head">
        <div class="flex flex-wrap items-center gap-3 min-w-0">
          <span class="role-index label">Role</span>
          <input class="ctl ctl-row role-label" data-field="label" aria-label="Role label" maxlength={BUILD_PLAN_LIMITS.maxRoleLabelChars} value="Worker pool" />
        </div>
        <button type="button" class="btn btn-quiet role-remove" aria-label="Remove model role">Remove</button>
      </div>
      <div class="card-pad grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <label class="block"><span class="label">Role type</span><select class="ctl ctl-row mt-2 w-full" data-field="kind"><option value="orchestrator">Orchestrator</option><option value="worker">Worker / subagent</option><option value="other">Other / fallback</option></select></label>
        <label class="block sm:col-span-2"><span class="label">Model</span><select class="ctl ctl-row mt-2 w-full" data-field="model">{currentModels.map((model) => <option value={model.model_id} data-input={model.input_per_mtok} data-cache={model.cached_input_per_mtok ?? ''} data-output={model.output_per_mtok}>{model.display_name} · {model.provider}</option>)}</select></label>
        <label class="block"><span class="label">Expected calls / build</span><input class="ctl ctl-row mt-2 w-full" data-field="calls" type="number" min="0.01" max={BUILD_PLAN_LIMITS.maxExpectedInvocations} step="any" value="1" /></label>
        <label class="block"><span class="label">Usage basis</span><select class="ctl ctl-row mt-2 w-full" data-field="usage-basis"><option value="template_assumption">Template assumption</option><option value="user_supplied">User supplied</option><option value="measured">Measured · user asserted</option></select></label>
        <label class="block"><span class="label">Fresh input / call</span><input class="ctl ctl-row mt-2 w-full" data-field="fresh" type="number" min="0" max={BUILD_PLAN_LIMITS.maxTokensPerInvocation} step="any" value="20000" /></label>
        <label class="block"><span class="label">Cache read / call</span><input class="ctl ctl-row mt-2 w-full" data-field="cache" type="number" min="0" max={BUILD_PLAN_LIMITS.maxTokensPerInvocation} step="any" value="0" /></label>
        <label class="block"><span class="label">Output / call</span><input class="ctl ctl-row mt-2 w-full" data-field="output" type="number" min="0" max={BUILD_PLAN_LIMITS.maxTokensPerInvocation} step="any" value="2000" /></label>
        <label class="sm:col-span-2 lg:col-span-4 inline-flex items-center gap-2 min-h-11 text-sm text-[var(--color-ink)] cursor-pointer"><input type="checkbox" class="chk" data-field="custom-toggle" /> Use custom or contracted token prices for this role</label>
        <div class="custom-prices sm:col-span-2 lg:col-span-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" hidden>
          <label class="block"><span class="label">Custom rate basis</span><select class="ctl ctl-row mt-2 w-full" data-field="custom-basis"><option value="user_supplied">User supplied</option><option value="contract">Contract</option></select></label>
          <label class="block"><span class="label">Custom input / M</span><span class="money-input mt-2"><span>$</span><input class="ctl ctl-row w-full" data-field="custom-input" type="number" min="0" max={BUILD_PLAN_LIMITS.maxPricePerMtokUsd} step="any" /></span></label>
          <label class="block"><span class="label">Custom cache read / M</span><span class="money-input mt-2"><span>$</span><input class="ctl ctl-row w-full" data-field="custom-cache" type="number" min="0" max={BUILD_PLAN_LIMITS.maxPricePerMtokUsd} step="any" /></span></label>
          <label class="block"><span class="label">Custom output / M</span><span class="money-input mt-2"><span>$</span><input class="ctl ctl-row w-full" data-field="custom-output" type="number" min="0" max={BUILD_PLAN_LIMITS.maxPricePerMtokUsd} step="any" /></span></label>
        </div>
      </div>
    </article>
  </template>
</Base>

<script>
  import { models } from '../lib/data.ts';
  import { quoteBuildPlan, type BuildPlanV1, type BuildRoleV1 } from '../lib/build-cost.ts';
  import { validateUntrustedBuildPlanV1, type BuildPlanIssue } from '../lib/build-plan-schema.ts';
  import { compareBuildQuotes, createBuildSnapshot, duplicateBuildSnapshot, type BuildSnapshotV1 } from '../lib/build-workspace.ts';
  import { analyzeBuildSensitivity, breakEvenBuildPlans, type SensitivityAxis } from '../lib/build-sensitivity.ts';
  import {
    MAX_BUILD_EXPORT_ROLES, buildExportCsv, buildExportFilename, buildExportJson, buildExportSummary,
    type BuildExportFormat,
  } from '../lib/build-export.ts';
  import {
    alertSummary, createAlertDraft, createShareDraft,
    type BuildAlertDraftV1, type BuildAlertTrigger, type BuildShareDraftV1, type ShareExpiryDays,
  } from '../lib/build-operations.ts';
  import {
    StableAccountOperationKeys, accountShareUrl, copyAccountShareUrl,
    inactiveAccountAlertSummary, parseAccountAlertList, parseAccountShareList,
    parseCreatedAccountShare, parseDeletedAccountAlert, parseMutatedAccountAlert,
    parseRevokedAccountShare,
    type AccountBuildAlertTrigger, type AccountBuildPlanShare,
    type InactiveAccountBuildPlanAlert,
  } from '../lib/build-operations-client.ts';
  import {
    AuthenticatedJsonError, authenticatedJsonFetch, clearComposerDraftForAuth,
    consumeComposerDraftAfterAuth, observeClerkAuth, openSignIn, openSignUp,
    preserveComposerDraftForAuth, recordProductIntentSignal, signedIn, track, type ClerkAuthState,
  } from '../lib/clerk-client.ts';

  const form = document.getElementById('composer-form') as HTMLFormElement;
  const eligibleModels = models.filter((model) => model.status === 'current');
  const rolesEl = document.getElementById('b-roles')!;
  const template = document.getElementById('b-role-template') as HTMLTemplateElement;
  let lastPlan: BuildPlanV1;
  let lastQuote: ReturnType<typeof quoteBuildPlan>;
  let lastDraftValid = false;
  let currentPlanId = crypto.randomUUID();
  let baselineSnapshotId: string | null = null;
  const snapshots: BuildSnapshotV1[] = [];
  let shareDraft: BuildShareDraftV1 | null = null;
  const alertDrafts: BuildAlertDraftV1[] = [];
  let editingAlertId: string | null = null;
  let editedValidQuoteTracked = false;
  const accountPlansEnabled = form.dataset.accountPlansEnabled === 'true';
  const clerkEnabled = form.dataset.clerkEnabled === 'true';
  const accountPlanMaxPlans = 20;
  const accountPlanMaxVersions = 100;
  type AccountPlanSummary = { id: string; name: string; currentVersion: number; createdAt: string; updatedAt: string };
  type AccountVersionSummary = { id: string; version: number; name: string; engineVersion: string; quotedAt: string; createdAt: string };
  type AccountPlanResource = {
    plan: AccountPlanSummary;
    versions: AccountVersionSummary[];
    selectedVersion: AccountVersionSummary & { planId: string; plan: BuildPlanV1; quote: ReturnType<typeof quoteBuildPlan> };
  };
  let accountAuth: ClerkAuthState = accountPlansEnabled ? { status: 'checking' } : { status: 'disabled' };
  let accountAuthKey = '';
  let accountPlans: AccountPlanSummary[] = [];
  let accountNextCursor: string | null = null;
  let selectedAccountPlan: AccountPlanResource | null = null;
  let recoveredAccountDraft: BuildPlanV1 | null = null;
  let accountRequest: AbortController | null = null;
  let accountGeneration = 0;
  let accountBusy = false;
  let accountSessionExpired = false;
  let conflictedAccountPlanId: string | null = null;
  let pendingAccountWrite: { operation: string; planJson: string; key: string } | null = null;
  let editorAnchorJson: string | null = null;
  let accountShares: AccountBuildPlanShare[] = [];
  let accountAlerts: InactiveAccountBuildPlanAlert[] = [];
  let revealedAccountShare: { shareId: string; url: string } | null = null;
  let revealedAccountShareTimer: ReturnType<typeof setTimeout> | null = null;
  let editingAccountAlertId: string | null = null;
  let operationListRequest: AbortController | null = null;
  let operationMutationRequest: AbortController | null = null;
  let operationGeneration = 0;
  let activeOperationsPlanId: string | null = null;
  let operationBusy: 'loading' | 'share-create' | 'share-revoke' | 'alert-save' | 'alert-delete' | null = null;
  const operationKeys = new StableAccountOperationKeys();
  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const setText = (id: string, next: string) => { const target = byId(id); if (target.textContent !== next) target.textContent = next; };
  const proInterestButton = byId<HTMLButtonElement>('b-pro-interest');
  const proInterestStatus = byId('b-pro-interest-status');
  const proInterestMeasurementEnabled = document.documentElement.dataset.productIntentsEnabled === 'true';
  let latestProInterestAuth: ClerkAuthState = { status: 'checking' };
  function renderProInterestAuth(state: ClerkAuthState) {
    latestProInterestAuth = state;
    const authReady = state.status === 'signed-in' || state.status === 'signed-out';
    const ready = proInterestMeasurementEnabled && authReady;
    proInterestButton.disabled = !ready;
    proInterestButton.toggleAttribute('aria-busy', proInterestMeasurementEnabled && state.status === 'checking');
    if (!proInterestMeasurementEnabled) {
      proInterestStatus.textContent = 'Account-based research measurement is unavailable in this build. No interest can be submitted or charged.';
      return;
    }
    if (ready) {
      if (proInterestStatus.dataset.authReadiness === 'true') proInterestStatus.textContent = '';
      delete proInterestStatus.dataset.authReadiness;
      return;
    }
    proInterestStatus.dataset.authReadiness = 'true';
    proInterestStatus.textContent = state.status === 'checking'
      ? 'Free-account sign-up is loading.'
      : 'Free-account sign-up is unavailable in this build. No interest was submitted and nothing was charged.';
  }
  const value = (id: string) => (byId<HTMLInputElement>(id).value ?? '').normalize('NFC').trim();
  const numericInput = (input: HTMLInputElement) => input.value === '' ? Number.NaN : input.valueAsNumber;
  const number = (id: string) => numericInput(byId<HTMLInputElement>(id));
  const field = <T extends HTMLInputElement | HTMLSelectElement>(role: Element, name: string) => role.querySelector<T>(`[data-field="${name}"]`)!;
  const money = (n: number | null) => n === null ? 'Missing' : `$${n.toLocaleString(undefined, { minimumFractionDigits: n < 1 ? 3 : 2, maximumFractionDigits: n < 1 ? 4 : 2 })}`;

  const isRecord = (input: unknown): input is Record<string, unknown> => Boolean(input) && typeof input === 'object' && !Array.isArray(input);
  const isAccountPlanSummary = (input: unknown): input is AccountPlanSummary => isRecord(input)
    && typeof input.id === 'string' && typeof input.name === 'string'
    && Number.isSafeInteger(input.currentVersion) && Number(input.currentVersion) > 0
    && typeof input.createdAt === 'string' && typeof input.updatedAt === 'string';
  const isAccountVersionSummary = (input: unknown): input is AccountVersionSummary => isRecord(input)
    && typeof input.id === 'string' && Number.isSafeInteger(input.version) && Number(input.version) > 0
    && typeof input.name === 'string' && typeof input.engineVersion === 'string'
    && typeof input.quotedAt === 'string' && typeof input.createdAt === 'string';

  function parseAccountPlanList(payload: unknown): { plans: AccountPlanSummary[]; nextCursor: string | null } | null {
    if (!isRecord(payload) || !Array.isArray(payload.data) || !payload.data.every(isAccountPlanSummary)) return null;
    if (payload.nextCursor !== null && payload.nextCursor !== undefined && typeof payload.nextCursor !== 'string') return null;
    return { plans: payload.data, nextCursor: typeof payload.nextCursor === 'string' ? payload.nextCursor : null };
  }

  function parseAccountPlanResource(payload: unknown): AccountPlanResource | null {
    if (!isRecord(payload) || !isRecord(payload.data)) return null;
    const resource = payload.data;
    if (!isAccountPlanSummary(resource.plan) || !Array.isArray(resource.versions)
      || !resource.versions.every(isAccountVersionSummary) || !isRecord(resource.selectedVersion)) return null;
    const selected = resource.selectedVersion;
    if (!isAccountVersionSummary(selected) || typeof selected.planId !== 'string'
      || !isRecord(selected.plan) || !isRecord(selected.quote)) return null;
    return resource as AccountPlanResource;
  }

  const canonicalPlanJson = (plan: BuildPlanV1) => JSON.stringify(plan);
  const editorIsDirty = () => !lastDraftValid || editorAnchorJson === null || canonicalPlanJson(lastPlan) !== editorAnchorJson;
  const accountDate = (input: string) => {
    const date = new Date(input);
    return Number.isNaN(date.valueOf()) ? 'date unavailable' : date.toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
  };

  function clearRevealedAccountShare() {
    if (!accountPlansEnabled) return;
    if (revealedAccountShareTimer !== null) clearTimeout(revealedAccountShareTimer);
    revealedAccountShareTimer = null;
    revealedAccountShare = null;
    const input = byId<HTMLInputElement>('b-share-url'); input.value = '';
    byId('b-share-created').hidden = true;
  }

  function showRevealedAccountShare(shareId: string, url: string) {
    clearRevealedAccountShare();
    revealedAccountShare = { shareId, url };
    const input = byId<HTMLInputElement>('b-share-url'); input.value = url;
    byId('b-share-created').hidden = false;
    revealedAccountShareTimer = setTimeout(clearRevealedAccountShare, 60_000);
  }

  function resetAccountOperations(nextPlanId: string | null = null) {
    if (!accountPlansEnabled) return;
    operationGeneration += 1;
    operationListRequest?.abort(); operationListRequest = null;
    operationMutationRequest?.abort(); operationMutationRequest = null;
    operationBusy = null;
    activeOperationsPlanId = nextPlanId;
    accountShares = []; accountAlerts = [];
    editingAccountAlertId = null;
    operationKeys.clear();
    clearRevealedAccountShare();
    byId('build-operations').removeAttribute('aria-busy');
    byId('b-share-error').textContent = ''; byId('b-share-status').textContent = '';
    byId('b-alert-error').textContent = ''; byId('b-alert-status').textContent = '';
  }

  function accountOperationsReady(planId = activeOperationsPlanId): planId is string {
    return Boolean(accountPlansEnabled && planId && selectedAccountPlan?.plan.id === planId
      && accountAuth.status === 'signed-in' && !accountSessionExpired
      && conflictedAccountPlanId !== planId);
  }

  function syncSelectedAccountOperations(load = false) {
    if (!accountPlansEnabled) return;
    const planId = selectedAccountPlan?.plan.id ?? null;
    const changed = planId !== activeOperationsPlanId;
    if (changed) resetAccountOperations(planId);
    renderOperationVersions();
    if (load && accountOperationsReady(planId)) void loadAccountOperations(planId);
  }

  function setOperationBusy(next: typeof operationBusy) {
    operationBusy = next;
    if (!accountPlansEnabled) return;
    const section = byId('build-operations');
    if (next) section.setAttribute('aria-busy', 'true'); else section.removeAttribute('aria-busy');
    syncOperationControls();
  }

  function setOperationError(target: 'share' | 'alert' | 'both', cause: unknown, fallback: string) {
    if (!accountPlansEnabled) return;
    const message = cause instanceof AuthenticatedJsonError ? `${cause.message} ${fallback}` : fallback;
    if (target === 'share' || target === 'both') byId('b-share-error').textContent = message;
    if (target === 'alert' || target === 'both') byId('b-alert-error').textContent = message;
    if (cause instanceof AuthenticatedJsonError && cause.code === 'AUTH_REQUIRED') {
      accountSessionExpired = true;
      accountPlans = []; accountNextCursor = null; selectedAccountPlan = null;
      conflictedAccountPlanId = null; pendingAccountWrite = null;
      resetAccountOperations();
      renderAccountShell(); renderAccountPlans(); renderOperationVersions();
    }
  }

  function setAccountStatus(message = '') {
    if (!accountPlansEnabled) return;
    byId('b-account-status').textContent = message;
  }

  function setAccountError(cause: unknown, fallback: string) {
    if (!accountPlansEnabled) return;
    const error = byId('b-account-error');
    if (cause instanceof AuthenticatedJsonError) {
      error.textContent = `${cause.message} ${fallback}`;
      if (cause.code === 'AUTH_REQUIRED') {
        accountSessionExpired = true;
        accountPlans = []; accountNextCursor = null; selectedAccountPlan = null; conflictedAccountPlanId = null; pendingAccountWrite = null;
        resetAccountOperations();
      } else if (cause.code === 'VERSION_CONFLICT') {
        conflictedAccountPlanId = selectedAccountPlan?.plan.id ?? null;
        pendingAccountWrite = null;
      } else if (cause.code === 'IDEMPOTENCY_CONFLICT') {
        pendingAccountWrite = null;
      }
    } else error.textContent = fallback;
    renderAccountShell();
  }

  function clearAccountMessages() {
    if (!accountPlansEnabled) return;
    byId('b-account-error').textContent = '';
    byId('b-account-status').textContent = '';
  }

  function setAccountBusy(busy: boolean) {
    accountBusy = busy;
    if (!accountPlansEnabled) return;
    const panel = byId('b-account-signed-in');
    panel.setAttribute('aria-busy', busy ? 'true' : 'false');
    byId('b-account-plans').setAttribute('aria-busy', busy ? 'true' : 'false');
    for (const button of panel.querySelectorAll<HTMLButtonElement>('button')) {
      if (busy) button.setAttribute('aria-busy', 'true'); else button.removeAttribute('aria-busy');
    }
    syncAccountControls();
  }

  function renderRecoveredDraft() {
    if (!accountPlansEnabled) return;
    byId('b-account-recovered').hidden = !recoveredAccountDraft;
  }

  function renderAccountShell() {
    if (!accountPlansEnabled) return;
    const state = byId('b-account-state');
    const auth = byId('b-account-auth-actions');
    const signed = byId('b-account-signed-in');
    const signin = byId<HTMLButtonElement>('b-account-signin');
    const signup = byId<HTMLButtonElement>('b-account-signup');
    signin.hidden = false; signup.hidden = false;
    const authActionsReady = accountSessionExpired || accountAuth.status === 'signed-out';
    signin.disabled = !authActionsReady; signup.disabled = !authActionsReady;
    if (accountSessionExpired) {
      state.textContent = 'Session expired'; auth.hidden = false; signed.hidden = true;
      byId('b-account-auth-copy').textContent = 'Sign in again to use account plans. Your current draft and versions in this tab are unchanged.';
      renderRecoveredDraft(); return;
    }
    if (accountAuth.status === 'checking') {
      state.textContent = 'Checking account…'; auth.hidden = true; signed.hidden = true;
    } else if (accountAuth.status === 'disabled' || accountAuth.status === 'error') {
      state.textContent = 'Account storage unavailable'; auth.hidden = false; signed.hidden = true;
      signin.hidden = true; signup.hidden = true;
      byId('b-account-auth-copy').textContent = 'Account plan storage is unavailable in this build. The current editor, tab-only versions and local exports still work.';
    } else if (accountAuth.status === 'signed-out') {
      state.textContent = 'Signed out'; auth.hidden = false; signed.hidden = true;
      byId('b-account-auth-copy').textContent = 'Sign in or create a free account to save plans and reopen them later. Your current quote and tab-only versions still work.';
    } else {
      state.textContent = 'Account storage'; auth.hidden = true; signed.hidden = false;
    }
    renderRecoveredDraft();
    syncAccountControls();
  }

  function renderAccountPlans() {
    if (!accountPlansEnabled) return;
    const list = byId('b-account-plans'); list.replaceChildren();
    setText('b-account-capacity', `${Math.min(accountPlans.length, accountPlanMaxPlans)} of ${accountPlanMaxPlans} plans`);
    if (!accountPlans.length) {
      const empty = document.createElement('p'); empty.className = 'small';
      empty.textContent = accountBusy ? 'Loading account plans…' : 'No account plans yet. Save the current valid editor as your first account plan.';
      list.appendChild(empty);
    }
    for (const plan of accountPlans) {
      const row = document.createElement('article'); row.className = 'snapshot-row';
      const copy = document.createElement('div'); copy.className = 'min-w-0';
      const title = document.createElement('p'); title.className = 'text-sm font-semibold text-[var(--color-ink)] truncate'; title.textContent = plan.name;
      const meta = document.createElement('p'); meta.className = 'small mt-1'; meta.textContent = `Latest v${plan.currentVersion} · updated ${accountDate(plan.updatedAt)}`;
      copy.append(title, meta);
      const open = document.createElement('button'); open.type = 'button'; open.className = 'btn btn-quiet';
      const selected = selectedAccountPlan?.plan.id === plan.id;
      const needsReload = selected && conflictedAccountPlanId === plan.id;
      open.textContent = needsReload ? 'Reload versions' : selected ? 'Selected' : 'View versions';
      open.disabled = (selected && !needsReload) || accountBusy;
      open.setAttribute('aria-label', `${needsReload ? 'Reload versions for' : selected ? 'Selected' : 'View versions for'} ${plan.name}, latest version ${plan.currentVersion}`);
      open.addEventListener('click', () => void loadAccountPlan(plan.id));
      row.append(copy, open); list.appendChild(row);
    }
    const more = byId<HTMLButtonElement>('b-account-more');
    more.hidden = !accountNextCursor; more.disabled = accountBusy;
    renderAccountSelection();
  }

  function renderAccountSelection() {
    if (!accountPlansEnabled) return;
    const title = byId('b-account-selection-title');
    const copy = byId('b-account-selection-copy');
    const versions = byId('b-account-versions'); versions.replaceChildren();
    const save = byId<HTMLButtonElement>('b-account-save');
    const saveNew = byId<HTMLButtonElement>('b-account-save-new');
    const remove = byId<HTMLButtonElement>('b-account-delete');
    const atPlanLimit = accountPlans.length >= accountPlanMaxPlans;
    if (!selectedAccountPlan) {
      title.textContent = 'Current editor';
      copy.textContent = atPlanLimit
        ? `All ${accountPlanMaxPlans} preview plan slots are in use. Choose an account plan to append a version or delete it; the current editor and tab-only versions are unchanged.`
        : `Save the current valid editor as a new account plan. ${accountPlans.length} of ${accountPlanMaxPlans} preview plan slots are in use. This does not change versions in this tab.`;
      save.textContent = atPlanLimit ? 'Plan limit reached' : 'Save current plan to account'; saveNew.hidden = true; remove.hidden = true;
      const empty = document.createElement('p'); empty.className = 'small'; empty.textContent = 'Choose a plan to view its versions. The editor will not change.'; versions.appendChild(empty);
      syncAccountControls(); return;
    }
    const resource = selectedAccountPlan;
    const needsReload = conflictedAccountPlanId === resource.plan.id;
    const atVersionLimit = resource.plan.currentVersion >= accountPlanMaxVersions;
    title.textContent = resource.plan.name;
    copy.textContent = needsReload
      ? 'This account plan changed since it was loaded. Reload its versions before appending or deleting; the editor remains untouched. Saving as a new plan is still available when a plan slot is open.'
      : atVersionLimit
        ? `This plan is at the preview limit of v${accountPlanMaxVersions}. It cannot accept another version. Save the current editor as a new account plan if a plan slot is open, or keep it in this tab.`
        : `The selected account plan is at v${resource.plan.currentVersion} of ${accountPlanMaxVersions}. Saving next appends the current editor as v${resource.plan.currentVersion + 1}; it does not overwrite an earlier version.`;
    save.textContent = needsReload ? 'Reload before saving' : atVersionLimit ? 'Version limit reached' : 'Save next version to account';
    saveNew.hidden = false; remove.hidden = false;
    remove.setAttribute('aria-label', `Delete account plan ${resource.plan.name} and all ${resource.versions.length} versions`);
    for (const version of resource.versions) {
      const row = document.createElement('article'); row.className = 'snapshot-row';
      const versionCopy = document.createElement('div'); versionCopy.className = 'min-w-0';
      const versionTitle = document.createElement('p'); versionTitle.className = 'text-sm font-semibold text-[var(--color-ink)] truncate'; versionTitle.textContent = `${version.name} · v${version.version}`;
      const meta = document.createElement('p'); meta.className = 'small mt-1'; meta.textContent = `Account quote ${accountDate(version.quotedAt)} · ${version.engineVersion}`;
      versionCopy.append(versionTitle, meta);
      const actions = document.createElement('div'); actions.className = 'flex flex-wrap gap-2';
      const baseline = document.createElement('button'); baseline.type = 'button'; baseline.className = 'btn btn-quiet'; baseline.textContent = 'Use baseline'; baseline.disabled = accountBusy;
      baseline.setAttribute('aria-label', `Use account plan ${version.name} version ${version.version} as the tab baseline`);
      baseline.addEventListener('click', () => void loadAccountVersion(resource.plan.id, version.version, 'baseline'));
      const restore = document.createElement('button'); restore.type = 'button'; restore.className = 'btn btn-quiet'; restore.textContent = 'Restore'; restore.disabled = accountBusy;
      restore.setAttribute('aria-label', `Restore account plan ${version.name} version ${version.version} into the editor`);
      restore.addEventListener('click', () => void loadAccountVersion(resource.plan.id, version.version, 'restore'));
      actions.append(baseline, restore); row.append(versionCopy, actions); versions.appendChild(row);
    }
    syncAccountControls();
  }

  function syncAccountControls() {
    if (!accountPlansEnabled) return;
    const signedInToAccount = accountAuth.status === 'signed-in' && !accountSessionExpired;
    const valid = lastDraftValid && Boolean(lastQuote?.valid);
    const atPlanLimit = accountPlans.length >= accountPlanMaxPlans;
    const selectedNeedsReload = Boolean(selectedAccountPlan && conflictedAccountPlanId === selectedAccountPlan.plan.id);
    const selectedAtVersionLimit = Boolean(selectedAccountPlan && selectedAccountPlan.plan.currentVersion >= accountPlanMaxVersions);
    for (const id of ['b-account-save', 'b-account-save-new', 'b-account-delete', 'b-account-refresh', 'b-account-more']) {
      const button = byId<HTMLButtonElement>(id);
      button.disabled = accountBusy || !signedInToAccount || ((id === 'b-account-save' || id === 'b-account-save-new') && !valid)
        || (id === 'b-account-save' && (selectedNeedsReload || (selectedAccountPlan ? selectedAtVersionLimit : atPlanLimit)))
        || (id === 'b-account-save-new' && atPlanLimit)
        || (id === 'b-account-delete' && (!selectedAccountPlan || selectedNeedsReload))
        || (id === 'b-account-more' && !accountNextCursor);
    }
    byId<HTMLButtonElement>('b-account-save').title = !valid
      ? 'Resolve the current plan errors before saving to your account.'
      : selectedNeedsReload ? 'Reload this account plan before appending or deleting.'
        : selectedAtVersionLimit ? `This account plan already has ${accountPlanMaxVersions} versions.`
          : !selectedAccountPlan && atPlanLimit ? `This account already has ${accountPlanMaxPlans} plans.` : '';
    byId<HTMLButtonElement>('b-account-save-new').title = !valid
      ? 'Resolve the current plan errors before saving to your account.'
      : atPlanLimit ? `This account already has ${accountPlanMaxPlans} plans.` : '';
  }

  function startAccountRequest(): { controller: AbortController; generation: number } {
    accountRequest?.abort();
    const controller = new AbortController();
    accountRequest = controller;
    setAccountBusy(true);
    return { controller, generation: accountGeneration };
  }

  function finishAccountRequest(controller: AbortController) {
    if (accountRequest !== controller) return;
    accountRequest = null;
    setAccountBusy(false);
  }

  const accountRequestCurrent = (controller: AbortController, generation: number) => !controller.signal.aborted
    && generation === accountGeneration && accountAuth.status === 'signed-in';

  function upsertAccountPlan(summary: AccountPlanSummary) {
    accountPlans = [summary, ...accountPlans.filter((item) => item.id !== summary.id)]
      .sort((a, b) => b.updatedAt.localeCompare(a.updatedAt));
  }

  async function loadAccountPlans(reset = true) {
    if (!accountPlansEnabled || accountAuth.status !== 'signed-in') return;
    const cursor = reset ? null : accountNextCursor;
    if (!reset && !cursor) return;
    clearAccountMessages();
    const request = startAccountRequest();
    if (reset && !accountPlans.length) renderAccountPlans();
    setAccountStatus(reset ? 'Loading account plans…' : 'Loading more account plans…');
    try {
      const query = cursor ? `?cursor=${encodeURIComponent(cursor)}` : '';
      const payload = await authenticatedJsonFetch(`/api/build-plans${query}`, { signal: request.controller.signal });
      if (!accountRequestCurrent(request.controller, request.generation)) return;
      const parsed = parseAccountPlanList(payload);
      if (!parsed) throw new AuthenticatedJsonError('INVALID_RESPONSE');
      accountPlans = reset
        ? parsed.plans
        : [...accountPlans, ...parsed.plans.filter((plan) => !accountPlans.some((item) => item.id === plan.id))];
      accountNextCursor = parsed.nextCursor;
      if (selectedAccountPlan) {
        const refreshed = accountPlans.find((plan) => plan.id === selectedAccountPlan!.plan.id);
        if (!refreshed) {
          selectedAccountPlan = null;
          conflictedAccountPlanId = null;
          resetAccountOperations();
        } else if (refreshed.currentVersion !== selectedAccountPlan.plan.currentVersion) {
          conflictedAccountPlanId = selectedAccountPlan.plan.id;
          resetAccountOperations(selectedAccountPlan.plan.id);
        }
      }
      renderAccountPlans();
      syncSelectedAccountOperations(false);
      setAccountStatus(conflictedAccountPlanId
        ? 'Account plans refreshed. Reload the selected plan’s versions before appending or deleting; the editor is unchanged.'
        : accountPlans.length ? `Loaded ${accountPlans.length} account plan${accountPlans.length === 1 ? '' : 's'}. The editor is unchanged.` : 'No account plans yet. The editor is unchanged.');
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setAccountError(cause, 'Couldn’t load account plans. Versions in this tab are unchanged.');
    } finally { finishAccountRequest(request.controller); renderAccountPlans(); }
  }

  async function loadAccountPlan(planId: string) {
    if (accountAuth.status !== 'signed-in') return;
    clearAccountMessages();
    const request = startAccountRequest();
    setAccountStatus('Loading account plan versions…');
    try {
      const payload = await authenticatedJsonFetch(`/api/build-plans/${encodeURIComponent(planId)}`, { signal: request.controller.signal });
      if (!accountRequestCurrent(request.controller, request.generation)) return;
      const resource = parseAccountPlanResource(payload);
      if (!resource) throw new AuthenticatedJsonError('INVALID_RESPONSE');
      selectedAccountPlan = resource; conflictedAccountPlanId = null; upsertAccountPlan(resource.plan); renderAccountPlans();
      syncSelectedAccountOperations(true);
      setAccountStatus(`Loaded ${resource.plan.name} version history. The editor is unchanged.`);
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setAccountError(cause, 'Couldn’t load this account plan. The editor and tab-only versions are unchanged.');
    } finally { finishAccountRequest(request.controller); renderAccountPlans(); }
  }

  function validateLoadedAccountPlan(resource: AccountPlanResource): ReturnType<typeof validateUntrustedBuildPlanV1> | null {
    const validated = validateUntrustedBuildPlanV1(resource.selectedVersion.plan, eligibleModels);
    if (!validated.ok) {
      byId('b-account-error').textContent = 'This saved version uses data or a model that is no longer editable with the current catalog. It was not restored or used as a baseline.';
      return null;
    }
    return validated;
  }

  function applyLoadedAccountVersion(resource: AccountPlanResource, action: 'restore' | 'baseline') {
    const validated = validateLoadedAccountPlan(resource); if (!validated?.ok) return;
    const label = `${resource.selectedVersion.name} version ${resource.selectedVersion.version}`;
    if (action === 'restore') {
      if (editorIsDirty() && !confirm(`Restore ${label} from your account? Your unsaved current editor changes will be replaced. Save them in this tab first if you want to keep them.`)) {
        setAccountStatus('Restore cancelled. The current editor is unchanged.'); return;
      }
      currentPlanId = crypto.randomUUID();
      applyPlan(validated.value);
      editorAnchorJson = canonicalPlanJson(validated.value);
      syncAccountControls();
      setAccountStatus(`Restored ${label} from your account. It has not been resaved or uploaded again.`);
      byId('b-workspace-message').textContent = `Restored ${label} from your account.`;
      return;
    }
    const snapshotId = `account-${resource.selectedVersion.id}`;
    let snapshot = snapshots.find((item) => item.snapshotId === snapshotId);
    if (!snapshot) {
      snapshot = {
        schemaVersion: 1, snapshotId, planId: resource.plan.id,
        version: resource.selectedVersion.version, savedAt: resource.selectedVersion.createdAt,
        plan: structuredClone(validated.value), quote: structuredClone(validated.quote),
      };
      snapshots.push(snapshot);
    }
    baselineSnapshotId = snapshot.snapshotId;
    renderWorkspace();
    setAccountStatus(`Copied ${label} into this tab as the comparison baseline using the current verified catalog. No account data changed.`);
  }

  async function loadAccountVersion(planId: string, version: number, action: 'restore' | 'baseline') {
    if (accountAuth.status !== 'signed-in') return;
    clearAccountMessages();
    const request = startAccountRequest();
    setAccountStatus(`Loading account version ${version}…`);
    try {
      const payload = await authenticatedJsonFetch(`/api/build-plans/${encodeURIComponent(planId)}?version=${version}`, { signal: request.controller.signal });
      if (!accountRequestCurrent(request.controller, request.generation)) return;
      const resource = parseAccountPlanResource(payload);
      if (!resource) throw new AuthenticatedJsonError('INVALID_RESPONSE');
      selectedAccountPlan = resource; conflictedAccountPlanId = null; upsertAccountPlan(resource.plan); renderAccountPlans();
      syncSelectedAccountOperations(false);
      applyLoadedAccountVersion(resource, action);
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setAccountError(cause, 'Couldn’t load this account plan version. The editor and tab-only versions are unchanged.');
    } finally { finishAccountRequest(request.controller); renderAccountPlans(); }
  }

  function accountWriteKey(operation: string, planJson: string): string {
    if (pendingAccountWrite?.operation === operation && pendingAccountWrite.planJson === planJson) return pendingAccountWrite.key;
    const key = `composer:${crypto.randomUUID()}`;
    pendingAccountWrite = { operation, planJson, key };
    return key;
  }

  async function saveAccountPlan(asNew: boolean) {
    if (accountAuth.status !== 'signed-in' || !lastDraftValid || !lastQuote.valid) return;
    if (asNew || !selectedAccountPlan) {
      if (accountPlans.length >= accountPlanMaxPlans) {
        setAccountError(new AuthenticatedJsonError('PLAN_LIMIT'), 'Your current draft is still open and nothing was lost.');
        return;
      }
    } else if (conflictedAccountPlanId === selectedAccountPlan.plan.id) {
      setAccountError(new AuthenticatedJsonError('VERSION_CONFLICT'), 'Your current draft is still open and nothing was lost.');
      return;
    } else if (selectedAccountPlan.plan.currentVersion >= accountPlanMaxVersions) {
      setAccountError(new AuthenticatedJsonError('VERSION_LIMIT'), 'Your current draft is still open and nothing was lost.');
      return;
    }
    clearAccountMessages();
    const plan = structuredClone(lastPlan);
    const planJson = canonicalPlanJson(plan);
    const target = !asNew ? selectedAccountPlan : null;
    const operation = target ? `append:${target.plan.id}:${target.plan.currentVersion}` : 'create';
    const headers: Record<string, string> = { 'Idempotency-Key': accountWriteKey(operation, planJson) };
    if (target) headers['If-Match'] = `"${target.plan.currentVersion}"`;
    const endpoint = target ? `/api/build-plans/${encodeURIComponent(target.plan.id)}/versions` : '/api/build-plans';
    const request = startAccountRequest();
    setAccountStatus(target ? `Saving ${plan.name} as the next account version…` : `Saving ${plan.name} as a new account plan…`);
    try {
      const payload = await authenticatedJsonFetch(endpoint, { method: 'POST', headers, json: plan, signal: request.controller.signal });
      if (!accountRequestCurrent(request.controller, request.generation)) return;
      const resource = parseAccountPlanResource(payload);
      if (!resource) throw new AuthenticatedJsonError('INVALID_RESPONSE');
      pendingAccountWrite = null; selectedAccountPlan = resource; conflictedAccountPlanId = null; upsertAccountPlan(resource.plan);
      editorAnchorJson = planJson; renderAccountPlans(); syncSelectedAccountOperations(true);
      setAccountStatus(`Saved ${resource.selectedVersion.name} version ${resource.selectedVersion.version} to your account. Versions in this tab are unchanged.`);
      track('build_account_plan_save', { path: location.pathname, operation: target ? 'append_version' : 'create_plan' });
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setAccountError(cause, 'Couldn’t save to your account. Your current draft is still open and nothing was lost.');
    } finally { finishAccountRequest(request.controller); renderAccountPlans(); }
  }

  async function deleteAccountPlan() {
    const resource = selectedAccountPlan;
    if (!resource || accountAuth.status !== 'signed-in') return;
    if (conflictedAccountPlanId === resource.plan.id) {
      setAccountError(new AuthenticatedJsonError('VERSION_CONFLICT'), 'Reload its versions before deleting. Nothing was removed.');
      return;
    }
    const dirty = editorIsDirty()
      ? ' Your unsaved editor remains open in this tab and will not be deleted.'
      : ' The current editor remains open in this tab, but this durable account copy will be removed.';
    if (!confirm(`Delete “${resource.plan.name}” and all ${resource.versions.length} account version${resource.versions.length === 1 ? '' : 's'}?${dirty} This account deletion cannot be undone from Solvency.`)) {
      setAccountStatus('Delete cancelled. The account plan and current editor are unchanged.'); return;
    }
    clearAccountMessages();
    const request = startAccountRequest();
    setAccountStatus(`Deleting ${resource.plan.name} from your account…`);
    try {
      const payload = await authenticatedJsonFetch(`/api/build-plans/${encodeURIComponent(resource.plan.id)}`, {
        method: 'DELETE', headers: { 'If-Match': `"${resource.plan.currentVersion}"` }, json: {}, signal: request.controller.signal,
      });
      if (!accountRequestCurrent(request.controller, request.generation)) return;
      if (!isRecord(payload) || !isRecord(payload.data) || payload.data.deleted !== true || payload.data.planId !== resource.plan.id) {
        throw new AuthenticatedJsonError('INVALID_RESPONSE');
      }
      accountPlans = accountPlans.filter((plan) => plan.id !== resource.plan.id);
      selectedAccountPlan = null; conflictedAccountPlanId = null; pendingAccountWrite = null; resetAccountOperations(); renderAccountPlans(); renderOperationVersions();
      setAccountStatus(`Deleted ${resource.plan.name} and its account versions. The current editor and versions in this tab were not deleted.`);
      byId('b-account-status').setAttribute('tabindex', '-1'); byId('b-account-status').focus();
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setAccountError(cause, 'Couldn’t delete this account plan. Nothing was removed.');
    } finally { finishAccountRequest(request.controller); renderAccountPlans(); }
  }

  function preserveEditorBeforeAuth(): boolean {
    const validated = validateUntrustedBuildPlanV1(readPlan(), eligibleModels);
    if (!validated.ok) { clearComposerDraftForAuth(); render(); return false; }
    return preserveComposerDraftForAuth(validated.value);
  }

  function handleAccountAuth(state: ClerkAuthState) {
    const key = state.status === 'signed-in' ? `${state.status}:${state.userId}:${state.sessionId ?? ''}` : state.status;
    if (key === accountAuthKey) return;
    accountAuthKey = key; accountAuth = state; accountSessionExpired = false;
    accountGeneration += 1; accountRequest?.abort(); accountRequest = null; accountBusy = false;
    accountPlans = []; accountNextCursor = null; selectedAccountPlan = null; conflictedAccountPlanId = null; pendingAccountWrite = null;
    resetAccountOperations();
    byId('b-account-error').textContent = '';
    if (state.status === 'signed-in') {
      const draft = consumeComposerDraftAfterAuth<unknown>();
      if (draft) {
        const validated = validateUntrustedBuildPlanV1(draft, eligibleModels);
        if (validated.ok) {
          const alreadyOpen = lastDraftValid && canonicalPlanJson(lastPlan) === canonicalPlanJson(validated.value);
          recoveredAccountDraft = alreadyOpen ? null : validated.value;
          setAccountStatus(alreadyOpen
            ? 'Sign-in complete. The preserved draft is already open in the editor and was removed from temporary storage.'
            : 'A valid draft was recovered after sign-in. Choose whether to restore or discard it; the editor is unchanged.');
        } else {
          recoveredAccountDraft = null;
          setAccountStatus('A redirect draft could not be restored because it is no longer valid. The editor is unchanged.');
        }
      } else recoveredAccountDraft = null;
    } else {
      recoveredAccountDraft = null;
      if (state.status === 'signed-out' || state.status === 'disabled') clearComposerDraftForAuth();
    }
    renderAccountShell(); renderAccountPlans();
    if (state.status === 'signed-in') void loadAccountPlans();
  }

  type AccountOperationRequest = {
    controller: AbortController;
    accountGeneration: number;
    operationGeneration: number;
    planId: string;
  };

  const accountOperationRequestCurrent = (
    request: AccountOperationRequest,
    kind: 'list' | 'mutation',
  ) => !request.controller.signal.aborted
    && request.accountGeneration === accountGeneration
    && request.operationGeneration === operationGeneration
    && activeOperationsPlanId === request.planId
    && selectedAccountPlan?.plan.id === request.planId
    && accountAuth.status === 'signed-in'
    && (kind === 'list' ? operationListRequest : operationMutationRequest) === request.controller;

  function startOperationList(planId: string): AccountOperationRequest {
    operationListRequest?.abort();
    const controller = new AbortController(); operationListRequest = controller;
    clearRevealedAccountShare(); setOperationBusy('loading');
    return { controller, planId, accountGeneration, operationGeneration };
  }

  function startOperationMutation(
    planId: string,
    busy: Exclude<typeof operationBusy, null | 'loading'>,
  ): AccountOperationRequest | null {
    if (!accountOperationsReady(planId) || operationBusy) return null;
    operationListRequest?.abort(); operationListRequest = null;
    const controller = new AbortController(); operationMutationRequest = controller;
    setOperationBusy(busy);
    return { controller, planId, accountGeneration, operationGeneration };
  }

  function finishOperationList(request: AccountOperationRequest) {
    if (operationListRequest !== request.controller) return;
    operationListRequest = null; setOperationBusy(null);
  }

  function finishOperationMutation(request: AccountOperationRequest) {
    if (operationMutationRequest !== request.controller) return;
    operationMutationRequest = null; setOperationBusy(null);
  }

  function operationRecordsMatchSelectedPlan(
    planId: string,
    shares: AccountBuildPlanShare[],
    alerts: InactiveAccountBuildPlanAlert[],
  ): boolean {
    if (selectedAccountPlan?.plan.id !== planId) return false;
    const versions = new Set(selectedAccountPlan.versions.map((version) => version.version));
    return shares.every((share) => share.planId === planId && versions.has(share.version))
      && alerts.every((alert) => alert.planId === planId && versions.has(alert.version)
        && (alert.baselineVersion === null || versions.has(alert.baselineVersion)));
  }

  async function loadAccountOperations(planId = selectedAccountPlan?.plan.id ?? '') {
    if (!accountOperationsReady(planId) || (operationBusy && operationBusy !== 'loading')) return;
    byId('b-share-error').textContent = ''; byId('b-alert-error').textContent = '';
    byId('b-share-status').textContent = 'Loading token-free unlisted-link records…';
    byId('b-alert-status').textContent = 'Loading inactive alert settings…';
    const request = startOperationList(planId);
    try {
      const encodedPlanId = encodeURIComponent(planId);
      const [sharePayload, alertPayload] = await Promise.all([
        authenticatedJsonFetch(`/api/build-plans/${encodedPlanId}/shares`, { signal: request.controller.signal }),
        authenticatedJsonFetch(`/api/build-plans/${encodedPlanId}/alerts`, { signal: request.controller.signal }),
      ]);
      if (!accountOperationRequestCurrent(request, 'list')) return;
      const shares = parseAccountShareList(sharePayload);
      const alerts = parseAccountAlertList(alertPayload);
      if (!shares || !alerts || !operationRecordsMatchSelectedPlan(planId, shares, alerts)) {
        throw new AuthenticatedJsonError('INVALID_RESPONSE');
      }
      accountShares = shares; accountAlerts = alerts; operationKeys.clear();
      renderShareDraft(); renderAlerts();
      byId('b-share-status').textContent = shares.length
        ? `Loaded ${shares.length} unlisted-link record${shares.length === 1 ? '' : 's'}. Existing bearer URLs are not returned.`
        : 'No unlisted links exist for this account plan.';
      byId('b-alert-status').textContent = alerts.length
        ? `Loaded ${alerts.length} inactive alert setting${alerts.length === 1 ? '' : 's'}. No monitoring job or email delivery is active.`
        : 'No alert settings exist for this account plan. Solvency is not monitoring it.';
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setOperationError('both', cause, 'Couldn’t load these saved settings. Nothing was changed.');
    } finally {
      finishOperationList(request); renderShareDraft(); renderAlerts(); syncOperationControls();
    }
  }

  async function createAccountShare() {
    const resource = selectedAccountPlan; if (!resource) return;
    const version = Number(byId<HTMLSelectElement>('b-share-version').value);
    const rawExpiry = byId<HTMLSelectElement>('b-share-expiry').value;
    const expiresInDays = rawExpiry === 'none' ? null : Number(rawExpiry);
    const allowQuoteExport = byId<HTMLInputElement>('b-share-export').checked;
    const versionExists = resource.versions.some((item) => item.version === version);
    if (!versionExists || (expiresInDays !== null && expiresInDays !== 7 && expiresInDays !== 30)) {
      byId('b-share-error').textContent = 'Choose a valid saved account version and expiry.'; return;
    }
    if (accountShares.some((share) => share.version === version && share.status === 'active')) {
      byId('b-share-error').textContent = 'That account version already has an active unlisted link. Revoke it before creating another.'; return;
    }
    const body = { version, expiresInDays: expiresInDays as 7 | 30 | null, allowQuoteExport };
    const fingerprint = JSON.stringify(body);
    const operation = `share:create:${resource.plan.id}`;
    const request = startOperationMutation(resource.plan.id, 'share-create'); if (!request) return;
    clearRevealedAccountShare(); byId('b-share-error').textContent = ''; byId('b-share-status').textContent = 'Creating an unlisted bearer link…';
    try {
      const payload = await authenticatedJsonFetch(`/api/build-plans/${encodeURIComponent(resource.plan.id)}/shares`, {
        method: 'POST', headers: { 'Idempotency-Key': operationKeys.key(operation, fingerprint) },
        json: body, signal: request.controller.signal,
      });
      if (!accountOperationRequestCurrent(request, 'mutation')) return;
      const created = parseCreatedAccountShare(payload);
      const url = created ? accountShareUrl(created.path, location.origin) : null;
      if (!created || !url || created.planId !== resource.plan.id || created.version !== version
        || !operationRecordsMatchSelectedPlan(resource.plan.id, [created], [])) {
        throw new AuthenticatedJsonError('INVALID_RESPONSE');
      }
      operationKeys.complete(operation, fingerprint);
      const metadata: AccountBuildPlanShare = {
        id: created.id, planId: created.planId, version: created.version,
        allowQuoteExport: created.allowQuoteExport, expiresAt: created.expiresAt,
        status: created.status, createdAt: created.createdAt,
      };
      accountShares = [metadata, ...accountShares.filter((share) => share.id !== metadata.id)];
      renderShareDraft(); showRevealedAccountShare(metadata.id, url);
      byId('b-share-status').textContent = 'Unlisted link created. Its bearer URL is shown above for 60 seconds; copy or hide it now.';
      track('build_account_share_create', { path: location.pathname, expiry: rawExpiry, allow_export: String(allowQuoteExport) });
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setOperationError('share', cause, 'The link was not confirmed. Retry with the same settings or refresh the token-free list.');
    } finally { finishOperationMutation(request); renderShareDraft(); syncOperationControls(); }
  }

  async function revokeAccountShare(share: AccountBuildPlanShare) {
    const resource = selectedAccountPlan;
    if (!resource || share.planId !== resource.plan.id) return;
    if (!confirm(`Revoke the unlisted link for account version ${share.version}? Anyone using that bearer URL will lose access. This does not delete the saved plan version.`)) {
      byId('b-share-status').textContent = 'Revoke cancelled. The unlisted link is unchanged.'; return;
    }
    const fingerprint = '{}'; const operation = `share:revoke:${resource.plan.id}:${share.id}`;
    const request = startOperationMutation(resource.plan.id, 'share-revoke'); if (!request) return;
    byId('b-share-error').textContent = ''; byId('b-share-status').textContent = 'Revoking the unlisted link…';
    try {
      const payload = await authenticatedJsonFetch(`/api/build-plans/${encodeURIComponent(resource.plan.id)}/shares/${encodeURIComponent(share.id)}`, {
        method: 'DELETE', headers: { 'Idempotency-Key': operationKeys.key(operation, fingerprint) },
        json: {}, signal: request.controller.signal,
      });
      if (!accountOperationRequestCurrent(request, 'mutation')) return;
      if (!parseRevokedAccountShare(payload, share.id)) throw new AuthenticatedJsonError('INVALID_RESPONSE');
      operationKeys.complete(operation, fingerprint);
      accountShares = accountShares.filter((item) => item.id !== share.id);
      if (revealedAccountShare?.shareId === share.id) clearRevealedAccountShare();
      renderShareDraft(); byId('b-share-status').textContent = 'Unlisted link revoked. The saved account version remains available.';
      track('build_account_share_revoke', { path: location.pathname });
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setOperationError('share', cause, 'The revoke was not confirmed. Retry or refresh the token-free list.');
    } finally { finishOperationMutation(request); renderShareDraft(); syncOperationControls(); }
  }

  function readAccountAlertBody(): {
    version: number;
    trigger: AccountBuildAlertTrigger;
    threshold: number | null;
    baselineVersion: number | null;
  } {
    const resource = selectedAccountPlan;
    const version = Number(byId<HTMLSelectElement>('b-alert-version').value);
    const trigger = byId<HTMLSelectElement>('b-alert-trigger').value as AccountBuildAlertTrigger;
    const allowedTriggers: AccountBuildAlertTrigger[] = [
      'model_price_change', 'monthly_spend_above', 'monthly_spend_change_percent', 'baseline_delta_percent',
    ];
    if (!resource?.versions.some((item) => item.version === version) || !allowedTriggers.includes(trigger)) {
      throw new Error('Choose a valid saved account version and trigger.');
    }
    const thresholdInput = byId<HTMLInputElement>('b-alert-threshold');
    const threshold = trigger === 'model_price_change' ? null : numericInput(thresholdInput);
    if (threshold !== null && (!Number.isFinite(threshold) || Object.is(threshold, -0) || threshold <= 0 || threshold > 1_000_000_000)) {
      throw new Error('Enter a threshold greater than zero.');
    }
    const baselineVersion = trigger === 'baseline_delta_percent'
      ? Number(byId<HTMLSelectElement>('b-alert-baseline').value) : null;
    if (trigger === 'baseline_delta_percent'
      && (!resource.versions.some((item) => item.version === baselineVersion) || baselineVersion === version)) {
      throw new Error('Choose a different saved account version as the baseline.');
    }
    return { version, trigger, threshold, baselineVersion };
  }

  async function saveAccountAlert() {
    const resource = selectedAccountPlan; if (!resource) return;
    const error = byId('b-alert-error'); const threshold = byId<HTMLInputElement>('b-alert-threshold');
    error.textContent = ''; threshold.removeAttribute('aria-invalid');
    let body: ReturnType<typeof readAccountAlertBody>;
    try { body = readAccountAlertBody(); }
    catch (cause) {
      error.textContent = cause instanceof Error ? cause.message : 'The inactive alert settings are invalid.';
      if (/threshold/i.test(error.textContent)) { threshold.setAttribute('aria-invalid', 'true'); threshold.focus(); }
      return;
    }
    const alertId = editingAccountAlertId;
    const fingerprint = JSON.stringify(body);
    const operation = alertId ? `alert:update:${resource.plan.id}:${alertId}` : `alert:create:${resource.plan.id}`;
    const endpoint = alertId
      ? `/api/build-plans/${encodeURIComponent(resource.plan.id)}/alerts/${encodeURIComponent(alertId)}`
      : `/api/build-plans/${encodeURIComponent(resource.plan.id)}/alerts`;
    const request = startOperationMutation(resource.plan.id, 'alert-save'); if (!request) return;
    byId('b-alert-status').textContent = alertId ? 'Updating inactive alert settings…' : 'Saving inactive alert settings…';
    try {
      const payload = await authenticatedJsonFetch(endpoint, {
        method: 'POST', headers: { 'Idempotency-Key': operationKeys.key(operation, fingerprint) },
        json: body, signal: request.controller.signal,
      });
      if (!accountOperationRequestCurrent(request, 'mutation')) return;
      const saved = parseMutatedAccountAlert(payload);
      if (!saved || saved.planId !== resource.plan.id || saved.status !== 'inactive'
        || (alertId !== null && saved.id !== alertId)
        || !operationRecordsMatchSelectedPlan(resource.plan.id, [], [saved])) {
        throw new AuthenticatedJsonError('INVALID_RESPONSE');
      }
      operationKeys.complete(operation, fingerprint);
      accountAlerts = [saved, ...accountAlerts.filter((item) => item.id !== saved.id)];
      resetAlertEditor(); renderAlerts();
      byId('b-alert-status').textContent = 'Inactive alert settings saved. No monitoring job or email delivery was created.';
      track('build_account_alert_save', { path: location.pathname, operation: alertId ? 'update' : 'create', trigger: body.trigger });
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setOperationError('alert', cause, 'The settings were not confirmed. Retry unchanged settings or refresh.');
    } finally { finishOperationMutation(request); renderAlerts(); syncOperationControls(); }
  }

  async function deleteAccountAlert(alert: InactiveAccountBuildPlanAlert) {
    const resource = selectedAccountPlan;
    if (!resource || alert.planId !== resource.plan.id) return;
    if (!confirm(`Delete the inactive alert settings for account version ${alert.version}? No monitoring or email is running.`)) {
      byId('b-alert-status').textContent = 'Delete cancelled. The inactive settings are unchanged.'; return;
    }
    const fingerprint = '{}'; const operation = `alert:delete:${resource.plan.id}:${alert.id}`;
    const request = startOperationMutation(resource.plan.id, 'alert-delete'); if (!request) return;
    byId('b-alert-error').textContent = ''; byId('b-alert-status').textContent = 'Deleting inactive alert settings…';
    try {
      const payload = await authenticatedJsonFetch(`/api/build-plans/${encodeURIComponent(resource.plan.id)}/alerts/${encodeURIComponent(alert.id)}`, {
        method: 'DELETE', headers: { 'Idempotency-Key': operationKeys.key(operation, fingerprint) },
        json: {}, signal: request.controller.signal,
      });
      if (!accountOperationRequestCurrent(request, 'mutation')) return;
      if (!parseDeletedAccountAlert(payload, alert.id)) throw new AuthenticatedJsonError('INVALID_RESPONSE');
      operationKeys.complete(operation, fingerprint);
      accountAlerts = accountAlerts.filter((item) => item.id !== alert.id);
      if (editingAccountAlertId === alert.id) resetAlertEditor();
      renderAlerts(); byId('b-alert-status').textContent = 'Inactive alert settings deleted. No monitoring was active.';
      track('build_account_alert_delete', { path: location.pathname });
    } catch (cause) {
      if (request.controller.signal.aborted) return;
      setOperationError('alert', cause, 'The deletion was not confirmed. Retry or refresh.');
    } finally { finishOperationMutation(request); renderAlerts(); syncOperationControls(); }
  }

  function renumber() {
    [...rolesEl.querySelectorAll<HTMLElement>('[data-role]')].forEach((role, index) => {
      role.querySelector('.role-index')!.textContent = `Role ${index + 1}`;
      const remove = role.querySelector('.role-remove') as HTMLButtonElement;
      remove.disabled = rolesEl.children.length <= 1;
      remove.setAttribute('aria-label', `Remove role ${index + 1}: ${field<HTMLInputElement>(role, 'label').value || 'unnamed role'}`);
    });
    const add = byId<HTMLButtonElement>('b-add-role');
    add.disabled = rolesEl.children.length >= MAX_BUILD_EXPORT_ROLES;
    add.title = add.disabled ? `Preview safety limit: ${MAX_BUILD_EXPORT_ROLES} roles.` : '';
  }

  function seedCustomPrices(role: Element) {
    const selected = field<HTMLSelectElement>(role, 'model').selectedOptions[0];
    const mapping = [['custom-input', 'input'], ['custom-cache', 'cache'], ['custom-output', 'output']] as const;
    for (const [target, source] of mapping) {
      const input = field<HTMLInputElement>(role, target);
      if (!input.value) input.value = selected.dataset[source] ?? '';
    }
  }

  function addRole(seed: Partial<BuildRoleV1> = {}) {
    if (rolesEl.children.length >= MAX_BUILD_EXPORT_ROLES) return;
    const fragment = template.content.cloneNode(true) as DocumentFragment;
    const role = fragment.querySelector<HTMLElement>('[data-role]')!;
    role.dataset.roleId = seed.roleId ?? `role-${crypto.randomUUID()}`;
    field<HTMLInputElement>(role, 'label').value = seed.label ?? 'Worker pool';
    field<HTMLSelectElement>(role, 'kind').value = seed.kind ?? 'worker';
    field<HTMLSelectElement>(role, 'model').value = seed.modelId ?? 'gpt-5.6-luna';
    field<HTMLInputElement>(role, 'calls').value = String(seed.expectedInvocationsPerBuildAttempt ?? 1);
    if (seed.usagePerInvocation) {
      field<HTMLSelectElement>(role, 'usage-basis').value = seed.usagePerInvocation.basis;
      field<HTMLInputElement>(role, 'fresh').value = String(seed.usagePerInvocation.uncachedInputTokens);
      field<HTMLInputElement>(role, 'cache').value = String(seed.usagePerInvocation.cacheReadTokens);
      field<HTMLInputElement>(role, 'output').value = String(seed.usagePerInvocation.outputTokens);
    }
    if (seed.priceOverride) {
      field<HTMLInputElement>(role, 'custom-toggle').checked = true;
      (role.querySelector('.custom-prices') as HTMLElement).hidden = false;
      field<HTMLSelectElement>(role, 'custom-basis').value = seed.priceOverride.basis;
      field<HTMLInputElement>(role, 'custom-input').value = String(seed.priceOverride.inputPerMtok);
      field<HTMLInputElement>(role, 'custom-cache').value = seed.priceOverride.cacheReadPerMtok === undefined ? '' : String(seed.priceOverride.cacheReadPerMtok);
      field<HTMLInputElement>(role, 'custom-output').value = String(seed.priceOverride.outputPerMtok);
    }
    role.querySelector('.role-remove')!.addEventListener('click', () => { role.remove(); renumber(); render(); });
    rolesEl.appendChild(fragment);
    renumber();
    render();
  }

  function readRole(role: HTMLElement): BuildRoleV1 {
    const custom = field<HTMLInputElement>(role, 'custom-toggle').checked;
    const customCache = field<HTMLInputElement>(role, 'custom-cache').value;
    const usageBasis = field<HTMLSelectElement>(role, 'usage-basis').value as BuildRoleV1['usagePerInvocation']['basis'];
    return {
      roleId: role.dataset.roleId!,
      kind: field<HTMLSelectElement>(role, 'kind').value as BuildRoleV1['kind'],
      label: field<HTMLInputElement>(role, 'label').value.normalize('NFC').trim(),
      modelId: field<HTMLSelectElement>(role, 'model').value,
      expectedInvocationsPerBuildAttempt: numericInput(field<HTMLInputElement>(role, 'calls')),
      usagePerInvocation: {
        uncachedInputTokens: numericInput(field<HTMLInputElement>(role, 'fresh')),
        cacheReadTokens: numericInput(field<HTMLInputElement>(role, 'cache')),
        cacheWriteTokens: 0,
        outputTokens: numericInput(field<HTMLInputElement>(role, 'output')),
        basis: usageBasis,
        assertionOrigin: 'user_asserted',
      },
      ...(custom ? { priceOverride: {
        inputPerMtok: numericInput(field<HTMLInputElement>(role, 'custom-input')),
        ...(customCache === '' ? {} : { cacheReadPerMtok: numericInput(field<HTMLInputElement>(role, 'custom-cache')) }),
        outputPerMtok: numericInput(field<HTMLInputElement>(role, 'custom-output')),
        basis: field<HTMLSelectElement>(role, 'custom-basis').value as NonNullable<BuildRoleV1['priceOverride']>['basis'],
        assertionOrigin: 'user_asserted',
      } } : {}),
    };
  }

  function readPlan(): BuildPlanV1 {
    const successText = value('b-success');
    const harnessBasis = value('b-harness-basis') as BuildPlanV1['harness']['configBasis'];
    const endToEndSuccess = successText ? {
      rate: Number(successText) / 100,
      basis: value('b-success-basis') as NonNullable<BuildPlanV1['endToEndSuccess']>['basis'],
      assertionOrigin: 'user_asserted' as const,
    } : undefined;
    return {
      schemaVersion: 1,
      name: value('b-name'),
      workload: { buildsPerMonth: number('b-volume'), volumeBasis: value('b-volume-basis') as BuildPlanV1['workload']['volumeBasis'] },
      harness: {
        name: value('b-harness'), version: value('b-version') || null,
        configBasis: harnessBasis,
        assertionOrigin: 'user_asserted',
        fixedCostPerBuildAttemptUsd: number('b-overhead'), fixedMonthlyCostUsd: number('b-fixed'),
      },
      roles: [...rolesEl.querySelectorAll<HTMLElement>('[data-role]')].map(readRole),
      ...(endToEndSuccess ? { endToEndSuccess } : {}),
    };
  }

  function issueControl(path: string): HTMLInputElement | HTMLSelectElement | HTMLButtonElement | null {
    const direct: Record<string, string> = {
      '$.name': 'b-name', '$.workload.buildsPerMonth': 'b-volume', '$.workload.volumeBasis': 'b-volume-basis',
      '$.harness.name': 'b-harness', '$.harness.version': 'b-version', '$.harness.configBasis': 'b-harness-basis',
      '$.harness.fixedCostPerBuildAttemptUsd': 'b-overhead', '$.harness.fixedMonthlyCostUsd': 'b-fixed',
      '$.endToEndSuccess.rate': 'b-success', '$.endToEndSuccess.basis': 'b-success-basis', '$.roles': 'b-add-role',
    };
    if (direct[path]) return byId(direct[path]) as HTMLInputElement | HTMLSelectElement | HTMLButtonElement;
    const match = /^\$\.roles\[(\d+)\]\.(.+)$/.exec(path);
    if (!match) return null;
    const role = rolesEl.querySelectorAll<HTMLElement>('[data-role]')[Number(match[1])];
    if (!role) return null;
    const roleFields: Record<string, string> = {
      kind: 'kind', label: 'label', modelId: 'model', expectedInvocationsPerBuildAttempt: 'calls',
      'usagePerInvocation.uncachedInputTokens': 'fresh', 'usagePerInvocation.cacheReadTokens': 'cache',
      'usagePerInvocation.outputTokens': 'output', 'usagePerInvocation.basis': 'usage-basis',
      'priceOverride.inputPerMtok': 'custom-input', 'priceOverride.cacheReadPerMtok': 'custom-cache',
      'priceOverride.outputPerMtok': 'custom-output', 'priceOverride.basis': 'custom-basis',
    };
    const fieldName = roleFields[match[2]];
    return fieldName ? field<HTMLInputElement | HTMLSelectElement>(role, fieldName) : null;
  }

  function clearPlanIssueControls() {
    for (const control of form.querySelectorAll<HTMLElement>('[data-plan-invalid="true"]')) {
      const errorId = control.dataset.planErrorId;
      control.removeAttribute('aria-invalid');
      control.removeAttribute('aria-errormessage');
      control.removeAttribute('data-plan-invalid');
      delete control.dataset.planErrorId;
      const descriptions = (control.getAttribute('aria-describedby') ?? '').split(/\s+/).filter((id) => id && id !== errorId);
      if (descriptions.length) control.setAttribute('aria-describedby', descriptions.join(' '));
      else control.removeAttribute('aria-describedby');
    }
    for (const message of form.querySelectorAll('[data-plan-error="true"]')) message.remove();
  }

  function markPlanIssues(issues: BuildPlanIssue[]) {
    clearPlanIssueControls();
    const grouped = new Map<HTMLElement, BuildPlanIssue[]>();
    for (const issue of issues) {
      const control = issueControl(issue.path);
      if (!control) continue;
      const groupedIssues = grouped.get(control) ?? [];
      groupedIssues.push(issue);
      grouped.set(control, groupedIssues);
    }
    let errorIndex = 0;
    for (const [control, controlIssues] of grouped) {
      errorIndex += 1;
      const errorId = `b-plan-error-${errorIndex}`;
      const message = document.createElement('span');
      message.id = errorId;
      message.dataset.planError = 'true';
      message.className = 'plan-field-error small';
      message.textContent = controlIssues.map(issueMessage).join(' ');
      (control.closest('label') ?? control.parentElement)?.appendChild(message);
      control.setAttribute('aria-invalid', 'true');
      control.setAttribute('aria-errormessage', errorId);
      control.setAttribute('data-plan-invalid', 'true');
      control.dataset.planErrorId = errorId;
      const descriptions = new Set((control.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean));
      descriptions.add(errorId);
      control.setAttribute('aria-describedby', [...descriptions].join(' '));
    }
  }

  function issueMessage(issue: BuildPlanIssue): string {
    const control = issueControl(issue.path);
    const roleMatch = /^\$\.roles\[(\d+)\]/.exec(issue.path);
    const rolePrefix = roleMatch ? `Role ${Number(roleMatch[1]) + 1} — ` : '';
    const label = control?.getAttribute('aria-label')
      ?? control?.closest('label')?.querySelector('.label')?.textContent?.trim()
      ?? 'Build plan';
    const message = control instanceof HTMLInputElement && control.type === 'number'
      && control.value === '' && issue.code === 'TYPE'
      ? 'Value is required.'
      : issue.message;
    return `${rolePrefix}${label}: ${message}`;
  }

  const cell = (text: string, right = false) => { const td = document.createElement('td'); td.textContent = text; if (right) td.className = 'r'; return td; };
  const signedMoney = (value: number | null) => {
    if (value === null) return 'Missing';
    if (Math.abs(value) < 1e-12) return '$0 · same';
    return `${value < 0 ? '−' : '+'}${money(Math.abs(value))}`;
  };

  const factorLabel = (factor: number) => {
    const percent = (factor - 1) * 100;
    if (Math.abs(percent) < 0.05) return 'same';
    return `${percent < 0 ? '−' : '+'}${Math.abs(percent).toLocaleString(undefined, { maximumFractionDigits: 1 })}%`;
  };

  function renderAnalysis(baseline: BuildSnapshotV1 | undefined) {
    const axis = value('b-sens-axis') as SensitivityAxis;
    const requestedPercent = number('b-sens-range');
    const metricIds = [
      ['b-sens-low-attempt', 'b-sens-low-solved', 'b-sens-low-month'],
      ['b-sens-base-attempt', 'b-sens-base-solved', 'b-sens-base-month'],
      ['b-sens-high-attempt', 'b-sens-high-solved', 'b-sens-high-month'],
    ];
    if (!lastDraftValid) {
      for (const ids of metricIds) for (const id of ids) byId(id).textContent = 'Missing';
      byId('b-sens-low-label').textContent = 'Low · —';
      byId('b-sens-high-label').textContent = 'High · —';
      const status = 'Fix the current plan inputs before running sensitivity or break-even analysis.';
      byId('b-sens-status').textContent = status;
      byId('b-sens-announcement').textContent = status;
      byId('b-be-current-attempt').textContent = 'Missing';
      byId('b-be-current-fixed').textContent = 'Missing';
      byId('b-be-baseline-attempt').textContent = baseline ? money(baseline.quote.buildAttemptCostUsd) : '—';
      byId('b-be-baseline-fixed').textContent = baseline ? money(baseline.plan.harness.fixedMonthlyCostUsd) : '—';
      setText('b-break-even', 'Break-even is unavailable while the current plan is invalid.');
      setText('b-break-even-detail', 'Resolve the current plan errors to compare this plan with a saved baseline.');
      return;
    }
    try {
      if (!Number.isFinite(requestedPercent) || requestedPercent < 5 || requestedPercent > 90) {
        throw new RangeError('Sensitivity range must be between 5% and 90%.');
      }
      const requestedDelta = requestedPercent / 100;
      const sensitivity = analyzeBuildSensitivity(lastPlan, eligibleModels, axis, requestedDelta);
      byId('b-sens-low-label').textContent = `Low · ${factorLabel(sensitivity.lowFactor)}`;
      byId('b-sens-high-label').textContent = `High · ${factorLabel(sensitivity.highFactor)}`;
      const quotes = [sensitivity.low, sensitivity.base, sensitivity.high];
      quotes.forEach((quote, index) => {
        const values = quote
          ? [quote.buildAttemptCostUsd, quote.variableCostPerSuccessfulBuildUsd, quote.monthlyCostUsd]
          : [null, null, null];
        values.forEach((amount, metricIndex) => { byId(metricIds[index][metricIndex]).textContent = money(amount); });
      });
      const scopeNote = axis === 'system_success'
        ? (lastPlan.workload.volumeBasis === 'attempted_builds'
            ? ' With attempted-build volume, success changes completed-build cost but not monthly spend.'
            : ' With completed-build volume, success also changes required attempts and monthly spend.')
        : ' The selected family is perturbed across every model role.';
      const status = sensitivity.available
        ? `${sensitivity.assumption}${scopeNote}${axis === 'model_rates' ? ' Perturbed rates are intentionally unverified.' : ''}`
        : sensitivity.missingReason ?? 'Sensitivity is unavailable for this plan.';
      byId('b-sens-status').textContent = status;
      byId('b-sens-announcement').textContent = sensitivity.available
        ? `Sensitivity updated. Low: ${money(sensitivity.low!.buildAttemptCostUsd)} per attempt, ${money(sensitivity.low!.variableCostPerSuccessfulBuildUsd)} per completed build, ${money(sensitivity.low!.monthlyCostUsd)} monthly. Current: ${money(sensitivity.base.buildAttemptCostUsd)} per attempt, ${money(sensitivity.base.variableCostPerSuccessfulBuildUsd)} per completed build, ${money(sensitivity.base.monthlyCostUsd)} monthly. High: ${money(sensitivity.high!.buildAttemptCostUsd)} per attempt, ${money(sensitivity.high!.variableCostPerSuccessfulBuildUsd)} per completed build, ${money(sensitivity.high!.monthlyCostUsd)} monthly.`
        : status;
    } catch (error) {
      for (const ids of metricIds) for (const id of ids) byId(id).textContent = 'Missing';
      byId('b-sens-low-label').textContent = 'Low · —';
      byId('b-sens-high-label').textContent = 'High · —';
      const status = error instanceof Error ? error.message : 'Sensitivity inputs are invalid.';
      byId('b-sens-status').textContent = status;
      byId('b-sens-announcement').textContent = status;
    }

    const currentAttempt = lastQuote.buildAttemptCostUsd;
    byId('b-be-current-attempt').textContent = money(currentAttempt);
    byId('b-be-current-fixed').textContent = money(Number.isFinite(lastPlan.harness.fixedMonthlyCostUsd) ? lastPlan.harness.fixedMonthlyCostUsd : null);
    if (!baseline) {
      setText('b-break-even', 'Save a version to calculate break-even.');
      byId('b-be-baseline-attempt').textContent = '—';
      byId('b-be-baseline-fixed').textContent = '—';
      return;
    }
    byId('b-be-baseline-attempt').textContent = money(baseline.quote.buildAttemptCostUsd);
    byId('b-be-baseline-fixed').textContent = money(baseline.plan.harness.fixedMonthlyCostUsd);
    const result = breakEvenBuildPlans(lastPlan, baseline.plan, eligibleModels);
    const currentName = 'Current edit';
    const baselineName = `${baseline.plan.name} v${baseline.version}`;
    if (result.kind === 'crosses') {
      const volume = result.attemptedBuildsPerMonth!.toLocaleString(undefined, { maximumFractionDigits: 1 });
      const below = result.lowerBelow === 'current' ? currentName : baselineName;
      const above = result.lowerAbove === 'current' ? currentName : baselineName;
      setText('b-break-even', `Monthly costs match at ${volume} attempted builds.`);
      setText('b-break-even-detail', `Below that volume, ${below} costs less; above it, ${above} costs less. This compares per-attempt cost × a common attempted-build volume + fixed monthly cost.`);
    } else if (result.kind === 'current_always_lower') {
      setText('b-break-even', `${currentName} costs less at every positive attempted-build volume.`);
      setText('b-break-even-detail', `No positive crossing exists against ${baselineName}. This comparison does not infer or use a success rate.`);
    } else if (result.kind === 'baseline_always_lower') {
      setText('b-break-even', `${baselineName} costs less at every positive attempted-build volume.`);
      setText('b-break-even-detail', 'No positive crossing exists. This comparison does not infer or use a success rate.');
    } else if (result.kind === 'equal_all_volumes') {
      setText('b-break-even', 'Both plans have the same attempted-build cost curve.');
      setText('b-break-even-detail', 'Their per-attempt and fixed monthly costs are equal, so every attempted-build volume ties.');
    } else {
      setText('b-break-even', 'Break-even is unavailable.');
      setText('b-break-even-detail', result.reason ?? 'Both plans need valid per-attempt quotes.');
    }
