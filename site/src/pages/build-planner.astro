  function syncOperationControls() {
    const shareVersion = byId<HTMLSelectElement>('b-share-version');
    const alertVersion = byId<HTMLSelectElement>('b-alert-version');
    const baseline = byId<HTMLSelectElement>('b-alert-baseline');
    const shareSave = byId<HTMLButtonElement>('b-share-save');
    const alertSave = byId<HTMLButtonElement>('b-alert-save');
    const trigger = byId<HTMLSelectElement>('b-alert-trigger').value as BuildAlertTrigger;

    for (const option of baseline.options) option.disabled = Boolean(option.value) && option.value === alertVersion.value;
    if (baseline.value && baseline.value === alertVersion.value) baseline.value = '';

    if (accountPlansEnabled) {
      const ready = accountOperationsReady() && operationBusy === null;
      const shareVersionNumber = Number(shareVersion.value);
      const selectedShareExists = accountShares.some((share) => share.version === shareVersionNumber && share.status === 'active');
      const invalidBaseline = trigger === 'baseline_delta_percent'
        && (!baseline.value || baseline.value === alertVersion.value);
      for (const id of [
        'b-share-version', 'b-share-expiry', 'b-share-export',
        'b-alert-version', 'b-alert-trigger', 'b-alert-threshold', 'b-alert-baseline',
      ]) byId<HTMLInputElement | HTMLSelectElement>(id).disabled = !ready;
      shareSave.disabled = !ready || !shareVersion.value || selectedShareExists;
      shareSave.title = !selectedAccountPlan
        ? 'Sign in and select a saved account plan first.'
        : conflictedAccountPlanId === selectedAccountPlan.plan.id
          ? 'Reload the selected account plan before changing saved settings.'
          : selectedShareExists ? 'This version already has an active unlisted link.'
            : operationBusy ? 'Wait for the current account operation to finish.' : '';
      alertSave.disabled = !ready || !alertVersion.value || invalidBaseline;
      alertSave.title = !selectedAccountPlan
        ? 'Sign in and select a saved account plan first.'
        : invalidBaseline ? 'Choose a different saved account version as the baseline.'
          : operationBusy ? 'Wait for the current account operation to finish.' : '';
      byId<HTMLButtonElement>('b-operations-refresh').disabled = !ready;
      for (const button of byId('build-operations').querySelectorAll<HTMLButtonElement>('[data-account-operation-action]')) {
        button.disabled = !ready;
