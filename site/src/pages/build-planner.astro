      const meta = document.createElement('p'); meta.className = 'small mt-1'; meta.textContent = snapshotLabel(snapshot);
      const pill = document.createElement('span'); pill.className = 'pill pill-ink mt-2'; pill.textContent = 'Draft · off'; copy.append(title, meta, pill);
      const actions = document.createElement('div'); actions.className = 'flex flex-wrap gap-1';
      const edit = document.createElement('button'); edit.type = 'button'; edit.className = 'btn btn-quiet'; edit.textContent = 'Edit'; edit.setAttribute('aria-label', `Edit alert draft for ${snapshot.plan.name} version ${snapshot.version}`);
      edit.addEventListener('click', () => {
        editingAlertId = draft.alertId; byId<HTMLSelectElement>('b-alert-version').value = draft.snapshotId;
        byId<HTMLSelectElement>('b-alert-trigger').value = draft.trigger; byId<HTMLInputElement>('b-alert-threshold').value = draft.threshold === null ? '' : String(draft.threshold);
        byId<HTMLSelectElement>('b-alert-baseline').value = draft.baselineSnapshotId ?? ''; byId<HTMLButtonElement>('b-alert-save').textContent = 'Update alert draft';
        byId('b-alert-error').textContent = ''; byId('b-alert-status').textContent = 'Editing an inactive draft. Save changes to apply.';
        renderAlertThreshold(); byId<HTMLButtonElement>('b-alert-save').focus();
      });
      const remove = document.createElement('button'); remove.type = 'button'; remove.className = 'btn btn-quiet'; remove.textContent = 'Remove'; remove.setAttribute('aria-label', `Remove alert draft for ${snapshot.plan.name} version ${snapshot.version}`);
      remove.addEventListener('click', () => {
        alertDrafts.splice(alertDrafts.findIndex((item) => item.alertId === draft.alertId), 1);
        if (editingAlertId === draft.alertId) resetAlertEditor();
        renderAlerts(); byId('b-alert-status').textContent = 'Alert draft removed. No monitoring was active.'; byId<HTMLButtonElement>('b-alert-save').focus();
      });
      actions.append(edit, remove); row.append(copy, actions); list.appendChild(row);
    }
