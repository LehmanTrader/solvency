---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found · Solvency" description="That Solvency page does not exist.">
  <div class="wrap pt-12 md:pt-20">
    <p class="eyebrow">404</p>
    <h1 class="h-display mt-3">Page not found.</h1>
    <p class="lede mt-4 max-w-xl">That address does not match a model, comparison, research note, or site page.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-accent" href="/">Open the calculator</a>
      <a class="btn" href="/models">Browse models</a>
      <a class="btn" href="/compare">Compare two models</a>
    </div>
  </div>
</Base>
