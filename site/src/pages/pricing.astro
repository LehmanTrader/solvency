---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import StripeSandbox from '../components/StripeSandbox.astro';
import ProCheckout from '../components/ProCheckout.astro';
import { CLERK_ENABLED, CLERK_PUBLISHABLE_KEY } from '../lib/clerk.ts';
const PRODUCT_INTENTS_ENABLED = import.meta.env.PUBLIC_PRODUCT_INTENTS_ENABLED === 'true';
const STRIPE_SANDBOX_UI_ENABLED = import.meta.env.PUBLIC_DEPLOYMENT_ENV === 'preview'
  && import.meta.env.PUBLIC_STRIPE_SANDBOX_UI_ENABLED === 'true'
  && CLERK_PUBLISHABLE_KEY.startsWith('pk_test_');
// Production checkout surface. Dark (false) until the paid-launch checklist
// in docs/handoff-harness-and-paid-tier.md is approved; deploy.yml pins this
// to 'false', deploy-preview.yml wires it from the resolve-rollout checkout
// output. See ProCheckout.astro for the gated rendering it controls.
const CHECKOUT_UI_ENABLED = import.meta.env.PUBLIC_STRIPE_CHECKOUT_ENABLED === 'true';

// Approved launch packaging. Free/Pro cells below describe the packaging
// decision, not a change to Build Composer's own enforcement: build-planner
// is out of scope for this change and today remains an open preview at the
// 24-role safety cap for everyone, in both flag states — see the footnote
// under the table. Rows whose truth depends on whether Pro can actually be
// bought are conditioned on CHECKOUT_UI_ENABLED, the same flag the status
// and interest blocks above condition on.
const proPlanned = (activeCopy: string, plannedCopy: string) => CHECKOUT_UI_ENABLED ? activeCopy : plannedCopy;

const comparison = [
  {
    feature: 'Research notes, leaderboard, model pages, methodology and compare',
    free: 'Included',
    pro: 'Included, public evidence stays free',
  },
  {
    feature: 'Single-model calculator and copy-link',
    free: 'Included',
    pro: 'Included',
  },
  {
    feature: 'Build Composer',
    free: 'Demo: 2 roles, verified catalog list prices only, with the live quote',
    pro: proPlanned('Full Composer: up to 24 roles, with custom or contract rates', 'Planned: full Composer, up to 24 roles, with custom or contract rates'),
  },
  {
    feature: 'Sensitivity, break-even and scenario deltas',
    free: 'Not in the demo',
    pro: proPlanned('Included', 'Planned'),
  },
  {
    feature: 'Saved plans and versioned account history',
    free: 'Not in the demo, nothing is saved',
    pro: proPlanned('Versioned account saves: 20 plans, 100 versions per plan', 'Planned: versioned account saves, 20 plans and 100 versions per plan'),
  },
  {
    feature: 'Unlisted share links and local exports (JSON, CSV, PNG)',
    free: 'Not in the demo',
    pro: proPlanned('Included', 'Planned'),
  },
  {
    feature: 'Founding rate lock',
    free: '—',
    pro: proPlanned('Your rate never increases while subscribed', 'Planned: your rate would never increase while subscribed'),
  },
  {
    feature: 'Model-price and budget monitoring (alerts)',
    free: 'Not sold until it exists',
    pro: 'Not sold until it exists',
  },
  {
    feature: 'Local-hardware vs cloud TCO comparison',
    free: 'Reference rigs at their defaults',
    pro: proPlanned('Included, compare your own rig cost per solved task against your Composer plan, with a break-even volume', 'Planned: compare your own rig cost per solved task against your Composer plan'),
  },
  {
    feature: 'Re-priced digest email, rate profiles, usage import, API',
    free: 'Not included',
    pro: 'Roadmap: planned, never sold as an active feature',
  },
];

const launchDecisions = [
  {
    title: 'Trial',
    copy: 'Decided. There is no trial. Your card is charged when you subscribe.',
  },
  {
    title: 'Cancellation',
    copy: 'Decided. Cancel any time from the billing portal. Cancelling stops future renewals; Pro access continues through the end of the period you already paid for.',
  },
  {
    title: 'Refunds',
    copy: 'Decided. All sales are final. Solvency does not offer refunds, except where required by law.',
  },
  {
    title: 'Tax',
    copy: 'Decided. Prices exclude tax. Solvency does not collect tax at checkout; you are responsible for any tax your jurisdiction imposes.',
  },
];
---
<Base title={CHECKOUT_UI_ENABLED
        ? 'Pricing · Solvency Pro, $19/month · Solvency'
        : 'Pricing, Free now, Pro planned, Solvency'}
      description={CHECKOUT_UI_ENABLED
        ? 'Solvency public research and calculators stay free. Pro, $19/month or $190/year, unlocks the full Build Composer and funds independent benchmark runs.'
        : 'Solvency public research and calculators stay free. Compare the open Build Composer preview with a planned Pro workspace; billing is not live.'}>
  <div class="wrap pt-8 md:pt-12">
    <p class="eyebrow">Pricing</p>
    <h1 class="h-display mt-3 max-w-3xl">Public evidence stays free.</h1>
    <p class="lede mt-4 max-w-3xl">Research, methodology, verified model prices and the calculator are free to read and use. {CHECKOUT_UI_ENABLED
      ? 'Pro is for teams that repeatedly re-plan, review and monitor a multi-model build budget.'
      : 'Pro is being designed for teams that repeatedly re-plan, review and monitor a multi-model build budget.'}</p>
    <p class="lede mt-2 max-w-3xl">Solvency prices everything, the calculator, the frontier chart and Build Composer, the same way: cost per completed task, verified against a source. Pro is that same math applied to the plans you save.</p>
    <p class="lede mt-2 max-w-3xl">Solvency takes no money from model vendors; the paid tier is what funds its independent benchmark runs.</p>

    {!CHECKOUT_UI_ENABLED && (
      <section class="card card-pad mt-8 grid gap-5 sm:grid-cols-[1fr_auto] sm:items-start" aria-labelledby="pricing-status-title">
        <div class="max-w-3xl">
          <p class="label">Launch status</p>
          <h2 class="h-card mt-2" id="pricing-status-title">{STRIPE_SANDBOX_UI_ENABLED ? 'Operator-only Stripe sandbox.' : 'There is nothing to buy today.'}</h2>
          <p class="mt-2 text-sm leading-relaxed">{STRIPE_SANDBOX_UI_ENABLED
            ? 'This Access-protected Preview may create Stripe test Customers, test Subscriptions and Preview entitlement records. It cannot accept a real payment or create a live subscription. Public and Production billing remain off.'
            : 'Billing is not live. There is no active checkout, trial, subscription, upgrade or paid entitlement. The Build Composer is an open product preview, and its current access and safety limits do not establish the final Free or Pro tiers.'}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            <a class="btn" href="/build-planner">Use the open Build Composer</a>
            <a class="btn btn-quiet" href="#launch-decisions">Review launch decisions ↓</a>
          </div>
        </div>
        <span class="pill pill-ink self-start justify-self-start">{STRIPE_SANDBOX_UI_ENABLED ? 'Test mode' : 'Billing off'}</span>
      </section>
    )}

    {STRIPE_SANDBOX_UI_ENABLED && <StripeSandbox />}

    <Section id="plans" eyebrow="Packaging" title={CHECKOUT_UI_ENABLED ? 'Free and Pro' : 'Free now; Pro is a validation hypothesis'} class="mt-20"
      caption={CHECKOUT_UI_ENABLED
        ? 'Public evidence stays free. Pro unlocks the full Build Composer and funds independent benchmark runs.'
        : 'The proposed price and feature boundary may change after recurring-value evidence is reviewed.'}>
      <div class="grid gap-4 md:grid-cols-2">
        <article class="card card-pad">
          <p class="label">Free · available now</p>
          <p class="tile-v mt-3">$0</p>
          <p class="small mt-2">No payment method. Public pages do not require an account.</p>
          <h3 class="h-card mt-6">Explore and price a build</h3>
          <ul class="mt-3 list-disc pl-5 text-sm leading-relaxed">
            <li>Read every research note, the leaderboard, model pages, methodology and compare</li>
            <li>Use the single-model calculator, and copy a link to any view</li>
            <li>Try Build Composer as a 2-role demo, verified catalog list prices only, with the same live quote math as Pro</li>
          </ul>
          {!CHECKOUT_UI_ENABLED && (
            <p class="small mt-4">The Build Composer demo is the approved Free packaging; it is not enforced during the open preview. Today the preview still runs the full 24-role editor, custom rates, sensitivity, break-even, saves and exports for everyone, until launch.</p>
          )}
        </article>

        {!CHECKOUT_UI_ENABLED && (
          <article class="card card-pad" id="pricing-pro-interest" data-clerk-enabled={CLERK_ENABLED ? 'true' : 'false'}>
            <p class="label">Pro · planned, not for sale</p>
            <p class="tile-v mt-3">$19/month <span class="text-base font-normal text-[var(--color-muted)]">or $190/year</span></p>
            <p class="small mt-2">Provisional USD price hypothesis. No plan can be purchased or reserved.</p>
            <h3 class="h-card mt-6">Keep the budget current</h3>
            <ul class="mt-3 list-disc pl-5 text-sm leading-relaxed">
              <li>Full Composer: up to 24 roles, with custom or contract rates</li>
              <li>Sensitivity, break-even and scenario deltas</li>
              <li>Versioned account saves: 20 plans, 100 versions per plan</li>
              <li>Unlisted share links and JSON, CSV and PNG exports</li>
              <li>Founding rate lock: your rate never increases while subscribed</li>
              <li>Local-hardware vs cloud: your own rig’s cost per solved task, with a break-even volume against your plan</li>
            </ul>
            <p class="small mt-4">Roadmap, not sold as active features: a re-priced digest email, reusable rate profiles, usage import and an API. Model-price and budget monitoring (alerts) is not sold until it exists.</p>
            <p class="small mt-2">Also on the roadmap (2026-08-27), same rule, nothing is sold until it exists: <b>the AI spend audit</b> (import your OpenRouter / Claude Code / Codex usage exports for reconciliation against the verified catalog, waste analysis, and a measured what-if on any other stack), <b>saved-stack re-pricing alerts</b>, <b>the data API</b> (freshness SLA, commercial licensing), <b>custom benchmark runs</b> on your own task set with auditable journals, <b>verified harness-arena badges</b>, and team workspaces.</p>
            <p class="small mt-2">The recurring hook is re-planning, review and monitoring, not access to public evidence.</p>
            <div class="mt-5 border-t border-[var(--color-rule)] pt-4">
              <h4 class="text-sm font-semibold text-[var(--color-ink)]">Would that recurring workflow be worth $19/month?</h4>
              <button type="button" class="btn mt-3" id="pricing-pro-interest-button" aria-describedby="pricing-pro-interest-help pricing-pro-interest-status" disabled>I’d consider Pro at $19</button>
              <p class="small mt-2" id="pricing-pro-interest-help">Requires a free account so one person counts once. This is a research signal only—no plan is reserved and there is no upgrade, checkout, trial, subscription or charge.</p>
              <p class="small mt-2" id="pricing-pro-interest-status" role="status" aria-live="polite" aria-atomic="true">{!PRODUCT_INTENTS_ENABLED ? 'Account-based research measurement is unavailable in this build. No interest can be submitted or charged.' : CLERK_ENABLED ? 'Free-account sign-up is loading.' : 'Free-account sign-up is unavailable in this build.'}</p>
            </div>
          </article>
        )}
        {CHECKOUT_UI_ENABLED && <ProCheckout />}
      </div>
    </Section>

    <Section id="compare-tiers" eyebrow="Comparison" title={CHECKOUT_UI_ENABLED ? 'What Free includes and what Pro adds' : 'What is open now and what is planned'}
      caption={CHECKOUT_UI_ENABLED
        ? 'Pro items below are active once you subscribe; roadmap items are still a product direction, not an available entitlement.'
        : 'Every Pro item below is a product direction, not an available entitlement.'}>
      <div class="hidden md:block tbl-wrap card">
        <table class="tbl pricing-table">
          <caption>{CHECKOUT_UI_ENABLED ? 'Comparison of Free and Solvency Pro features' : 'Comparison of current free access and planned Solvency Pro features'}</caption>
          <thead><tr><th scope="col">Capability</th><th scope="col">{CHECKOUT_UI_ENABLED ? 'Free' : 'Free now'}</th><th scope="col">{CHECKOUT_UI_ENABLED ? 'Pro' : 'Pro planned'}</th></tr></thead>
          <tbody>
            {comparison.map((row) => (
              <tr><th scope="row">{row.feature}</th><td>{row.free}</td><td>{row.pro}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="grid gap-3 md:hidden" aria-label={CHECKOUT_UI_ENABLED ? 'Comparison of Free and Solvency Pro features' : 'Comparison of current free access and planned Solvency Pro features'}>
        {comparison.map((row) => (
          <article class="card card-pad">
            <h3 class="h-card">{row.feature}</h3>
            <dl class="mt-4 grid gap-4">
              <div><dt class="label">{CHECKOUT_UI_ENABLED ? 'Free' : 'Free now'}</dt><dd class="mt-1 text-sm leading-relaxed">{row.free}</dd></div>
              <div><dt class="label">{CHECKOUT_UI_ENABLED ? 'Pro' : 'Pro planned'}</dt><dd class="mt-1 text-sm leading-relaxed">{row.pro}</dd></div>
            </dl>
          </article>
        ))}
      </div>
      <p class="small mt-3">{CHECKOUT_UI_ENABLED ? '“Roadmap” does not guarantee inclusion, timing or a final limit. ' : '“Planned” does not guarantee inclusion, timing or a final limit. '}{CHECKOUT_UI_ENABLED
        ? 'Account saves, versions and share links are enforced by the server; Composer demo limits are enforced in the page and backed by the same server checks for anything saved or shared.'
        : 'Final entitlements will be enforced by the server before billing is enabled. The Free demo cap above is the approved packaging, not yet enforced: Build Composer remains an open preview at the 24-role safety cap for everyone until launch.'}</p>
    </Section>

    <Section id="launch-decisions" eyebrow={CHECKOUT_UI_ENABLED ? 'Launch terms' : 'Before public checkout'} title={CHECKOUT_UI_ENABLED ? 'The terms, decided' : 'Terms that still need a launch decision'}
      caption={CHECKOUT_UI_ENABLED
        ? 'Each of these was decided and published at launch. The checkout screen shows them again before any payment is submitted.'
        : 'These items will be decided and published before any public or live payment action is shown.'}>
      <div class="tile-grid sm:grid-cols-2">
        {launchDecisions.map((item) => (
          <article class="tile">
            <p class="label">{item.title}</p>
            <p class="mt-2 text-sm leading-relaxed">{item.copy}</p>
          </article>
        ))}
      </div>
      <div class="card card-pad mt-4">
        <h3 class="h-card">Required pre-checkout disclosure</h3>
        <p class="mt-2 text-sm leading-relaxed max-w-3xl">{CHECKOUT_UI_ENABLED
          ? 'The purchase screen shows the final USD amount and billing cadence, automatic-renewal terms, trial treatment, cancellation timing, refund policy and tax treatment before payment is submitted, and links the current '
          : 'A future purchase screen must show the final USD amount and billing cadence, automatic-renewal terms, trial treatment, cancellation timing, refund policy and tax treatment before payment is submitted. It must also link the then-current '}<a class="link" href="/terms">Terms</a> and <a class="link" href="/privacy">Privacy policy</a>.</p>
      </div>
    </Section>
  </div>
  <script>
    import { observeClerkAuth, openSignUp, recordProductIntentSignal, signedIn, type ClerkAuthState } from '../lib/clerk-client.ts';

    const root = document.getElementById('pricing-pro-interest');
    const button = document.getElementById('pricing-pro-interest-button') as HTMLButtonElement | null;
    const status = document.getElementById('pricing-pro-interest-status');
    if (root && button && status) {
      const measurementEnabled = document.documentElement.dataset.productIntentsEnabled === 'true';
      let latestAuthState: ClerkAuthState = { status: 'checking' };
      const renderAuth = (state: ClerkAuthState) => {
        latestAuthState = state;
        const authReady = state.status === 'signed-in' || state.status === 'signed-out';
        const ready = measurementEnabled && authReady;
        button.disabled = !ready;
        button.toggleAttribute('aria-busy', measurementEnabled && state.status === 'checking');
        if (!measurementEnabled) {
          status.textContent = 'Account-based research measurement is unavailable in this build. No interest can be submitted or charged.';
          return;
        }
        if (ready) {
          if (status.dataset.authReadiness === 'true') status.textContent = '';
          delete status.dataset.authReadiness;
          return;
        }
        status.dataset.authReadiness = 'true';
        status.textContent = state.status === 'checking'
          ? 'Free-account sign-up is loading.'
          : 'Free-account sign-up is unavailable in this build. No interest was submitted and nothing was charged.';
      };
      button.addEventListener('click', async () => {
        if (!measurementEnabled) return;
        delete status.dataset.authReadiness;
        if (signedIn()) {
          button.disabled = true;
          button.setAttribute('aria-busy', 'true');
          const submitted = await recordProductIntentSignal('pro_price_interest');
          status.textContent = submitted
            ? 'Thanks, your account-based research signal was accepted. No upgrade exists and nothing was charged.'
            : 'We could not confirm your interest signal. You can retry safely; account-based signals are deduplicated. No upgrade exists and nothing was charged.';
          button.removeAttribute('aria-busy');
          const authReady = latestAuthState.status === 'signed-in' || latestAuthState.status === 'signed-out';
          button.disabled = !measurementEnabled || !authReady;
          return;
        }
        const result = openSignUp('gate', 'Create a free account, then return here to share interest in Solvency Pro at $19/month. No checkout or charge.');
        status.textContent = result === 'opened'
          ? 'Free-account sign-up opened. After signing in, select this button again to submit your interest. Nothing was submitted or charged yet.'
          : result === 'queued'
            ? 'Free-account sign-up is loading. After signing in, select this button again to submit your interest. Nothing was submitted or charged yet.'
            : 'Free-account sign-up is unavailable right now. No interest was submitted and nothing was charged.';
        if (result === 'unavailable') button.disabled = true;
      });
      const stop = observeClerkAuth(renderAuth, { enabled: root.dataset.clerkEnabled === 'true' });
      addEventListener('pagehide', stop, { once: true });
    }
  </script>
</Base>

<style>
  .pricing-table { min-width: 44rem; white-space: normal; }
  .pricing-table th, .pricing-table td { width: 30%; vertical-align: top; line-height: 1.55; }
  .pricing-table th:first-child { width: 40%; }
</style>
