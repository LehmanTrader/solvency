---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import BarChart from '../../components/BarChart.astro';
import Provenance from '../../components/Provenance.astro';
import { sourceFor, shortSourceName } from '../../lib/data.ts';
import { solvedFor, money, ratio, fmtX } from '../../lib/headline.ts';

export async function getStaticPaths() {
  const { models } = await import('../../lib/data.ts');
  const paths = [];
  for (let i = 0; i < models.length; i++)
    for (let j = i + 1; j < models.length; j++)
      paths.push({ params: { pair: `${models[i].model_id}-vs-${models[j].model_id}` }, props: { a: models[i], b: models[j] } });
  return paths;
}

const { a, b } = Astro.props;
const sa = solvedFor(a.model_id, 'heavy'), sb = solvedFor(b.model_id, 'heavy');
const outX = ratio(a.output_per_mtok, b.output_per_mtok);
const inX = ratio(a.input_per_mtok, b.input_per_mtok);
const cheaperTokens = a.output_per_mtok < b.output_per_mtok ? a : b;
const both = sa !== null && sb !== null;
const sameBasis = both && sa.basisKey === sb.basisKey;
const solvedX = both ? ratio(sa.cost, sb.cost) : null;
const cheaperSolved = both ? (sa.cost < sb.cost ? a : b) : null;
const flips = both && cheaperTokens.model_id !== cheaperSolved.model_id;
const basisLabel = (s) => s ? (s.basisKey === 'measured_by_source' ? 'measured' : 'modelled') : null;
const price = (n) => n === null || n === undefined ? null : `$${n.toFixed(3).replace(/0+$/, '').replace(/\.$/, '')}`;
const metric = (label, va, vb, fmt, note?) => ({ label, note, items: [
  { label: a.display_name, value: va ?? 0, display: va == null ? 'missing' : fmt(va), lead: va != null && vb != null && va <= vb },
  { label: b.display_name, value: vb ?? 0, display: vb == null ? 'missing' : fmt(vb), lead: va != null && vb != null && vb < va },
]});
const charts = [
  metric('Input $/M tokens', a.input_per_mtok, b.input_per_mtok, price, 'lower is better'),
  metric('Output $/M tokens', a.output_per_mtok, b.output_per_mtok, price, 'lower is better'),
  metric('Cost per solved task', sa?.cost ?? null, sb?.cost ?? null, money, both ? (sameBasis ? `${basisLabel(sa)} basis · lower is better` : 'different bases — not comparable') : 'needs a pass rate for both'),
];
const rows = [
  ['Input $/Mtok', price(a.input_per_mtok), price(b.input_per_mtok)],
  ['Output $/Mtok', price(a.output_per_mtok), price(b.output_per_mtok)],
  ['Cached input $/Mtok', price(a.cached_input_per_mtok) ?? 'missing', price(b.cached_input_per_mtok) ?? 'missing'],
  ['Pass rate', sa ? `${Math.round(sa.r.pass_rate * 100)}%` : 'missing', sb ? `${Math.round(sb.r.pass_rate * 100)}%` : 'missing'],
  ['Pass rate source', sa ? shortSourceName(sa.r.benchmark) : 'missing', sb ? shortSourceName(sb.r.benchmark) : 'missing'],
  ['Cost basis', basisLabel(sa) ?? 'missing', basisLabel(sb) ?? 'missing'],
  ['Cost per solved task', sa ? money(sa.cost) : 'missing', sb ? money(sb.cost) : 'missing'],
];
const desc = both && sameBasis
  ? `${cheaperSolved.display_name} costs ${fmtX(solvedX)} less per solved task (${basisLabel(sa)}). Token price alone would tell you ${cheaperTokens.display_name} is ${fmtX(outX)} cheaper.`
  : `Verified API pricing for ${a.display_name} and ${b.display_name}. Cost per solved task requires a published pass rate for both, on the same cost basis.`;
const srcA = sa ? sourceFor(sa.r.benchmark) : null;
---
<Base title={`${a.display_name} vs ${b.display_name} — cost per solved task — Solvency`} description={desc}>
  <div class="wrap pt-10">
    <p class="eyebrow">Head to head</p>
    <h1 class="h-page mt-3">{a.display_name} <span class="text-[var(--color-muted)]">vs</span> {b.display_name}</h1>
    <div class="mt-4 flex flex-wrap gap-2">
      <Badge status={a.status}>{a.display_name}: {a.status}</Badge>
      <Badge status={b.status}>{b.display_name}: {b.status}</Badge>
      <Badge>heavy tier</Badge>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-[1.1fr_1fr] items-start">
      <div class="card card-pad">
        {both && sameBasis ? (
          <>
            <p class="label">Verdict · {basisLabel(sa)} basis</p>
            <p class="mt-2 text-xl leading-snug text-[var(--color-ink)]">
              <strong class="text-[var(--color-accent)]">{cheaperSolved.display_name}</strong> costs
              <strong class="text-[var(--color-accent)]"> {fmtX(solvedX)} less</strong> per solved task.
            </p>
            <p class="mt-3 text-[var(--color-muted)] leading-relaxed">
              On output token price alone, {cheaperTokens.display_name} looks {fmtX(outX)} cheaper ({fmtX(inX)} on input).
              {flips ? ' The ranking reverses once you divide by pass rate — the cheaper tokens do not win the task.' : ' The ranking holds, but the margin changes.'}
            </p>
          </>
        ) : both ? (
          <>
            <p class="label">No verdict</p>
            <p class="mt-2 text-[var(--color-ink)] leading-relaxed">One cost is measured by its benchmark and the other is modelled by Solvency. The two bases are never ranked against each other, so no verdict is given here.</p>
          </>
        ) : (
          <>
            <p class="label">No verdict</p>
            <p class="mt-2 text-[var(--color-ink)] leading-relaxed">Cost per solved task needs a published pass rate for both models. At least one has none, so it is reported as missing rather than estimated.</p>
          </>
        )}
        <Provenance source={srcA?.attribution} href={srcA?.attribution_url ?? srcA?.source_url} verified={a.last_verified} note="prices from each provider's pricing page" />
      </div>

      <div class="card overflow-hidden">
        {charts.map((c) => (
          <div class="card-pad border-b border-[var(--color-rule)] last:border-b-0">
            <div class="flex items-baseline justify-between gap-3"><p class="label">{c.label}</p><p class="small">{c.note}</p></div>
            <BarChart items={c.items} class="mt-3" />
          </div>
        ))}
      </div>
    </div>

    <div class="mt-6 card overflow-hidden"><div class="tbl-wrap"><table class="tbl">
      <thead><tr><th></th><th class="r"><a href={`/models/${a.model_id}`}>{a.display_name}</a></th><th class="r"><a href={`/models/${b.model_id}`}>{b.display_name}</a></th></tr></thead>
      <tbody>{rows.map(([k, x, y]) => (
        <tr>
          <td class="muted">{k}</td>
          <td class={`r ${x === 'missing' ? 'missing' : 'ink'}`}>{x}</td>
          <td class={`r ${y === 'missing' ? 'missing' : 'ink'}`}>{y}</td>
        </tr>))}</tbody>
    </table></div></div>
    <Provenance verified={a.last_verified} note="heavy task tier; measured rows ignore the tier">
      · <a class="link" href="/methodology">Methodology</a>
      · <a class="link" href={`/models/${a.model_id}`}>{a.display_name}</a>
      · <a class="link" href={`/models/${b.model_id}`}>{b.display_name}</a>
    </Provenance>
  </div>
</Base>
