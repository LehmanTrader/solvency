---
import Base from '../../layouts/Base.astro';
import { assumptions, tiers, bestResultFor, extrasFor } from '../../lib/data.ts';
import { costPerSolvedTask, defaultOptions } from '../../lib/engine.ts';

export async function getStaticPaths() {
  const { models } = await import('../../lib/data.ts');
  const paths = [];
  for (let i = 0; i < models.length; i++)
    for (let j = i + 1; j < models.length; j++)
      paths.push({ params: { pair: `${models[i].model_id}-vs-${models[j].model_id}` }, props: { a: models[i], b: models[j] } });
  return paths;
}

const { a, b } = Astro.props;
const opts = defaultOptions(assumptions);
const solved = (m) => {
  const r = bestResultFor(m.model_id);
  if (!r) return { v: null, r: null };
  const out = costPerSolvedTask(m, 'heavy', tiers.heavy, r.pass_rate, opts, extrasFor(r));
  return { v: out.value?.naive ?? null, r };
};
const sa = solved(a), sb = solved(b);
const money = (n) => n >= 100 ? `$${n.toFixed(0)}` : `$${n.toFixed(2)}`;
const ratio = (x, y) => (x > y ? x / y : y / x);
const outRatio = ratio(a.output_per_mtok, b.output_per_mtok);
const cheaperTokens = a.output_per_mtok < b.output_per_mtok ? a : b;
const both = sa.v !== null && sb.v !== null;
const solvedRatio = both ? ratio(sa.v, sb.v) : null;
const cheaperSolved = both ? (sa.v < sb.v ? a : b) : null;
const flips = both && cheaperTokens.model_id !== cheaperSolved.model_id;
const rows = [
  ['Input $/Mtok', `$${a.input_per_mtok}`, `$${b.input_per_mtok}`],
  ['Output $/Mtok', `$${a.output_per_mtok}`, `$${b.output_per_mtok}`],
  ['Cached in $/Mtok', a.cached_input_per_mtok === null ? 'missing' : `$${a.cached_input_per_mtok}`, b.cached_input_per_mtok === null ? 'missing' : `$${b.cached_input_per_mtok}`],
  ['Pass rate', sa.r ? `${(sa.r.pass_rate*100).toFixed(0)}%` : 'missing', sb.r ? `${(sb.r.pass_rate*100).toFixed(0)}%` : 'missing'],
  ['Cost per solved task', sa.v === null ? 'missing' : money(sa.v), sb.v === null ? 'missing' : money(sb.v)],
];
const desc = both
  ? `${cheaperSolved.display_name} costs ${solvedRatio.toFixed(1)}x less per solved task. Token price alone would tell you ${cheaperTokens.display_name} is ${outRatio.toFixed(1)}x cheaper.`
  : `Verified API pricing for ${a.display_name} and ${b.display_name}. Cost per solved task requires a published pass rate for both.`;
---
<Base title={`${a.display_name} vs ${b.display_name} — cost per solved task — Solvency`} description={desc}>
  <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-[var(--color-accent)]">Head to head</p>
  <h1 class="mt-3 font-mono text-3xl sm:text-4xl font-bold tracking-tight text-[var(--color-ink)]">
    {a.display_name} <span class="text-[var(--color-muted)]">vs</span> {b.display_name}
  </h1>

  {both && (
    <div class="mt-8 border border-[var(--color-rule)] rounded-md p-6">
      <p class="text-lg text-[var(--color-ink)]">
        <strong class="text-[var(--color-accent)]">{cheaperSolved.display_name}</strong> costs
        <strong class="text-[var(--color-accent)]"> {solvedRatio.toFixed(1)}x less</strong> per solved task.
      </p>
      <p class="mt-3 text-[var(--color-muted)]">
        On output token price alone, {cheaperTokens.display_name} looks {outRatio.toFixed(1)}x cheaper.
        {flips ? ' The ranking reverses once you divide by pass rate — the cheaper tokens do not win the task.' : ' The ranking holds, but the margin changes.'}
      </p>
    </div>
  )}
  {!both && (
    <p class="mt-8 text-[var(--color-muted)]">
      Cost per solved task needs a published pass rate for both models. At least one of these has none, so it is reported as missing rather than estimated.
    </p>
  )}

  <div class="mt-10 overflow-x-auto"><table class="w-full font-mono text-[13px] tabular-nums">
    <thead><tr class="text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)] border-b border-[var(--color-accent)]">
      <th class="text-left py-2 pr-4"></th>
      <th class="text-right px-4">{a.display_name}</th><th class="text-right pl-4">{b.display_name}</th>
    </tr></thead>
    <tbody>{rows.map(([k, x, y]) => (
      <tr class="border-b border-[var(--color-rule)]">
        <td class="py-2.5 pr-4 text-[var(--color-muted)]">{k}</td>
        <td class={`px-4 text-right ${x === 'missing' ? 'text-[var(--color-muted)]' : 'text-[var(--color-ink)]'}`}>{x}</td>
        <td class={`pl-4 text-right ${y === 'missing' ? 'text-[var(--color-muted)]' : 'text-[var(--color-ink)]'}`}>{y}</td>
      </tr>))}</tbody>
  </table></div>

  <p class="mt-6 font-mono text-[11px] text-[var(--color-muted)]">
    Heavy task tier. Prices verified {a.last_verified}.
    <a class="text-[var(--color-ink)] border-b border-[var(--color-accent)]/50" href="/methodology">Methodology</a> ·
    <a class="text-[var(--color-ink)] border-b border-[var(--color-accent)]/50" href={`/models/${a.model_id}`}>{a.display_name}</a> ·
    <a class="text-[var(--color-ink)] border-b border-[var(--color-accent)]/50" href={`/models/${b.model_id}`}>{b.display_name}</a>
  </p>
</Base>
