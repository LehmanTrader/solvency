---
/** Bare widget for embedding. No site chrome, no navigation, attribution always on. */
import '../../styles/global.css';
---
<!doctype html>
<html lang="en"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Cost per solved task, Solvency</title><meta name="robots" content="noindex" />
<style>html,body{margin:0}</style>
</head><body>
  <div class="p-4">
    <table class="w-full font-mono text-[12px] tabular-nums">
      <thead><tr class="text-[9px] uppercase tracking-[0.14em] text-[var(--color-muted)] border-b border-[var(--color-rule-strong)]">
        <th class="text-left pb-2 pr-3">Model</th><th class="text-right px-3">Pass</th><th class="text-right pl-3">$ / solved task</th>
      </tr></thead>
      <tbody id="e-body"></tbody>
    </table>
    <p id="e-note" class="mt-3 font-mono text-[9px] text-[var(--color-muted)]"></p>
    <p class="mt-1 font-mono text-[9px]">
      <a href="https://solvency.dev" target="_blank" rel="noopener" class="link">Data: Solvency (solvency.dev)</a>
    </p>
  </div>
<script>
  import { models, assumptions, tiers, bestResultFor, extrasFor } from '../../lib/data.ts';
  import { costPerSolvedTask, defaultOptions } from '../../lib/engine.ts';
  const q = new URLSearchParams(location.search);
  const want = (q.get('models') ?? '').split(',').map((s) => s.trim()).filter(Boolean);
  const TIERS = ['light', 'moderate', 'heavy'] as const;
  const tier = (TIERS as readonly string[]).includes(q.get('tier') ?? '') ? (q.get('tier') as typeof TIERS[number]) : 'heavy';
  const opts = defaultOptions(assumptions);
  const money = (n: number) => n >= 100 ? `$${n.toFixed(0)}` : `$${n.toFixed(2)}`;

  // Free-model coverage: this embed has no UI for a FREE/rate-capped badge
  // or cap numbers, so a $0 row would rank #1 here with no context at all —
  // exactly the "never lets $0 stand alone" case (docs/free-models-scoping.md
  // §4). Excluded until this widget gets its own basis treatment.
  const pool = (want.length ? models.filter((m) => want.includes(m.model_id)) : models).filter((m) => m.access_tier !== 'free');
  const rows = pool.map((m) => {
    const r = bestResultFor(m.model_id); if (!r) return null;
    const out = costPerSolvedTask(m, tier, tiers[tier], r.pass_rate, opts, extrasFor(r));
    return out.value ? { m, r, cost: out.value.naive, basis: out.value.costBasis } : null;
  }).filter(Boolean) as any[];

  // one basis only: mixing measured and modeled costs in one ranked list is invalid
  const measured = rows.filter((x) => x.basis === 'measured_by_source');
  const show = (measured.length ? measured : rows).sort((a, b) => a.cost - b.cost);
  const body = document.getElementById('e-body')!;
  body.replaceChildren(...show.map(({ m, r, cost, basis }) => {
    const tr = document.createElement('tr'); tr.className = 'border-b border-[var(--color-rule)]';
    const name = document.createElement('td'); name.className = 'py-1.5 pr-3 text-[var(--color-ink)]'; name.textContent = m.display_name;
    const pass = document.createElement('td'); pass.className = 'px-3 text-right text-[var(--color-body)]'; pass.textContent = `${(r.pass_rate * 100).toFixed(0)}%`;
    // Data accent (purple), not brand amber — this is the "measured/modeled" job, never brand/highlight.
    // Two full literal class strings, not a template-built one: Tailwind's
    // static scanner needs the whole arbitrary-value class present verbatim
    // in source to generate its rule.
    const solved = document.createElement('td');
    solved.className = basis === 'measured_by_source'
      ? 'pl-3 text-right text-[var(--color-measured)]'
      : 'pl-3 text-right text-[var(--color-modelled)]';
    solved.textContent = money(cost);
    tr.append(name, pass, solved);
    return tr;
  }));
  document.getElementById('e-note')!.textContent =
    `${measured.length ? 'Measured' : 'Modeled'} basis · ${tier} tier · prices verified ${models[0].last_verified}`;
</script>
</body></html>
