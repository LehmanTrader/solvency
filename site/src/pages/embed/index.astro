---
import Base from '../../layouts/Base.astro';
const snippet = `<iframe
  src="https://solvency.dev/embed/table?models=claude-opus-5,gpt-5.6-sol,grok-4.5,deepseek-v4-flash&tier=heavy"
  width="100%" height="260" frameborder="0" loading="lazy"
  title="Cost per solved task — Solvency"></iframe>`;
---
<Base title="Embed — Solvency" description="Embed a live cost-per-solved-task table on your own site.">
  <h1 class="font-mono text-3xl font-bold text-[var(--color-ink)]">Embed</h1>
  <p class="mt-4 max-w-2xl">Drop a live cost-per-solved-task table into your own page. It updates when the underlying prices do, and it always carries an attribution link back.</p>

  <div class="prose mt-10">
    <h3>Snippet</h3>
    <pre><code>{snippet}</code></pre>
    <h3>Parameters</h3>
    <ul>
      <li><code>models</code> — comma-separated model ids. Omit for all tracked models.</li>
      <li><code>tier</code> — <code>light</code>, <code>moderate</code> or <code>heavy</code>. Defaults to heavy. Ignored for measured rows, which carry an observed cost.</li>
    </ul>
    <h3>Terms</h3>
    <p>Free to embed, commercially or otherwise. The attribution link must remain visible — that is the only condition.
      Underlying benchmark data belongs to its publishers and is cited, not redistributed; see <a href="/data">Data</a>.</p>
    <h3>Preview</h3>
  </div>
  <div class="mt-4 border border-[var(--color-rule)] rounded-md overflow-hidden">
    <iframe src="/embed/table?models=claude-opus-5,gpt-5.6-sol,grok-4.5,deepseek-v4-flash&tier=heavy"
            width="100%" height="230" frameborder="0" title="Preview"></iframe>
  </div>
</Base>
