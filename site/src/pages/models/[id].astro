---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Section from '../../components/Section.astro';
import BarChart from '../../components/BarChart.astro';
import Provenance from '../../components/Provenance.astro';
import { models, assumptions, tiers, TIER_NAMES, allResultsFor, bestResultFor, extrasFor, sourceFor } from '../../lib/data.ts';
import { costPerSolvedTask, defaultOptions } from '../../lib/engine.ts';
import { solvedFor, leaderboard, money } from '../../lib/headline.ts';

export async function getStaticPaths() {
  const { models } = await import('../../lib/data.ts');
  return models.map((m) => ({ params: { id: m.model_id }, props: { model: m } }));
}
const { model } = Astro.props;
const opts = defaultOptions(assumptions);
const rows = allResultsFor(model.model_id);
const best = bestResultFor(model.model_id);
const tierCosts = TIER_NAMES.map((t) => {
  const out = best ? costPerSolvedTask(model, t, tiers[t], best.pass_rate, opts, extrasFor(best)) : null;
  return { tier: t, value: out?.value?.naive ?? null };
});
const measured = best?.cost_basis === 'measured_by_source';
const bestSrc = best ? sourceFor(best.benchmark) : null;
const price = (n) => n === null || n === undefined ? null : `$${n.toFixed(3).replace(/0+$/, '').replace(/\.$/, '')}`;
const mine = solvedFor(model.model_id, 'heavy');
// peers: same cost basis only, so the chart never ranks measured against modelled
const lb = leaderboard('heavy');
const pool = mine ? (mine.basisKey === 'measured_by_source' ? lb.measured : [...lb.modelled, ...lb.historical]) : [];
const peerBars = pool.map((x) => ({ label: x.m.display_name, value: x.cost, display: money(x.cost), href: `/models/${x.m.model_id}`, lead: x.m.model_id === model.model_id }));
const peers = models.filter((m) => m.model_id !== model.model_id && m.status === 'current').slice(0, 8);
---
<Base title={`${model.display_name} — pricing and cost per solved task — Solvency`}
      description={`${model.display_name} API pricing verified ${model.last_verified}: $${model.input_per_mtok}/M input, $${model.output_per_mtok}/M output${mine ? `, ${money(mine.cost)} per solved task (${measured ? 'measured' : 'modelled'})` : ', no published pass rate'}.`}>
  <div class="wrap pt-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{model.provider}</p>
        <h1 class="h-page mt-3">{model.display_name}</h1>
        <div class="mt-4 flex flex-wrap gap-2">
          <Badge status={model.status}>{model.status}</Badge>
          <Badge>{model.capability_class}</Badge>
          {best && <Badge provenance={measured ? 'measured' : best.cost_basis === 'historical_at_run_date' ? 'stale' : 'modelled'}>{measured ? 'measured cost' : best.cost_basis === 'historical_at_run_date' ? 'modelled cost · stale pass rate' : 'modelled cost'}</Badge>}
          <Badge>verified {model.last_verified}</Badge>
        </div>
      </div>
      <a href={model.source_url} rel="noopener" class="btn">Provider pricing page ↗</a>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="label">List price · USD per million tokens</p>
        <div class="tile-grid mt-2 grid-cols-2 sm:grid-cols-4">
          {[['Input', model.input_per_mtok], ['Output', model.output_per_mtok], ['Cached input', model.cached_input_per_mtok]].map(([label, v]) => (
            <div class="tile">
              <p class="label">{label}</p>
              <p class={`tile-v ${v === null ? 'missing' : ''}`}>{price(v) ?? 'missing'}</p>
            </div>))}
          <div class="tile">
            <p class="label">Context</p>
            <p class={`tile-v ${model.context_window ? '' : 'missing'}`}>{model.context_window ? `${(model.context_window / 1000).toFixed(0)}k` : 'missing'}</p>
          </div>
        </div>
        <Provenance source="Provider pricing page" href={model.source_url} verified={model.last_verified} />
      </div>
      <div>
        <p class="label">Cost per solved task · by task tier</p>
        {best ? (
          <div class="tile-grid mt-2 grid-cols-3">
            {tierCosts.map((t) => (
              <div class="tile">
                <p class="label">{t.tier}</p>
                <p class={`tile-v ${t.value === null ? 'missing' : measured ? 'measured' : 'modelled'}`}>{t.value === null ? 'missing' : money(t.value)}</p>
              </div>))}
          </div>
        ) : (
          <div class="tile-grid mt-2 grid-cols-1"><div class="tile">
            <p class="tile-v missing">missing</p>
            <p class="tile-n">No published pass rate, so cost per solved task cannot be derived. Reported as missing rather than estimated.</p>
          </div></div>
        )}
        {best && (
          <Provenance source={bestSrc?.attribution} href={bestSrc?.attribution_url ?? best.source_url} verified={bestSrc?.last_verified ?? best.run_date}
            note={measured ? 'measured basis: the benchmark observed this cost, so no tier assumption touches it and the three tiers are identical' : 'modelled basis: pass rate published, cost from Solvency\'s loop model at current prices'} />
        )}
      </div>
    </div>

    {model.pricing_notes && (
      <p class="mt-6 text-sm text-[var(--color-body)] border-l-2 border-[var(--color-accent)] pl-4 max-w-3xl">{model.pricing_notes}</p>
    )}

    <Section id="benchmarks" eyebrow="Benchmark rows" title="Where the pass rate comes from"
      caption="Every row that names this model, with its harness and cost basis. Rows are harness + model combinations, not properties of the bare model.">
      {rows.length ? (
        <div class="card overflow-hidden"><div class="tbl-wrap"><table class="tbl">
          <thead><tr><th>Benchmark</th><th>Entry</th><th class="r">Pass</th><th class="r">$ / task</th><th>Basis</th><th>Run / read</th></tr></thead>
          <tbody>{rows.map((r) => (
            <tr>
              <td class="ink"><a href={r.source_url} rel="noopener">{sourceFor(r.benchmark)?.name ?? r.benchmark}</a></td>
              <td class="muted">{r.entry_label}</td>
              <td class="r">{(r.pass_rate * 100).toFixed(1)}%</td>
              <td class={`r ${r.measured_cost_per_task_usd == null ? 'missing' : ''}`}>{r.measured_cost_per_task_usd == null ? 'not published' : money(r.measured_cost_per_task_usd)}</td>
              <td class="muted">{r.cost_basis.replace(/_/g, ' ')}</td>
              <td class="muted">{r.run_date}</td>
            </tr>))}</tbody>
        </table></div></div>
      ) : <p class="text-[var(--color-muted)]">No benchmark covers this model. Reported as missing rather than estimated.</p>}
    </Section>

    {peerBars.length > 1 && (
      <Section id="peers" eyebrow={mine.basisKey === 'measured_by_source' ? 'Measured peers' : 'Modelled peers'} title="Cost per solved task against its peers"
        caption={mine.basisKey === 'measured_by_source' ? 'Measured rows only. Lower is better.' : 'Modelled rows only, heavy tier. Lower is better. These are Solvency estimates, not observed costs.'}>
        <div class="card card-pad max-w-5xl"><BarChart items={peerBars} tone={mine.basisKey === 'measured_by_source' ? 'measured' : 'modelled'} /></div>
        <Provenance source={bestSrc?.attribution} href={bestSrc?.attribution_url ?? best.source_url} verified={bestSrc?.last_verified ?? best.run_date} />
      </Section>
    )}

    <Section id="compare" eyebrow="Compare" title="Head to head" caption="Side-by-side pricing and cost per solved task with another current model.">
      <div class="flex flex-wrap gap-2">
        {peers.map((p) => <a class="btn" href={`/compare/${model.model_id}-vs-${p.model_id}`}>vs {p.display_name}</a>)}
      </div>
    </Section>
  </div>
</Base>
