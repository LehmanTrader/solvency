---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { models, assumptions, tiers, TIER_NAMES, allResultsFor, bestResultFor, extrasFor, sourceFor } from '../../lib/data.ts';
import { costPerSolvedTask, defaultOptions } from '../../lib/engine.ts';

export async function getStaticPaths() {
  const { models } = await import('../../lib/data.ts');
  return models.map((m) => ({ params: { id: m.model_id }, props: { model: m } }));
}
const { model } = Astro.props;
const opts = defaultOptions(assumptions);
const rows = allResultsFor(model.model_id);
const best = bestResultFor(model.model_id);
const tierCosts = TIER_NAMES.map((t) => {
  const out = best ? costPerSolvedTask(model, t, tiers[t], best.pass_rate, opts, extrasFor(best)) : null;
  return { tier: t, value: out?.value?.naive ?? null, basis: out?.value?.costBasis };
});
const peers = models.filter((m) => m.model_id !== model.model_id && m.status === 'current').slice(0, 6);
const money = (n) => n >= 100 ? `$${n.toFixed(0)}` : `$${n.toFixed(2)}`;
---
<Base title={`${model.display_name} — pricing and cost per solved task — Solvency`}
      description={`${model.display_name} API pricing verified ${model.last_verified}: $${model.input_per_mtok}/M input, $${model.output_per_mtok}/M output, and cost per solved task where a pass rate exists.`}>
  <p class="font-mono text-[11px] tracking-[0.18em] uppercase text-[var(--color-accent)]">{model.provider}</p>
  <h1 class="mt-3 font-mono text-4xl font-bold tracking-tight text-[var(--color-ink)]">{model.display_name}</h1>
  <div class="mt-4 flex flex-wrap gap-2">
    <Badge tone={model.status === 'current' ? 'accent' : 'warn'}>{model.status}</Badge>
    <Badge>{model.capability_class}</Badge>
    <Badge>verified {model.last_verified}</Badge>
  </div>

  <h2 class="mt-12 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-accent)]">Pricing</h2>
  <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 border border-[var(--color-rule)] rounded-md overflow-hidden">
    {[['Input','input_per_mtok'],['Output','output_per_mtok'],['Cached in','cached_input_per_mtok']].map(([label,key]) => (
      <div class="p-4 border-r border-b border-[var(--color-rule)]">
        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)]">{label} $/Mtok</p>
        <p class="mt-2 font-mono text-2xl font-bold text-[var(--color-ink)]">
          {model[key] === null ? <span class="text-[var(--color-muted)] text-lg">missing</span> : `$${model[key].toFixed(3).replace(/0+$/,'').replace(/\.$/,'')}`}
        </p>
      </div>))}
    <div class="p-4 border-b border-[var(--color-rule)]">
      <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)]">Context</p>
      <p class="mt-2 font-mono text-2xl font-bold text-[var(--color-ink)]">
        {model.context_window ? `${(model.context_window/1000).toFixed(0)}k` : <span class="text-[var(--color-muted)] text-lg">missing</span>}
      </p>
    </div>
  </div>
  <p class="mt-3 font-mono text-[11px] text-[var(--color-muted)]">
    <a class="border-b border-[var(--color-accent)]/50 text-[var(--color-ink)]" href={model.source_url}>Provider pricing page</a> · verified {model.last_verified}
  </p>
  {model.pricing_notes && <p class="mt-4 text-sm text-[var(--color-muted)] border-l-2 border-[var(--color-accent)] pl-4">{model.pricing_notes}</p>}

  <h2 class="mt-12 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-accent)]">Cost per solved task</h2>
  {best ? (
    <div class="mt-4 grid grid-cols-3 border border-[var(--color-rule)] rounded-md overflow-hidden">
      {tierCosts.map((t) => (
        <div class="p-4 border-r border-[var(--color-rule)] last:border-r-0">
          <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)]">{t.tier}</p>
          <p class="mt-2 font-mono text-2xl font-bold text-[var(--color-accent)]">{t.value === null ? '—' : money(t.value)}</p>
        </div>))}
    </div>
  ) : (
    <p class="mt-4 text-[var(--color-muted)]">No published pass rate for this model, so cost per solved task cannot be derived. Reported as missing rather than estimated.</p>
  )}
  {best?.cost_basis === 'measured_by_source' && (
    <p class="mt-3 font-mono text-[11px] text-[var(--color-muted)]">Measured basis: the benchmark observed this cost. No Solvency assumption is inside it, so the three tiers are identical.</p>
  )}

  <h2 class="mt-12 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-accent)]">Benchmark rows</h2>
  {rows.length ? (
    <div class="mt-4 overflow-x-auto"><table class="w-full font-mono text-[12px] tabular-nums">
      <thead><tr class="text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)] border-b border-[var(--color-accent)]">
        <th class="text-left py-2 pr-4">Benchmark</th><th class="text-left px-4">Entry</th><th class="text-right px-4">Pass</th><th class="text-left pl-4">Basis</th>
      </tr></thead>
      <tbody>{rows.map((r) => (
        <tr class="border-b border-[var(--color-rule)]">
          <td class="py-2 pr-4"><a class="text-[var(--color-ink)] border-b border-[var(--color-accent)]/40" href={r.source_url}>{sourceFor(r.benchmark)?.name ?? r.benchmark}</a></td>
          <td class="px-4 text-[var(--color-muted)]">{r.entry_label}</td>
          <td class="px-4 text-right">{(r.pass_rate * 100).toFixed(1)}%</td>
          <td class="pl-4 text-[var(--color-muted)]">{r.cost_basis.replace(/_/g,' ')}</td>
        </tr>))}</tbody>
    </table></div>
  ) : <p class="mt-4 text-[var(--color-muted)]">No benchmark covers this model.</p>}

  <h2 class="mt-12 font-mono text-[11px] uppercase tracking-[0.16em] text-[var(--color-accent)]">Compare</h2>
  <div class="mt-4 flex flex-wrap gap-2">
    {peers.map((p) => (
      <a class="font-mono text-[12px] border border-[var(--color-rule)] rounded px-3 py-1.5 hover:border-[var(--color-accent)]/60 hover:text-[var(--color-accent)]"
         href={`/compare/${model.model_id}-vs-${p.model_id}`}>vs {p.display_name}</a>))}
  </div>
</Base>
