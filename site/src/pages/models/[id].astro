---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Provenance from '../../components/Provenance.astro';
import LogoChip from '../../components/LogoChip.astro';
import { models, assumptions, tiers, TIER_NAMES, allResultsFor, bestResultFor, extrasFor, sourceFor } from '../../lib/data.ts';
import { costPerSolvedTask, defaultOptions } from '../../lib/engine.ts';
import { solvedFor, leaderboard, money } from '../../lib/headline.ts';
import { rankedBars, BASIS_OF, capsLabel, type ChartRow } from '../../lib/charts.ts';
import { providerLabel } from '../../lib/providers.ts';
import { pairHref, pairPath } from '../../lib/calc.ts';

export async function getStaticPaths() {
  const { models } = await import('../../lib/data.ts');
  return models.map((m) => ({ params: { id: m.model_id }, props: { model: m } }));
}
const { model } = Astro.props;
const opts = defaultOptions(assumptions);
const rows = allResultsFor(model.model_id);
const attemptCostFor = (r) => {
  if (r.cost_basis === 'measured_by_source') return r.measured_cost_per_task_usd ?? null;
  if (r.cost_basis !== 'source_usage_repriced') return null;
  return costPerSolvedTask(model, 'heavy', tiers.heavy, r.pass_rate, opts, extrasFor(r)).value?.attempt.costUsd ?? null;
};
const harnessRows = rows.filter((r) => r.cost_basis === 'source_usage_repriced');
const best = bestResultFor(model.model_id);
const tierCosts = TIER_NAMES.map((t) => {
  const out = best ? costPerSolvedTask(model, t, tiers[t], best.pass_rate, opts, extrasFor(best)) : null;
  return { tier: t, value: out?.value?.naive ?? null };
});
const measured = best?.cost_basis === 'measured_by_source';
const basis = best ? (BASIS_OF[best.cost_basis] ?? 'modelled') : null;
const basisWord = basis === 'measured' ? 'measured cost' : basis === 'free' ? 'free tier · rate-capped' : basis === 'stale' ? 'modelled cost · stale pass rate' : 'modelled cost';
const bestSrc = best ? sourceFor(best.benchmark) : null;
const price = (n) => n === null || n === undefined ? null : `$${n.toFixed(3).replace(/0+$/, '').replace(/\.$/, '')}`;
const context = (n) => !n ? 'missing' : n >= 1_000_000 ? `${(n / 1_000_000).toFixed(n % 1_000_000 ? 1 : 0)}M` : `${(n / 1000).toFixed(0)}k`;
const mine = solvedFor(model.model_id, 'heavy');
// peers: same cost basis only, so the chart never ranks measured against modelled.
// The same Chart A component as the calculator, pinned on this model.
const PEER_TIER = 'heavy', PEER_VOLUME = 200;
const lb = leaderboard(PEER_TIER);
// Free-model coverage: a free_tier_capped row's peers are other free rows
// (lb.free), never lb.modelled — a free $0 row is not a modelled paid
// estimate, and mixing the two would silently rank a rate-capped price
// against an uncapped one on this very peer chart.
const pool = mine ? (mine.basisKey === 'measured_by_source' ? lb.measured : mine.basisKey === 'historical_at_run_date' ? lb.historical : mine.basisKey === 'free_tier_capped' ? lb.free : lb.modelled) : [];
const harnessOf = (r) => r.harness ?? undefined;
const peerRows: ChartRow[] = pool.map((x) => ({
  id: x.m.model_id, name: x.m.display_name, href: `/models/${x.m.model_id}`, cost: x.cost, pass: x.r.pass_rate,
  basis: BASIS_OF[x.basisKey] ?? 'modelled', harness: harnessOf(x.r), attempt: x.perTask ?? undefined,
  // Stage 2 consistency sweep: this row list never carried `provider`, so the
  // peers chart was the one ranked-bars table on the site with no logo chip
  // (direction doc §4: "model logo chips everywhere a model is named").
  provider: x.m.provider,
  compare: x.m.model_id === model.model_id ? undefined : pairHref(model.model_id, x.m.model_id, { tier: PEER_TIER, volume: PEER_VOLUME }),
}));
const peerBasis = peerRows[0]?.basis ?? 'modelled';
const peersWide = peerRows.length > 1 ? rankedBars(peerRows, { width: 1046, volume: PEER_VOLUME, basis: peerBasis, compact: false, highlight: model.model_id }) : '';
const peersNarrow = peerRows.length > 1 ? rankedBars(peerRows, { width: 350, volume: PEER_VOLUME, basis: peerBasis, compact: true, highlight: model.model_id }) : '';
// Head-to-head buttons only where the compare page actually exists: since
// the full-router catalog (2026-08-26), /compare/[pair] builds only pairs
// where BOTH sides carry a benchmark result — so a dataless model page
// offers no vs-buttons rather than 404 links.
const peers = bestResultFor(model.model_id)
  ? models.filter((m) => m.model_id !== model.model_id && m.status === 'current' && bestResultFor(m.model_id)).slice(0, 8)
  : [];
// Per-model stat card (scripts/og-cards.ts -> site/public/og/cards/model-<id>.png),
// generated only for current models; retired/preview models without a card
// fall back to the site's generic divergence chart card.
const modelCardPath = fileURLToPath(new URL(`../../../public/og/cards/model-${model.model_id}.png`, import.meta.url));
const ogCard = existsSync(modelCardPath) ? `/og/cards/model-${model.model_id}.png` : '/og/divergence-og.png';
---
<Base title={`${model.display_name} — pricing and cost per solved task — Solvency`}
      description={`${model.display_name} API pricing verified ${model.last_verified}: $${model.input_per_mtok}/M input, $${model.output_per_mtok}/M output${mine ? `, ${money(mine.cost)} per solved task (${measured ? 'measured' : 'modelled'})` : ', no published pass rate'}.`}
      og={ogCard}>
  <div class="wrap pt-8 md:pt-12">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">{model.provider}</p>
        <!-- Stage 2 (direction doc §4/§6: "model logo chips everywhere a
             model is named" · "model name in monospace"): the model page's
             own name is the one heading on the site that IS a model name, so
             it gets the chip + mono treatment the ranked-table rows already
             use, instead of the generic serif .h-page every other title
             (Models index, Compare picker, Harness) keeps. -->
        <h1 class="model-head mt-3"><LogoChip provider={model.provider} size={36} />{model.display_name}</h1>
        <p class="small mt-4">
          <span class={model.status === 'current' ? 'text-[var(--color-ink)]' : model.status === 'retired' ? 'line-through' : ''}>{model.status}</span>
          {' '}· {model.capability_class}
          {/* basisWord already says "free tier · rate-capped" when a pass rate exists
              (basis === 'free'); this badge only fills the gap for a free row with
              no pass rate at all (MISSING), where basisWord renders nothing. */}
          {model.access_tier === 'free' && basis !== 'free' && <>{' '}· <span class="t-free">FREE · rate-capped</span></>}
          {basis && <>{' '}· <span class={`t-${basis}`}>{basisWord}</span></>}
          {' '}· verified <span class="text-[var(--color-ink)]">{model.last_verified}</span>
        </p>
        {model.vendor_provider && model.vendor_provider !== model.provider && (
          <p class="small mt-1 text-[var(--color-muted)]">
            Served by {providerLabel(model.provider)}; weights by {providerLabel(model.vendor_provider)} — a different serving venue can mean different quantization, latency or rate limits than the vendor's own API.
          </p>
        )}
      </div>
      <div class="flex flex-wrap gap-2">
        <a href={`/?highlight=${model.model_id}`} class="btn">Run this model in the calculator</a>
        <a href={model.source_url} rel="noopener" class="btn">Provider pricing page ↗</a>
      </div>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="label">List price · USD per million tokens</p>
        <div class="tile-grid mt-2 grid-cols-2 sm:grid-cols-4">
          {[['Input', model.input_per_mtok], ['Output', model.output_per_mtok], ['Cached input', model.cached_input_per_mtok]].map(([label, v]) => (
            <div class="tile">
              <p class="label">{label}</p>
              <p class={`tile-v ${v === null ? 'missing' : ''}`}>{price(v) ?? 'missing'}</p>
            </div>))}
          <div class="tile">
            <p class="label">Context</p>
            <p class={`tile-v ${model.context_window ? '' : 'missing'}`}>{context(model.context_window)}</p>
          </div>
        </div>
        <Provenance source="Provider pricing page" href={model.source_url} verified={model.last_verified} />
        {model.access_tier === 'free' && (
          <div class="mt-5" id="rate-cap">
            <p class="label">Rate cap · free tier</p>
            <p class="mt-1 text-[var(--color-ink)]">{capsLabel(model.rate_caps)}</p>
            <Provenance source={model.rate_caps?.source_url ? 'Rate-limit source' : undefined}
              href={model.rate_caps?.source_url ?? undefined}
              verified={model.rate_caps?.last_verified ?? undefined}
              note={model.rate_caps?.source_url && !model.rate_caps?.last_verified
                ? 'Checked, but the page publishes no static rate-limit numbers — MISSING, not unlimited.'
                : !model.rate_caps?.source_url ? 'No rate-limit page found to cite — MISSING, not unlimited.' : undefined} />
          </div>
        )}
      </div>
      <div>
        <p class="label">Cost per solved task · by task tier</p>
        {best ? (
          <div class="tile-grid mt-2 grid-cols-3">
            {tierCosts.map((t) => (
              <div class="tile">
                <p class="label">{t.tier}</p>
                <p class={`tile-v ${t.value === null ? 'missing' : basis}`}>{t.value === null ? 'missing' : money(t.value)}</p>
              </div>))}
          </div>
        ) : (
          <div class="tile-grid mt-2 grid-cols-1"><div class="tile">
            <p class="tile-v missing">missing</p>
            <p class="tile-n">No published pass rate, so cost per solved task cannot be derived. Reported as missing rather than estimated.</p>
          </div></div>
        )}
        {best && (
          <Provenance source={bestSrc?.attribution} href={bestSrc?.attribution_url ?? best.source_url} verified={bestSrc?.last_verified ?? best.run_date}
            note={measured ? 'measured basis: the benchmark observed this cost, so no tier assumption touches it and the three tiers are identical' : 'modelled basis: pass rate published, cost from Solvency\'s loop model at current prices'} />
        )}
      </div>
    </div>

    {model.pricing_notes && (
      <p class="mt-6 text-sm text-[var(--color-body)] border-l-2 border-[var(--color-rule-strong)] pl-4 max-w-3xl">{model.pricing_notes}</p>
    )}

    <Section id="benchmarks" eyebrow="Benchmark rows" title="Where the pass rate comes from"
      caption="Every row that names this model, with its harness and cost basis. Rows are harness + model combinations, not properties of the bare model.">
      {harnessRows.length > 1 && <div slot="aside"><a class="btn" href="/harness">Compare harness costs</a></div>}
      {rows.length ? (
        <div class="card overflow-hidden"><div class="tbl-wrap"><table class="tbl">
          <caption>Benchmark rows naming {model.display_name}: benchmark, entry, pass rate, observed or usage-repriced attempt cost, cost basis and run date</caption>
          <thead><tr><th scope="col">Benchmark</th><th scope="col">Entry</th><th scope="col" class="r">Pass</th><th scope="col" class="r">$ / attempt</th><th scope="col">Basis</th><th scope="col">Run / read</th></tr></thead>
          <tbody>{rows.map((r) => {
            const attempt = attemptCostFor(r);
            return <tr>
              <td class="ink"><a href={r.source_url} rel="noopener">{sourceFor(r.benchmark)?.name ?? r.benchmark}</a></td>
              <td class="muted">{r.entry_label}</td>
              <td class="r">{(r.pass_rate * 100).toFixed(1)}%</td>
              <td class={`r ${attempt == null ? 'missing' : ''}`}>{attempt == null ? 'not published' : money(attempt)}</td>
              <td class={r.cost_basis === 'source_usage_repriced' ? 'ink' : 'muted'}>{r.cost_basis.replace(/_/g, ' ')}</td>
              <td class="muted">{r.run_date}</td>
            </tr>})}</tbody>
        </table></div></div>
      ) : <p class="text-[var(--color-muted)]">No benchmark covers this model. Reported as missing rather than estimated.</p>}
    </Section>

    {peerRows.length > 1 && (
      <Section id="peers" eyebrow={`${peerBasis} peers`} title="Cost per solved task against its peers"
        caption={peerBasis === 'measured' ? `Measured rows only, ranked as on the calculator. Monthly figures at ${PEER_VOLUME} tasks. Lower is better.`
          : peerBasis === 'free' ? `FREE · rate-capped rows only, ranked by pass rate — cost is uniformly $0 within this group, so it is not a useful sort key here.`
          : `${peerBasis === 'stale' ? 'Stale' : 'Modelled'} rows only, heavy tier, ${PEER_VOLUME} tasks a month. Lower is better. These are Solvency estimates, not observed costs.`}>
        <div class="card overflow-hidden">
          <div class="px-5 pt-4 pb-2">
            <p class="ghead"><span class={`gword t-${peerBasis}`}>{peerBasis}</span> · {peerBasis === 'measured' ? 'the benchmark ran the model and observed this cost' : peerBasis === 'free' ? 'zero-dollar access path with a provider-set rate cap' : 'pass rate published; cost is Solvency\'s loop model at verified prices'}</p>
            <div class="chart-slot mt-2 hidden sm:block" set:html={peersWide}></div>
            <div class="chart-slot mt-2 sm:hidden" set:html={peersNarrow}></div>
          </div>
        </div>
        <Provenance source={bestSrc?.attribution} href={bestSrc?.attribution_url ?? best.source_url} verified={bestSrc?.last_verified ?? best.run_date} />
      </Section>
    )}

    <Section id="compare" eyebrow="Compare" title="Head to head" caption="Side-by-side pricing and cost per solved task with another current model.">
      <div class="flex flex-wrap gap-2">
        {peers.map((p) => <a class="btn" href={pairPath(model.model_id, p.model_id)}>vs {p.display_name}</a>)}
      </div>
    </Section>
  </div>
</Base>
