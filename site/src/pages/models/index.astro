---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { models, bestResultFor } from '../../lib/data.ts';
const rows = models.slice().sort((a, b) => a.provider.localeCompare(b.provider) || a.display_name.localeCompare(b.display_name));
---
<Base title="Models — Solvency" description="Verified API pricing and cost per solved task for every model Solvency tracks.">
  <h1 class="font-mono text-3xl font-bold text-[var(--color-ink)]">Models</h1>
  <p class="mt-4 max-w-2xl">{models.length} models, each price verified against the provider's own pricing page on the date shown.</p>
  <div class="mt-10 overflow-x-auto">
    <table class="w-full font-mono text-[13px] tabular-nums">
      <thead><tr class="text-[10px] uppercase tracking-[0.14em] text-[var(--color-muted)] border-b border-[var(--color-accent)]">
        <th class="text-left py-2 pr-4">Model</th><th class="text-left px-4">Provider</th>
        <th class="text-right px-4">In $/M</th><th class="text-right px-4">Out $/M</th>
        <th class="text-right px-4">Pass</th><th class="text-left pl-4">Verified</th>
      </tr></thead>
      <tbody>
        {rows.map((m) => { const r = bestResultFor(m.model_id); return (
          <tr class="border-b border-[var(--color-rule)]">
            <td class="py-2.5 pr-4"><a class="text-[var(--color-ink)] hover:text-[var(--color-accent)]" href={`/models/${m.model_id}`}>{m.display_name}</a></td>
            <td class="px-4 text-[var(--color-muted)]">{m.provider}</td>
            <td class="px-4 text-right">${m.input_per_mtok.toFixed(2)}</td>
            <td class="px-4 text-right">${m.output_per_mtok.toFixed(2)}</td>
            <td class="px-4 text-right">{r ? `${(r.pass_rate * 100).toFixed(0)}%` : <span class="text-[var(--color-muted)]">missing</span>}</td>
            <td class="pl-4 text-[var(--color-muted)]">{m.last_verified}</td>
          </tr>); })}
      </tbody>
    </table>
  </div>
</Base>
