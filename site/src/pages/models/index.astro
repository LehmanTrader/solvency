---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import Provenance from '../../components/Provenance.astro';
import { models, bestResultFor, sourceFor } from '../../lib/data.ts';
import { solvedFor, money } from '../../lib/headline.ts';
const order = { current: 0, legacy: 1, retired: 2 };
const rows = models.slice().sort((a, b) => order[a.status] - order[b.status] || a.provider.localeCompare(b.provider) || a.display_name.localeCompare(b.display_name));
const verified = models.reduce((a, m) => (m.last_verified > a ? m.last_verified : a), '');
const price = (n) => n === null || n === undefined ? null : `$${n.toFixed(3).replace(/0+$/, '').replace(/\.$/, '')}`;
const nCurrent = models.filter((m) => m.status === 'current').length;
const nPass = models.filter((m) => bestResultFor(m.model_id)).length;
---
<Base title="Models — verified pricing and cost per solved task — Solvency" description={`Verified API pricing for ${models.length} AI coding models, with cost per solved task where a pass rate exists.`}>
  <div class="wrap pt-10">
    <p class="eyebrow">Models</p>
    <h1 class="h-page mt-3">Every model Solvency tracks</h1>
    <p class="lede mt-4 max-w-2xl">{models.length} models, {nCurrent} current. Each price is verified against the provider's own pricing page on the date shown. {nPass} have a published pass rate; the rest are shown as missing, never estimated.</p>

    <p class="small mt-8 mb-2 lg:hidden" id="models-table-scroll-help">Scroll horizontally to see every pricing field, cost basis and the Verified date.</p>
    <div class="card overflow-hidden">
      <div class="tbl-wrap tbl-scroll-region" role="region" tabindex="0" aria-labelledby="models-table-caption" aria-describedby="models-table-scroll-help" data-models-scroll><table class="tbl tbl-models">
        <caption id="models-table-caption">Every model Solvency tracks: verified pricing, pass rate, cost basis and cost per solved task at the heavy tier</caption>
        <colgroup>
          <col class="models-model" /><col class="models-provider" /><col class="models-status" />
          <col class="models-in" /><col class="models-out" /><col class="models-cached" />
          <col class="models-pass" /><col class="models-basis" /><col class="models-solved" /><col class="models-verified" />
        </colgroup>
        <thead><tr>
          <th scope="col">Model</th><th scope="col">Provider</th><th scope="col">Status</th>
          <th scope="col" class="r">In $/M</th><th scope="col" class="r">Out $/M</th><th scope="col" class="r">Cached $/M</th>
          <th scope="col" class="r">Pass</th><th scope="col">Basis</th><th scope="col" class="r">$ / solved (heavy)</th><th scope="col">Verified</th>
        </tr></thead>
        <tbody>
          {rows.map((m) => { const r = bestResultFor(m.model_id); const s = solvedFor(m.model_id, 'heavy'); return (
            <tr>
              <td class="ink"><a href={`/models/${m.model_id}`}>{m.display_name}</a></td>
              <td class="muted">{m.provider}</td>
              <td><Badge status={m.status}>{m.status}</Badge></td>
              <td class="r">{price(m.input_per_mtok)}</td>
              <td class="r">{price(m.output_per_mtok)}</td>
              <td class={`r ${m.cached_input_per_mtok === null ? 'missing' : ''}`}>{price(m.cached_input_per_mtok) ?? 'missing'}</td>
              <td class={`r ${r ? '' : 'missing'}`}>{r ? `${Math.round(r.pass_rate * 100)}%` : 'missing'}</td>
              <td class="muted">{r ? (r.cost_basis === 'measured_by_source' ? 'measured' : r.cost_basis === 'historical_at_run_date' ? 'modelled · stale' : 'modelled') : '—'}</td>
              <td class={`r ${s ? (s.basisKey === 'measured_by_source' ? 'measured' : s.basisKey === 'historical_at_run_date' ? 'stale' : 'modelled') : 'missing'}`}>{s ? money(s.cost) : 'missing'}</td>
              <td class="muted">{m.last_verified}</td>
            </tr>); })}
        </tbody>
      </table></div>
    </div>
    <Provenance verified={verified} note="Measured and modelled figures in the last column are on different bases and must not be ranked against each other; see the leaderboard for the separated ranking." />
  </div>
</Base>

<script>
  const scrollRegion = document.querySelector<HTMLElement>('[data-models-scroll]');

  scrollRegion?.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    if (scrollRegion.scrollWidth <= scrollRegion.clientWidth) return;

    event.preventDefault();
    scrollRegion.scrollBy({
      left: event.key === 'ArrowRight' ? 80 : -80,
    });
  });
</script>
