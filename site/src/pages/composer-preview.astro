  function chartHtml(current: ComposerPlan, quote: BuildQuoteV1 | null, issues: string[]): string {
    const quoteByRole = new Map((quote?.roles ?? []).map((r) => [r.roleId, r]));
    const total = quote && quote.valid ? quote.buildAttemptCostUsd : null;
    const { orchestrators, byParent, parentOrder } = groupsFor(current);
    const locked = current.roles.length >= DEMO_ROLE_CEILING;
    const issuesHtml = issues.length ? `<div class="cp-issues">${issues.map((m) => esc(m)).join(' ')}</div>` : '';
    const groupsHtml = parentOrder.map((key, i) => groupHtml(key, orchestrators, byParent.get(key)!, quoteByRole, total, locked && i === parentOrder.length - 1)).join('');
    return `${issuesHtml}<div class="cp-tree">${groupsHtml}</div>`;
  }

  // ---------- paint: count-tween totals, delta chips ----------

  let displayedNum: { attempt: number | null; solved: number | null; month: number | null } = { attempt: null, solved: null, month: null };
  let previousQuote: BuildQuoteV1 | null = null;
  let firstStripRender = true;

  function tweenTo(el: HTMLElement, from: number | null, to: number | null, fmt: (n: number | null) => string) {
    if (from === null || to === null || from === to || prefersReducedMotion()) {
      el.textContent = fmt(to);
      return;
    }
    const duration = 200;
    const start = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - start) / duration);
      const eased = 1 - (1 - t) * (1 - t);
      el.textContent = fmt(from + (to - from) * eased);
      if (t < 1) requestAnimationFrame(step);
      else el.textContent = fmt(to);
    };
    requestAnimationFrame(step);
  }

  function updateStrip(quote: BuildQuoteV1 | null) {
    const valid = Boolean(quote && quote.valid);
    const values: Record<'attempt' | 'solved' | 'month', number | null> = {
      attempt: valid ? quote!.buildAttemptCostUsd : null,
      solved: valid ? quote!.variableCostPerSuccessfulBuildUsd : null,
      month: valid ? quote!.monthlyCostUsd : null,
    };
    (['attempt', 'solved', 'month'] as const).forEach((key) => {
      const el = document.getElementById(`cp-strip-${key}`)!;
      const to = values[key];
      if (firstStripRender) el.textContent = money(to);
      else tweenTo(el, displayedNum[key], to, money);
      displayedNum[key] = to;

      const deltaEl = document.getElementById(`cp-delta-${key}`)!;
      if (previousQuote && previousQuote.valid && valid) {
        const from = key === 'attempt' ? previousQuote.buildAttemptCostUsd
          : key === 'solved' ? previousQuote.variableCostPerSuccessfulBuildUsd
          : previousQuote.monthlyCostUsd;
        if (from !== null && to !== null && Math.abs(to - from) > 1e-9) {
          const lower = to < from;
          deltaEl.textContent = `${lower ? '↓' : '↑'} ${money(Math.abs(to - from))} vs last edit`;
          deltaEl.dataset.direction = lower ? 'lower' : 'higher';
          el.dataset.flash = lower ? 'lower' : 'higher';
          window.setTimeout(() => { el.removeAttribute('data-flash'); }, 1500);
        }
      }
    });
    firstStripRender = false;
    if (valid) previousQuote = quote;
  }

  // ---------- paint: sensitivity band ----------

  function bandRowHtml(label: string, low: number | null, base: number | null, high: number | null): string {
    if (low === null || high === null || base === null) {
      return `<div class="cp-band-row"><span class="cp-band-label">${esc(label)}</span><span class="small">Missing</span></div>`;
    }
    const lo = Math.min(low, high);
    const hi = Math.max(low, high);
    const span = hi - lo || 1;
    const pct = Math.min(100, Math.max(0, ((base - lo) / span) * 100));
    return `<div class="cp-band-row">
      <span class="cp-band-label">${esc(label)}</span>
      <div class="cp-band-track">
        <span class="cp-band-low num">${money(low)}</span>
        <div class="cp-band-visual"><div class="cp-band-fill"></div><div class="cp-band-tick" style="left:${pct}%"></div></div>
        <span class="cp-band-high num">${money(high)}</span>
      </div>
    </div>`;
  }

  function updateSensitivity(validPlan: ComposerPlan | null) {
    const statusEl = document.getElementById('cp-sens-status')!;
    const bandsEl = document.getElementById('cp-sens-bands')!;
    if (!validPlan) {
      statusEl.textContent = plan.roles.length === 0 ? 'Add a role to see sensitivity.' : 'Fix the current plan before sensitivity can be calculated.';
      bandsEl.innerHTML = '';
      return;
    }
    const axis = (document.getElementById('cp-sens-axis') as HTMLSelectElement).value as SensitivityAxis;
    const rangePercent = Number((document.getElementById('cp-sens-range') as HTMLInputElement).value);
    if (!Number.isFinite(rangePercent) || rangePercent < 5 || rangePercent > 90) {
      statusEl.textContent = 'Range must be between 5% and 90%.';
      bandsEl.innerHTML = '';
      return;
    }
    let sensitivity;
    try {
      sensitivity = analyzeBuildSensitivity(toEnginePlan(validPlan), eligibleModels, axis, rangePercent / 100);
    } catch (error) {
      statusEl.textContent = error instanceof Error ? error.message : 'Sensitivity is unavailable.';
      bandsEl.innerHTML = '';
      return;
    }
    if (!sensitivity.available) {
      statusEl.textContent = sensitivity.missingReason ?? 'Sensitivity is unavailable for this plan.';
      bandsEl.innerHTML = '';
      return;
    }
    statusEl.textContent = sensitivity.assumption;
    bandsEl.innerHTML = [
      bandRowHtml('Per attempt', sensitivity.low?.buildAttemptCostUsd ?? null, sensitivity.base.buildAttemptCostUsd, sensitivity.high?.buildAttemptCostUsd ?? null),
      bandRowHtml('Per completed', sensitivity.low?.variableCostPerSuccessfulBuildUsd ?? null, sensitivity.base.variableCostPerSuccessfulBuildUsd, sensitivity.high?.variableCostPerSuccessfulBuildUsd ?? null),
      bandRowHtml('Monthly', sensitivity.low?.monthlyCostUsd ?? null, sensitivity.base.monthlyCostUsd, sensitivity.high?.monthlyCostUsd ?? null),
    ].join('');
  }

  function updateExportButtons(quote: BuildQuoteV1 | null) {
    const ok = Boolean(quote && quote.valid);
    (document.getElementById('cp-export-json') as HTMLButtonElement).disabled = !ok;
    (document.getElementById('cp-export-csv') as HTMLButtonElement).disabled = !ok;
    (document.getElementById('cp-export-png') as HTMLButtonElement).disabled = !ok;
  }

  /**
   * Break-even (composer-concept-interaction.md §5, last bullet): a single-
   * line secondary readout beneath the sensitivity band, unchanged substance
   * from build-planner.astro's `breakEvenBuildPlans`. Needs a saved
   * comparison baseline — "Save baseline" is a Pro control here exactly as
   * `#b-save-version` is on build-planner (see DEMO_LOCKED), so the default,
   * gated state is the same one production shows a signed-out visitor.
   */
  function updateBreakEven(validPlan: ComposerPlan | null, quote: BuildQuoteV1 | null) {
    const headline = document.getElementById('cp-break-even')!;
    const detail = document.getElementById('cp-break-even-detail')!;
    if (!validPlan || !quote || !quote.valid) {
      headline.textContent = 'Break-even is unavailable while the current plan is invalid.';
      detail.textContent = 'Resolve the current plan errors to compare this plan with a saved baseline.';
      return;
    }
    if (!baselineSnapshot) {
      headline.textContent = 'Save a version to calculate break-even.';
      detail.textContent = "Break-even uses a common attempted-build volume: per-attempt role and harness cost × volume, plus each plan's fixed monthly cost. It does not infer success.";
      return;
    }
    const result = breakEvenBuildPlans(toEnginePlan(validPlan), toEnginePlan(baselineSnapshot.plan), eligibleModels);
    const currentName = 'Current stack';
    const baselineName = baselineSnapshot.label;
    if (result.kind === 'crosses') {
      const volume = result.attemptedBuildsPerMonth!.toLocaleString(undefined, { maximumFractionDigits: 1 });
      const below = result.lowerBelow === 'current' ? currentName : baselineName;
      const above = result.lowerAbove === 'current' ? currentName : baselineName;
      headline.textContent = `Break-even: monthly costs match at ${volume} attempted builds.`;
      detail.textContent = `Below that volume, ${below} costs less; above it, ${above} costs less.`;
    } else if (result.kind === 'current_always_lower') {
      headline.textContent = `${currentName} costs less than ${baselineName} at every positive attempted-build volume.`;
      detail.textContent = 'No positive crossing exists. This comparison does not infer or use a success rate.';
    } else if (result.kind === 'baseline_always_lower') {
      headline.textContent = `${baselineName} costs less than ${currentName} at every positive attempted-build volume.`;
      detail.textContent = 'No positive crossing exists. This comparison does not infer or use a success rate.';
    } else if (result.kind === 'equal_all_volumes') {
      headline.textContent = `${currentName} and ${baselineName} cost the same at every volume.`;
      detail.textContent = 'Per-attempt cost and fixed monthly cost are identical between the two plans.';
    } else {
      headline.textContent = 'Break-even is unavailable for this comparison.';
      detail.textContent = result.reason ?? 'Both plans need valid per-attempt quotes.';
    }
  }

  // ---------- render: the one repaint of the one authority ----------

  let renderScheduled = false;
  function scheduleRender() {
    if (renderScheduled) return;
    renderScheduled = true;
    requestAnimationFrame(() => { renderScheduled = false; render(); });
  }

  function render() {
    const chartEl = document.getElementById('cp-chart')!;
    document.getElementById('cp-role-count')!.textContent = `${plan.roles.length} role${plan.roles.length === 1 ? '' : 's'}`;

    if (plan.roles.length === 0) {
      chartEl.innerHTML = emptyStateHtml();
      updateStrip(null);
      updateSensitivity(null);
      updateExportButtons(null);
      updateBreakEven(null, null);
      return;
    }

    const result = validateUntrustedBuildPlanV1(toEnginePlan(plan), eligibleModels);
    const quote = result.ok ? result.quote : null;
    const issues = result.ok ? (quote!.valid ? [] : quote!.errors) : result.issues.map((i) => i.message);
    chartEl.innerHTML = chartHtml(plan, quote, issues);

    if (lastChangedRoleId) {
      const node = chartEl.querySelector<HTMLElement>(`[data-role-id="${lastChangedRoleId}"]`);
      if (node) {
        if (prefersReducedMotion()) {
          const dot = document.createElement('span');
          dot.className = 'cp-node-changed-dot';
          dot.setAttribute('aria-hidden', 'true');
          node.querySelector('.cp-build-cost')?.appendChild(dot);
          window.setTimeout(() => dot.remove(), 1000);
        } else {
          node.dataset.justChanged = 'true';
          window.setTimeout(() => { if (node.isConnected) node.dataset.justChanged = 'false'; }, 320);
        }
      }
      lastChangedRoleId = null;
    }

    updateStrip(quote);
    const validPlan = result.ok && result.quote.valid ? plan : null;
    updateSensitivity(validPlan);
    updateExportButtons(quote);
    updateBreakEven(validPlan, quote);
  }

  // ---------- exports (reuse the untouched export lib, unchanged) ----------

  function downloadBlob(blob: Blob, filename: string) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.hidden = true;
    document.body.appendChild(a);
    a.click();
    a.remove();
    window.setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  const cleanCanvasText = (text: string) => text.replace(/[\u0000-\u001f\u007f-\u009f]/g, ' ').replace(/\s+/g, ' ').trim();
  function fitCanvasText(ctx: CanvasRenderingContext2D, text: string, maxWidth: number): string {
    const clean = cleanCanvasText(text);
    if (ctx.measureText(clean).width <= maxWidth) return clean;
    let result = clean;
    while (result.length && ctx.measureText(`${result}…`).width > maxWidth) result = result.slice(0, -1);
    return `${result}…`;
  }

  /**
   * PNG export (composer-concept-architecture.md §5a — "extend the same
   * hand-drawn canvas approach"): a bounded, deterministic Canvas 2D render
   * from `plan`/`quote` data only, never a DOM screenshot — same discipline
   * and light-theme hex literals as build-planner.astro's `buildPngBlob`,
   * extended to draw the chart's node boxes and connector lines instead of
   * a role table. Simple geometric rendering: a quote artifact, not a photo
   * of the chart.
   */
  async function buildComposerPngBlob(current: ComposerPlan, validatedPlan: Parameters<typeof buildExportSummary>[0], quote: BuildQuoteV1): Promise<Blob> {
    // `assertExportable()` inside buildExportSummary requires byte-for-byte
    // equality with the plan the quote was actually derived from — that's
    // `validatedPlan` (result.value, re-parsed by the schema), never the
    // hand-built `current` object, even though they're semantically
    // identical (same subtlety exportCurrent's json/csv path already
    // handles). `current` (with its parentRoleId chart-position hints) is
    // used below only for tree layout, never passed into the export lib.
    const summary = buildExportSummary(validatedPlan, quote);
    const { orchestrators, byParent, parentOrder } = groupsFor(current);
    const quoteByRole = new Map(quote.roles.map((r) => [r.roleId, r]));
    const width = 1200;
    const NODE_W = 260, NODE_H = 76, GAP_X = 28, GROUP_GAP_Y = 130;
    const rowsPerGroup = parentOrder.map((key) => {
      const group = byParent.get(key)!;
      return 1 + (group.workers.length > 0 ? 1 : 0) + (group.fallbacks.length > 0 ? 1 : 0);
    });
    const chartTop = 366;
    const chartHeight = parentOrder.length * GROUP_GAP_Y + Math.max(...rowsPerGroup, 1) * 30 + 80;
    const height = Math.min(2400, chartTop + chartHeight + 120);
    const canvas = document.createElement('canvas'); canvas.width = width; canvas.height = height;
    const ctx = canvas.getContext('2d'); if (!ctx) throw new Error('PNG rendering is unavailable in this browser.');
    const CARD_BG = '#F8F6EE', CARD_PANEL_2 = '#F4F3F1', CARD_RULE = '#CFCCC6', CARD_RULE_2 = '#E2E0DC';
    const CARD_INK = '#1A1D20', CARD_BODY = '#3E464C', CARD_MUTED = '#5F6B73', CARD_MISSING = '#5F6B73', CARD_AMBER = '#9A6410', CARD_PURPLE = '#6C3BF4';
    ctx.fillStyle = CARD_BG; ctx.fillRect(0, 0, width, height);
    ctx.strokeStyle = CARD_RULE; ctx.lineWidth = 2; ctx.strokeRect(48, 48, width - 96, height - 96);
    ctx.fillStyle = CARD_AMBER; ctx.fillRect(72, 74, 7, 28);
    ctx.fillStyle = CARD_INK; ctx.font = '700 22px ui-monospace, monospace'; ctx.fillText('SOLVENCY · BUILD QUOTE', 96, 98);
    ctx.fillStyle = CARD_MUTED; ctx.font = '16px ui-monospace, monospace'; ctx.fillText(`Generated ${new Date(summary.quotedAt).toISOString()} · ${summary.engineVersion}`, 72, 132);
    ctx.fillStyle = CARD_INK; ctx.font = '700 38px system-ui, sans-serif'; ctx.fillText(fitCanvasText(ctx, summary.planName, 1056), 72, 188);
    ctx.fillStyle = CARD_MUTED; ctx.font = '18px ui-monospace, monospace'; ctx.fillText(fitCanvasText(ctx, `Harness: ${summary.harness}`, 1056), 72, 222);

    summary.metrics.slice(0, 3).forEach((metric, index) => {
      const x = 72 + index * 356, y = 250;
      ctx.fillStyle = CARD_PANEL_2; ctx.fillRect(x, y, 336, 76); ctx.strokeStyle = CARD_RULE_2; ctx.strokeRect(x, y, 336, 76);
      ctx.fillStyle = CARD_MUTED; ctx.font = '13px ui-monospace, monospace'; ctx.fillText(metric.label.toUpperCase(), x + 16, y + 24);
      ctx.fillStyle = metric.value.startsWith('Missing') ? CARD_MISSING : CARD_INK; ctx.font = '700 21px ui-monospace, monospace'; ctx.fillText(fitCanvasText(ctx, metric.value, 300), x + 16, y + 54);
    });

    function drawNode(cx: number, cy: number, roleId: string, kind: string, label: string) {
      const x = cx - NODE_W / 2, y = cy;
      ctx!.fillStyle = CARD_BG; ctx!.strokeStyle = kind === 'other' ? CARD_MUTED : CARD_RULE_2; ctx!.lineWidth = 1;
      if (kind === 'other') ctx!.setLineDash([5, 4]); else ctx!.setLineDash([]);
      ctx!.fillRect(x, y, NODE_W, NODE_H); ctx!.strokeRect(x, y, NODE_W, NODE_H);
      ctx!.setLineDash([]);
      const roleQuote = quoteByRole.get(roleId);
      ctx!.fillStyle = CARD_MUTED; ctx!.font = '11px ui-monospace, monospace';
      ctx!.fillText(kind === 'orchestrator' ? 'ORCHESTRATOR' : kind === 'worker' ? 'WORKER' : 'FALLBACK', x + 14, y + 20);
      ctx!.fillStyle = CARD_INK; ctx!.font = '700 16px system-ui, sans-serif'; ctx!.fillText(fitCanvasText(ctx!, label, NODE_W - 28), x + 14, y + 42);
      ctx!.fillStyle = roleQuote ? CARD_INK : CARD_MISSING; ctx!.font = '13px ui-monospace, monospace';
      ctx!.fillText(roleQuote ? `${money(roleQuote.costPerBuildAttemptUsd)}/build` : 'Missing', x + 14, y + 62);
      return { x, y, w: NODE_W, h: NODE_H };
    }

    let groupY = chartTop;
    parentOrder.forEach((key) => {
      const anchor = key === TRUNK_STUB_KEY ? null : orchestrators.find((o) => o.roleId === key) ?? null;
      const group = byParent.get(key)!;
      const trunkCx = width / 2;
      const trunkBox = anchor
        ? drawNode(trunkCx, groupY, anchor.roleId, 'orchestrator', anchor.label)
        : (() => {
            ctx.strokeStyle = CARD_RULE_2; ctx.setLineDash([5, 4]);
            ctx.strokeRect(trunkCx - NODE_W / 2, groupY, NODE_W, NODE_H); ctx.setLineDash([]);
            ctx.fillStyle = CARD_MUTED; ctx.font = '13px ui-monospace, monospace';
            ctx.fillText('No orchestrator added', trunkCx - NODE_W / 2 + 14, groupY + 42);
            return { x: trunkCx - NODE_W / 2, y: groupY, w: NODE_W, h: NODE_H };
          })();
      const children = [...group.workers, ...group.fallbacks];
      if (children.length) {
        const rowY = groupY + NODE_H + 54;
        const totalW = children.length * NODE_W + (children.length - 1) * GAP_X;
        let cx = trunkCx - totalW / 2 + NODE_W / 2;
        for (const child of children) {
          ctx.strokeStyle = CARD_RULE_2; ctx.setLineDash(child.kind === 'other' ? [4, 4] : []);
          ctx.beginPath(); ctx.moveTo(trunkBox.x + trunkBox.w / 2, trunkBox.y + trunkBox.h); ctx.lineTo(cx, rowY); ctx.stroke(); ctx.setLineDash([]);
          drawNode(cx, rowY, child.roleId, child.kind, child.label);
          cx += NODE_W + GAP_X;
        }
        groupY = rowY + NODE_H + GROUP_GAP_Y - NODE_H - 54;
      } else {
        groupY += GROUP_GAP_Y;
      }
    });

    ctx.fillStyle = CARD_PURPLE;
    const footerY = height - 72;
    ctx.font = '13px system-ui, sans-serif';
    let y = footerY;
    for (const notice of summary.notices.slice(0, 1)) {
      ctx.fillStyle = CARD_MUTED;
      ctx.fillText(fitCanvasText(ctx, notice, 1056), 72, y); y += 20;
    }
    return await new Promise<Blob>((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Could not encode the PNG file.')), 'image/png'));
  }

  async function exportCurrent(format: 'json' | 'csv' | 'png') {
    if (plan.roles.length === 0) return;
    if (DEMO_LOCKED && format === 'png') { showGate(GATE_EXPORT_PNG); return; }
    const result = validateUntrustedBuildPlanV1(toEnginePlan(plan), eligibleModels);
    if (!result.ok || !result.quote.valid) return;
    // assertExportable() requires byte-for-byte equality with the plan the
    // quote was actually derived from — that's result.value (re-parsed by
    // the schema), not the hand-built plan passed in, even though the two
    // are semantically identical.
    if (format === 'png') {
      const blob = await buildComposerPngBlob(plan, result.value, result.quote);
      downloadBlob(blob, buildExportFilename(plan.name, 'png'));
      return;
    }
    const text = format === 'json' ? buildExportJson(result.value, result.quote) : buildExportCsv(result.value, result.quote);
    const blob = new Blob([text], { type: format === 'json' ? 'application/json' : 'text/csv' });
    downloadBlob(blob, buildExportFilename(plan.name, format));
  }

  /**
   * Save baseline (composer-concept-interaction.md §5, break-even). A Pro
   * control — same gating as `#b-save-version` on build-planner.astro (see
   * DEMO_LOCKED) — that captures the current valid plan as the tab-local
   * comparison point `breakEvenBuildPlans` reads against.
   */
  function saveBaseline() {
    if (DEMO_LOCKED) { showGate(GATE_SAVE_BASELINE); return; }
    const result = validateUntrustedBuildPlanV1(toEnginePlan(plan), eligibleModels);
    if (!result.ok || !result.quote.valid) return;
    baselineSnapshot = { plan: structuredClone(plan), label: `${plan.name} (saved)` };
    setStatus(`Baseline saved: ${plan.name}.`);
    scheduleRender();
  }

  // ---------- gate toast + status line ----------

  function showGate(detail: string) {
    document.getElementById('cp-demo-gate-detail')!.textContent = detail;
    (document.getElementById('cp-demo-gate') as HTMLElement).hidden = false;
  }

  function setStatus(text: string) {
    document.getElementById('cp-status')!.textContent = text;
  }

  // ---------- popovers (kebab menus, model picker, export menu) ----------

  function closeAllPopovers() {
    document.querySelectorAll<HTMLElement>('[data-popover]:not([hidden])').forEach((popover) => {
      popover.hidden = true;
      const id = popover.getAttribute('data-popover');
      const toggle = document.querySelector(`[data-popover-toggle="${id}"]`);
      toggle?.setAttribute('aria-expanded', 'false');
    });
  }

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = document.querySelector<HTMLElement>('[data-popover]:not([hidden])');
    if (!open) return;
    const id = open.getAttribute('data-popover');
    closeAllPopovers();
    document.querySelector<HTMLElement>(`[data-popover-toggle="${id}"]`)?.focus();
  });

  // ---------- click delegation (chart is fully rebuilt each render, so
  // listeners live on document rather than being re-attached per node) ----------

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    const toggle = target.closest<HTMLElement>('[data-popover-toggle]');
    if (toggle) {
      event.stopPropagation();
      const id = toggle.dataset.popoverToggle!;
      const popover = document.querySelector<HTMLElement>(`[data-popover="${id}"]`);
      if (popover) {
        const willOpen = popover.hidden;
        closeAllPopovers();
        popover.hidden = !willOpen;
        toggle.setAttribute('aria-expanded', String(willOpen));
      }
      return;
    }
    const action = target.closest<HTMLElement>('[data-action]');
    if (action) {
      const kind = action.dataset.action;
      const roleId = action.dataset.roleId ?? '';
      if (kind === 'remove') removeRole(roleId);
      else if (kind === 'model-pick') pickModel(roleId, action.dataset.modelId ?? '');
      else if (kind === 'ghost-add') showGate(GATE_ADD_ROLE);
      else if (kind === 'add-orchestrator') addRole('orchestrator');
      else if (kind === 'add-worker') addRole('worker');
      else if (kind === 'add-fallback') addRole('other');
      else if (kind === 'preset') applyPreset(action.dataset.preset ?? '');
      else if (kind === 'export-json') void exportCurrent('json');
      else if (kind === 'export-csv') void exportCurrent('csv');
      else if (kind === 'export-png') void exportCurrent('png');
      else if (kind === 'toggle-details') toggleDetails(roleId);
      else if (kind === 'gate-custom') gateCustomPricing();
      else if (kind === 'save-baseline') saveBaseline();
      else if (kind === 'dismiss-gate') (document.getElementById('cp-demo-gate') as HTMLElement).hidden = true;
      closeAllPopovers();
      return;
    }
    if (!target.closest('[data-popover]')) closeAllPopovers();
  });

  document.addEventListener('change', (event) => {
    const el = event.target as HTMLElement;
    if (el.matches('[data-field="label"]')) setLabel(el.dataset.roleId!, (el as HTMLInputElement).value);
    else if (el.matches('[data-field="calls"]')) setCalls(el.dataset.roleId!, (el as HTMLInputElement).value);
    else if (el.matches('[data-field="usage-basis"]')) setUsageBasis(el.dataset.roleId!, (el as HTMLSelectElement).value);
    else if (el.matches('[data-field="fresh"]')) setUsageTokens(el.dataset.roleId!, 'uncachedInputTokens', (el as HTMLInputElement).value);
    else if (el.matches('[data-field="cache"]')) setUsageTokens(el.dataset.roleId!, 'cacheReadTokens', (el as HTMLInputElement).value);
    else if (el.matches('[data-field="output"]')) setUsageTokens(el.dataset.roleId!, 'outputTokens', (el as HTMLInputElement).value);
    else if (el.matches('[data-action="move-to"]')) setParent(el.dataset.roleId!, (el as HTMLSelectElement).value || null);
    else if (el.id === 'cp-sens-axis' || el.id === 'cp-sens-range') scheduleRender();
    else if (el.id === 'cp-name') setPlanName((el as HTMLInputElement).value);
    else if (el.id === 'cp-harness') setHarnessName((el as HTMLInputElement).value);
    else if (el.id === 'cp-version') setHarnessVersion((el as HTMLInputElement).value);
    else if (el.id === 'cp-harness-basis') setHarnessBasis((el as HTMLSelectElement).value);
    else if (el.id === 'cp-volume') setVolume((el as HTMLInputElement).value);
    else if (el.id === 'cp-volume-basis') setVolumeBasis((el as HTMLSelectElement).value);
    else if (el.id === 'cp-overhead') setOverhead((el as HTMLInputElement).value);
    else if (el.id === 'cp-fixed') setFixed((el as HTMLInputElement).value);
    else if (el.id === 'cp-success') setSuccess((el as HTMLInputElement).value);
    else if (el.id === 'cp-success-basis') setSuccessBasis((el as HTMLSelectElement).value);
  });

  // ---------- hover / focus cross-highlight: node <-> sensitivity band ----------

  function setHover(node: HTMLElement, on: boolean) {
    node.dataset.hovered = on ? 'true' : 'false';
    const bandsEl = document.getElementById('cp-sens-bands')!;
    const axis = (document.getElementById('cp-sens-axis') as HTMLSelectElement).value;
    const relevant = axis !== 'system_success';
    bandsEl.dataset.linked = (on && relevant) ? 'true' : 'false';
  }

  document.addEventListener('mouseover', (event) => {
    const node = (event.target as Element).closest<HTMLElement>('.cp-node[data-role-id]');
    if (node && node.dataset.hovered !== 'true') setHover(node, true);
  });
  document.addEventListener('mouseout', (event) => {
    const node = (event.target as Element).closest<HTMLElement>('.cp-node[data-role-id]');
    if (node && !node.contains(event.relatedTarget as Node)) setHover(node, false);
  });
  document.addEventListener('focusin', (event) => {
    const node = (event.target as Element).closest<HTMLElement>('.cp-node[data-role-id]');
    if (node) setHover(node, true);
  });
  document.addEventListener('focusout', (event) => {
    const node = (event.target as Element).closest<HTMLElement>('.cp-node[data-role-id]');
    if (node && !node.contains(event.relatedTarget as Node)) setHover(node, false);
  });

  // Static (non-chart) Pro-gated controls carry the same lock glyph the
  // gated nodes/rows use, per composer-concept-interaction.md §7's
  // "visible-but-gated" rule — set once since DEMO_LOCKED never changes in
  // this local-parity build (no live entitlement to flip it).
  if (DEMO_LOCKED) {
    document.getElementById('cp-export-png')?.querySelector('.cp-lock')?.removeAttribute('hidden');
    document.getElementById('cp-save-baseline')?.querySelector('.cp-lock')?.removeAttribute('hidden');
  }

  render();
</script>

