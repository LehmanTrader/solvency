---
import '../styles/global.css';
import { CF_BEACON_TOKEN } from '../lib/site-config.ts';
import Logo from '../components/Logo.astro';
import { CLERK_ENABLED, CLERK_PUBLISHABLE_KEY, CLERK_FRONTEND_API } from '../lib/clerk.ts';
import { models, sources } from '../lib/data.ts';
interface Props {
  title: string;
  description: string;
  og?: string;
  /** Open Graph type: "website" for index pages, "article" for notes. */
  type?: 'website' | 'article';
}
const { title, description, og = '/og/divergence-og.png', type = 'website' } = Astro.props;
const site = Astro.site!;
const url = new URL(Astro.url.pathname, site).href;
const image = new URL(og, site).href;
const path = Astro.url.pathname;
const NAV = [
  ['/', 'Calculator'], ['/build-planner', 'Build'], ['/models', 'Models'], ['/compare', 'Compare'],
  ['/harness', 'Harness'], ['/methodology', 'Methodology'], ['/research', 'Research'],
];
const DEV = [['/data', 'Data (CC-BY)'], ['/embed', 'Embed'], ['/changelog', 'Changelog'],
  ['https://github.com/LehmanTrader/solvency', 'Source and tests']];
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const verified = models.reduce((a, m) => (m.last_verified > a ? m.last_verified : a), '');
const aa = sources.find((s) => s.benchmark === 'aa-coding-agent-index');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta name="theme-color" id="theme-color" content="#0A0C0D" />
  <script is:inline>(function(){try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="Solvency" />
  <meta property="og:url" content={url} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="2400" />
  <meta property="og:image:height" content="1260" />
  <meta property="og:image:alt" content="Chart: cost per solved task for AI coding models" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:image:alt" content="Chart: cost per solved task for AI coding models" />
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <!-- self-hosted fonts (site/public/fonts); the two above-the-fold faces are preloaded -->
  <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="sitemap" href="/sitemap-index.xml" />
  {CLERK_ENABLED && (
    <script async crossorigin="anonymous"
            data-clerk-publishable-key={CLERK_PUBLISHABLE_KEY}
            src={`https://${CLERK_FRONTEND_API}/npm/@clerk/clerk-js@5/dist/clerk.browser.js`}
            onload="window.Clerk.load({localization:{signUp:{start:{title:'Create your free Solvency account',subtitle:'Tune assumptions, keep scenario links and save Build Composer plans when available — free.'}},signIn:{start:{title:'Sign in to Solvency',subtitle:'Continue with your free account.'}}}}).then(()=>document.dispatchEvent(new Event('clerk:ready')))"></script>
  )}
  {CF_BEACON_TOKEN && (
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}></script>
  )}
</head>
<body class="min-h-screen flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 btn">Skip to content</a>
  <header class="sticky top-0 z-40 border-b border-[var(--color-rule)] bg-[color-mix(in_srgb,var(--color-bg)_90%,transparent)] backdrop-blur">
    <div class="wrap min-h-14 flex flex-wrap sm:flex-nowrap items-center gap-x-3 sm:gap-x-5">
      <a href="/" class="lockup site-header-lockup shrink-0 py-2" aria-label="Solvency home"><Logo size={20} /><span class="wordmark"><b>S</b>OLVENCY</span></a>
      <nav aria-label="Primary" class="order-last basis-full sm:order-none sm:basis-0 flex-1 min-w-0 border-t border-[var(--color-rule)] sm:border-0 -mx-5 px-5 sm:mx-0 sm:px-0">
        <ul id="nav-list" class="nav-scroll flex items-stretch gap-0.5 -mx-1 px-1 h-11 sm:h-14">
          {NAV.map(([href, name]) => (
            <li class="flex items-stretch"><a href={href} class="nav-a" aria-current={current(href) ? 'page' : undefined}>{name}</a></li>
          ))}
        </ul>
      </nav>
      <button type="button" id="theme-toggle" class="theme-btn shrink-0 ml-auto sm:ml-0" aria-label="Light theme" aria-pressed="false" title="Toggle theme">
        <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="i-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <script is:inline>(function(){var b=document.getElementById('theme-toggle'),r=document.documentElement;function cur(){return r.getAttribute('data-theme')||'dark';}function state(){var l=cur()==='light';b.setAttribute('aria-pressed',l?'true':'false');var m=document.getElementById('theme-color');if(m)m.setAttribute('content',l?'#FBFAF8':'#0A0C0D');}b.addEventListener('click',function(){var next=cur()==='light'?'dark':'light';r.setAttribute('data-theme',next);try{localStorage.setItem('theme',next);}catch(e){}state();});state();
      var n=document.getElementById('nav-list'),c=n.querySelector('[aria-current="page"]');function more(){if(n.scrollLeft+n.clientWidth<n.scrollWidth-1)n.setAttribute('data-more','1');else n.removeAttribute('data-more');}function place(){if(c&&n.scrollWidth>n.clientWidth+1)n.scrollLeft=Math.max(0,c.offsetLeft-(n.clientWidth-c.offsetWidth)/2);more();}n.addEventListener('scroll',more,{passive:true});addEventListener('resize',function(){requestAnimationFrame(place);});requestAnimationFrame(place);})();</script>
      {CLERK_ENABLED && (
        <div class="site-header-auth shrink-0 flex items-center">
          <a href="#" id="auth-signin" class="small mr-2 sm:mr-3 inline-flex items-center min-h-11 sm:min-h-0 text-[var(--color-ink)] hover:underline">Sign in</a>
          <button type="button" id="auth-signup" class="btn btn-accent" data-analytics="nav-signup">Sign up</button>
          <div id="auth-user" class="hidden min-h-8" aria-label="Account"></div>
        </div>
      )}
      <script>
        import { onClerk, openSignIn, openSignUp, clerkAppearance, wireAnalytics } from '../lib/clerk-client.ts';
        wireAnalytics();
        const b = document.getElementById('auth-signup'), s = document.getElementById('auth-signin'), u = document.getElementById('auth-user');
        if (b && s && u) {
          s.addEventListener('click', (e) => { e.preventDefault(); openSignIn(); });
          b.addEventListener('click', () => openSignUp('gate', 'Create your free account: tune assumptions, keep scenario links and save Build Composer plans when available.'));
          onClerk(() => {
            const c = (window as any).Clerk; if (!c) return;
            const on = !!c.user;
            b.classList.toggle('hidden', on); s.style.display = on ? 'none' : ''; u.classList.toggle('hidden', !on);
            if (on && !u.hasChildNodes()) c.mountUserButton(u, { appearance: clerkAppearance() });
            if (!on && u.hasChildNodes()) { c.unmountUserButton(u); u.replaceChildren(); }
          });
        }
      </script>
    </div>
  </header>

  <main id="main" class="flex-1"><slot /></main>

  <footer class="border-t border-[var(--color-rule)] mt-24">
    <div class="wrap pt-10 pb-16 grid gap-8 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <p class="lockup"><Logo size={20} /><span class="wordmark"><b>S</b>OLVENCY</span></p>
        <p class="mt-3 text-sm max-w-md leading-relaxed">Cost per solved task for AI coding models. Every figure carries a source and a verification date. Where a number does not exist, it is reported as missing rather than estimated.</p>
        <p class="mt-4 small">Benchmark data is third-party, cited and linked, and is not redistributed.</p>
        <p class="small"><a class="link small-sans" href={aa?.attribution_url}>{aa?.attribution}</a>.</p>
      </div>
      <div>
        <p class="label">Site</p>
        <ul class="mt-3 space-y-2 text-sm">
          {NAV.map(([href, name]) => <li><a class="hover:underline" href={href}>{name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="label">For developers</p>
        <ul class="mt-3 space-y-2 text-sm">
          {DEV.map(([href, name]) => <li><a class="hover:underline" href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>{name}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="label">Trust</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a class="hover:underline" href="/methodology">How the numbers are made</a></li>
          <li><a class="hover:underline" href="/changelog">Every change to a published figure</a></li>
          <li><a class="hover:underline" href="/privacy">Privacy</a></li>
          <li><a class="hover:underline" href="/terms">Terms</a></li>
        </ul>
        <p class="mt-4 small">Prices verified <span class="text-[var(--color-ink)]">{verified}</span>.</p>
      </div>
    </div>
  </footer>
</body>
</html>
