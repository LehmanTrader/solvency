---
/**
 * AppShell: chrome for the signed-in console at /app. Rebuilt 2026-08-28 to
 * the enterprise-console pattern the operator pointed at (xhawk reference):
 * workspace switcher card, grouped sidebar nav (via slot), pinned user card
 * with theme toggle, and a sticky page bar carrying the section title and a
 * notification bell whose feed the console runtime fills. Clerk loads the
 * same way Base.astro does; no key means an ungated build.
 */
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { CLERK_ENABLED, CLERK_PUBLISHABLE_KEY, CLERK_FRONTEND_API } from '../lib/clerk.ts';
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Solvency console: budgets, actuals and governance for AI spend.' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#F4F5F7" />
  <script is:inline>(function(){try{var t=localStorage.getItem('theme');if(t==='light'||t==='dark')document.documentElement.setAttribute('data-theme',t);}catch(e){}})();</script>
  <link rel="icon" href="/brand/favicon.svg?v=s1" type="image/svg+xml" />
  <link rel="icon" href="/brand/favicon-32.png?v=s1" sizes="32x32" type="image/png" />
  <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  {CLERK_ENABLED && (
    <script async crossorigin="anonymous"
            data-clerk-publishable-key={CLERK_PUBLISHABLE_KEY}
            src={`https://${CLERK_FRONTEND_API}/npm/@clerk/clerk-js@5/dist/clerk.browser.js`}
            onload="Promise.resolve().then(()=>window.Clerk.load({localization:{signUp:{start:{title:'Create your Solvency account',subtitle:'The console is free while we build with design partners.'}},signIn:{start:{title:'Sign in to Solvency',subtitle:'Open your console.'}}}})).then(()=>{delete document.documentElement.dataset.clerkUiError;document.documentElement.dataset.clerkUiReady='true';document.dispatchEvent(new Event('clerk:ready'))}).catch(()=>{delete document.documentElement.dataset.clerkUiReady;document.documentElement.dataset.clerkUiError='true';document.dispatchEvent(new Event('clerk:error'))})"
            onerror="delete document.documentElement.dataset.clerkUiReady;document.documentElement.dataset.clerkUiError='true';document.dispatchEvent(new Event('clerk:error'))"></script>
  )}
</head>
<body class="min-h-screen">
  <div class="app-frame">
    <aside class="app-side">
      <button type="button" class="ws-card" id="ws-card" aria-label="Workspace">
        <span class="ws-avatar"><Logo size={16} /></span>
        <span class="ws-meta">
          <b id="ws-name">My workspace</b>
          <i id="ws-plan">Design partner</i>
        </span>
        <svg class="ws-chev" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 9l5-5 5 5M7 15l5 5 5-5"/></svg>
      </button>
      <slot name="sidebar" />
      <div class="side-foot">
        <div class="user-card">
          <div id="app-auth-user" class="min-h-8" aria-label="Account"></div>
          <span class="user-meta" id="user-meta"><b>Console</b><i><a class="hover:underline" href="/">solvency.dev →</a></i></span>
          <button type="button" id="app-theme" class="theme-mini" aria-label="Toggle theme" title="Toggle theme">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>
      </div>
    </aside>
    <main class="app-main" id="main">
      <header class="app-topbar">
        <div class="topbar-lead"><slot name="topbar" /></div>
        <div class="topbar-tools">
          <button type="button" id="app-bell" class="bell" aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            <span class="bell-badge" id="bell-badge" hidden>0</span>
          </button>
          <div class="notif" id="app-notif" hidden>
            <p class="notif-h">Notifications</p>
            <div id="notif-list"></div>
          </div>
        </div>
      </header>
      <div class="app-content"><slot /></div>
    </main>
  </div>

  <style is:global>
    .app-frame { display: grid; grid-template-columns: 16.5rem 1fr; min-height: 100vh; background: var(--color-bg); }
    .app-side { display: flex; flex-direction: column; gap: .3rem; padding: .9rem .8rem;
                border-right: 1px solid var(--color-rule); background: var(--color-panel);
                position: sticky; top: 0; height: 100vh; overflow-y: auto; }
    .ws-card { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .6rem; text-align: left;
               border: 1px solid var(--color-rule); background: var(--color-panel); border-radius: 10px;
               padding: .55rem .65rem; cursor: default; color: var(--color-ink); }
    .ws-card:hover { background: var(--color-panel-2); }
    .ws-avatar { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px;
                 background: #0C1122; color: #E9EBF3; }
    .ws-meta { min-width: 0; }
    .ws-meta b { display: block; font-family: var(--font-sans); font-size: .8rem; font-weight: 600;
                 white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ws-meta i { display: block; font-style: normal; font-family: var(--font-sans); font-size: .66rem; color: var(--color-muted); }
    .ws-chev { color: var(--color-muted); }

    .side-label { font-family: var(--font-sans); font-size: .6rem; font-weight: 700; letter-spacing: .12em;
                  text-transform: uppercase; color: var(--color-muted); margin: 1rem .55rem .3rem; }
    .side-a { display: flex; align-items: center; gap: .6rem; padding: .48rem .6rem; border-radius: 8px;
              font-family: var(--font-sans); font-size: .84rem; color: var(--color-body); }
    .side-a svg { flex: none; color: var(--color-muted); }
    .side-a:hover { background: var(--color-panel-2); color: var(--color-ink); }
    .side-a[aria-current="true"] { background: var(--color-panel-2); color: var(--color-ink); font-weight: 600; }
    .side-a[aria-current="true"] svg { color: var(--color-ink); }
    .side-a .side-tag { margin-left: auto; font-family: var(--font-sans); font-size: .56rem; color: var(--color-muted);
                        border: 1px solid var(--color-rule); border-radius: 99px; padding: .06rem .4rem; }

    .side-foot { margin-top: auto; padding-top: .8rem; }
    .user-card { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .55rem;
                 border: 1px solid var(--color-rule); border-radius: 10px; padding: .5rem .6rem; }
    .user-meta { min-width: 0; }
    .user-meta b { display: block; font-family: var(--font-sans); font-size: .74rem; font-weight: 600; color: var(--color-ink); }
    .user-meta i { display: block; font-style: normal; font-family: var(--font-sans); font-size: .64rem; color: var(--color-muted); }
    .theme-mini { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 7px;
                  border: 1px solid var(--color-rule); background: transparent; color: var(--color-muted); cursor: pointer; }
    .theme-mini:hover { color: var(--color-ink); border-color: var(--color-control-border); }

    .app-main { min-width: 0; display: flex; flex-direction: column; }
    .app-topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between;
                  gap: 1rem; padding: .7rem 1.6rem; border-bottom: 1px solid var(--color-rule);
                  background: color-mix(in srgb, var(--color-bg) 92%, transparent); backdrop-filter: blur(6px); }
    .topbar-lead { display: flex; align-items: center; gap: .7rem; min-width: 0; }
    .topbar-title { font-family: var(--font-sans); font-size: .95rem; font-weight: 650; color: var(--color-ink); }
    .topbar-tools { position: relative; display: flex; align-items: center; gap: .5rem; }
    .bell { position: relative; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px;
            border: 1px solid var(--color-rule); background: var(--color-panel); color: var(--color-body); cursor: pointer; }
    .bell:hover { border-color: var(--color-control-border); color: var(--color-ink); }
    .bell-badge { position: absolute; top: -5px; right: -5px; min-width: 15px; height: 15px; border-radius: 99px;
                  background: var(--color-accent); color: #fff; font-family: var(--font-sans); font-size: .56rem;
                  font-weight: 700; display: grid; place-items: center; padding: 0 3px; }
    .notif { position: absolute; right: 0; top: 40px; width: 21rem; max-height: 22rem; overflow-y: auto;
             background: var(--color-panel); border: 1px solid var(--color-rule); border-radius: 12px;
             box-shadow: 0 18px 44px -18px rgba(10, 14, 35, .35); padding: .6rem; z-index: 40; }
    .notif-h { font-family: var(--font-sans); font-size: .68rem; font-weight: 700; letter-spacing: .08em;
               text-transform: uppercase; color: var(--color-muted); margin: .2rem .4rem .4rem; }
    .notif-item { display: flex; gap: .55rem; align-items: flex-start; padding: .5rem .45rem; border-radius: 8px;
                  font-family: var(--font-sans); font-size: .76rem; line-height: 1.45; color: var(--color-body); }
    .notif-item:hover { background: var(--color-panel-2); }
    .notif-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; margin-top: .32rem; }
    .notif-dot.over { background: var(--color-worse); }
    .notif-dot.near { background: #B8860B; }
    .notif-dot.idle { background: var(--color-muted); }
    .notif-dot.info { background: var(--color-accent); }
    .app-content { flex: 1; padding: 1.4rem 1.6rem 4rem; min-width: 0; }

    @media (max-width: 860px) {
      .app-frame { grid-template-columns: 1fr; }
      .app-side { position: static; height: auto; }
      .side-foot { margin-top: .6rem; }
    }
  </style>
</body>
</html>
