---
/**
 * Horizontal bar list. Pure HTML/CSS so it renders without JS and reads in
 * screen readers as a list. `lead` marks the row the accent belongs to; other
 * rows are drawn in the muted tone unless `mono` is false.
 */
interface Item { label: string; value: number; display: string; href?: string; lead?: boolean; }
interface Props { items: Item[]; max?: number; mono?: boolean; class?: string; tone?: 'measured' | 'modelled'; }
const { items, mono = true, class: cls = '', tone = 'measured' } = Astro.props;
const max = Astro.props.max ?? Math.max(...items.map((i) => i.value), 0);
const w = (v: number) => (max > 0 ? Math.max(1, (v / max) * 100) : 0);
---
<ul class={`bars ${tone} ${cls}`} role="list">
  {items.map((i) => (
    <li class={`br ${i.lead ? 'lead' : ''}`}>
      <span class="bl" title={i.label}>{i.href ? <a href={i.href} class="hover:text-[var(--color-accent)]">{i.label}</a> : i.label}</span>
      <span class="bt" aria-hidden="true"><span class={`bf ${mono && !i.lead ? 'ink' : ''}`} style={`width:${w(i.value)}%`}></span></span>
      <span class="bv">{i.display}</span>
    </li>
  ))}
</ul>
