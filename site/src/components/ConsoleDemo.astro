---
/**
 * ConsoleDemo — the working console, animated (landing redesign 2026-08-28:
 * "live animations of the portal working as people scroll"). A framed mock
 * of /app's Actuals view runs a 14s choreographed loop: export drops in,
 * the metered-equivalent KPI counts up, seat rows slide in with bars, and
 * verdict pills land. Pure CSS keyframes on transform/opacity only; every
 * child shares the same 14s cycle so the loop stays in sync. Playback is
 * gated by an IntersectionObserver (.play) so nothing burns cycles
 * offscreen, and prefers-reduced-motion freezes the finished state.
 * Decorative: aria-hidden, numbers match the public sample team.
 */
---
<div class="cdemo" aria-hidden="true" data-console-demo>
  <div class="cd-chrome">
    <span class="cd-dot"></span><span class="cd-dot"></span><span class="cd-dot"></span>
    <span class="cd-url">solvency.dev/app</span>
  </div>
  <div class="cd-body">
    <div class="cd-side">
      <span class="cd-brand"></span>
      <span class="cd-nav on">Overview</span>
      <span class="cd-nav hot">Actuals</span>
      <span class="cd-nav">Budgets</span>
      <span class="cd-nav">Hardware</span>
    </div>
    <div class="cd-main">
      <div class="cd-drop"><span class="cd-file">usage-aug.csv</span><span class="cd-parsed">8 seats · parsed in your browser</span></div>
      <div class="cd-kpis">
        <div class="cd-kpi"><i>Seat fees</i><b>$1,600<u>/mo</u></b></div>
        <div class="cd-kpi"><i>Metered-equivalent</i><b class="cd-count"></b></div>
        <div class="cd-kpi"><i>Net vs API</i><b class="cd-net">+$3,258</b></div>
      </div>
      <div class="cd-rows">
        <div class="cd-row" style="--i:0"><span class="cd-seat">ana</span><span class="cd-track"><span class="cd-bar" style="--w:.92"></span></span><span class="cd-pill ok">keep</span></div>
        <div class="cd-row" style="--i:1"><span class="cd-seat">ben</span><span class="cd-track"><span class="cd-bar" style="--w:.55"></span></span><span class="cd-pill ok">keep</span></div>
        <div class="cd-row" style="--i:2"><span class="cd-seat">carla</span><span class="cd-track"><span class="cd-bar" style="--w:.34"></span></span><span class="cd-pill warn">review</span></div>
        <div class="cd-row" style="--i:3"><span class="cd-seat">dev</span><span class="cd-track"><span class="cd-bar" style="--w:.18"></span></span><span class="cd-pill warn">review</span></div>
        <div class="cd-row" style="--i:4"><span class="cd-seat">eli</span><span class="cd-track"><span class="cd-bar" style="--w:.07"></span></span><span class="cd-pill over">move to API</span></div>
      </div>
      <p class="cd-method">repriced at verified metered rates · unknown models excluded, never guessed</p>
    </div>
  </div>
</div>

<style>
  @property --cdn { syntax: "<integer>"; inherits: false; initial-value: 0; }

  .cdemo { --cyc: 14s; background: #0F1528; border: 1px solid #27304D; border-radius: 12px;
           box-shadow: 0 24px 60px -24px rgba(4, 8, 24, .7); overflow: hidden;
           font-family: var(--font-mono); }
  .cd-chrome { display: flex; align-items: center; gap: .4rem; padding: .55rem .8rem;
               border-bottom: 1px solid #27304D; background: #131A30; }
  .cd-dot { width: 9px; height: 9px; border-radius: 50%; background: #2C3554; }
  .cd-url { margin-left: .5rem; font-size: .62rem; color: #6F7A9C; letter-spacing: .04em; }
  .cd-body { display: grid; grid-template-columns: 6.4rem 1fr; }
  .cd-side { border-right: 1px solid #27304D; padding: .8rem .6rem; display: flex; flex-direction: column; gap: .45rem; background: #111731; }
  .cd-brand { width: 16px; height: 16px; margin-bottom: .3rem;
              background: linear-gradient(135deg, #E9EBF3 38%, #8E80E6 38% 62%, #E9EBF3 62%); border-radius: 3px; opacity: .9; }
  .cd-nav { font-size: .6rem; color: #6F7A9C; padding: .18rem .35rem; border-radius: 4px; }
  .cd-nav.on { color: #A9B2CC; }
  .cd-nav.hot { color: #fff; background: #232C4C; }
  .cd-main { padding: .9rem 1rem 1rem; min-width: 0; }

  .cd-drop { display: flex; gap: .6rem; align-items: baseline; opacity: 0;
             animation: cd-drop var(--cyc) infinite cubic-bezier(.22,1,.36,1); }
  .cd-file { font-size: .68rem; color: #E9EBF3; background: #232C4C; border: 1px solid #33406B; border-radius: 5px; padding: .16rem .5rem; }
  .cd-parsed { font-size: .6rem; color: #6F7A9C; opacity: 0; animation: cd-parsed var(--cyc) infinite; }

  .cd-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; margin-top: .75rem; }
  .cd-kpi { background: #131A30; border: 1px solid #27304D; border-radius: 8px; padding: .5rem .6rem;
            opacity: 0; animation: cd-rise var(--cyc) infinite; }
  .cd-kpi i { display: block; font-style: normal; font-size: .52rem; letter-spacing: .08em; text-transform: uppercase; color: #6F7A9C; }
  .cd-kpi b { display: block; margin-top: .2rem; font-size: .86rem; color: #fff; font-variant-numeric: tabular-nums; }
  .cd-kpi b u { text-decoration: none; font-size: .6rem; color: #6F7A9C; }
  .cd-net { color: #4ADE80 !important; }
  .cd-count { --cdn: 0; animation: cd-count var(--cyc) infinite step-end; }
  .cd-count::after { content: "$" counter(cdn); counter-reset: cdn var(--cdn); }

  .cd-rows { margin-top: .75rem; display: flex; flex-direction: column; gap: .4rem; }
  .cd-row { display: grid; grid-template-columns: 3.2rem 1fr auto; align-items: center; gap: .6rem;
            opacity: 0; transform: translateY(8px);
            animation: cd-row var(--cyc) infinite; animation-delay: calc(var(--i) * .28s); }
  .cd-seat { font-size: .66rem; color: #C7CEE4; }
  .cd-track { height: 7px; background: #1B2340; border-radius: 4px; overflow: hidden; }
  .cd-bar { --w: .5; display: block; height: 100%; width: 100%; border-radius: 4px; background: linear-gradient(90deg, #5B45E0, #8E80E6);
            transform: scaleX(0); transform-origin: left;
            animation: cd-bar var(--cyc) infinite; animation-delay: calc(var(--i) * .28s); }
  .cd-pill { font-size: .54rem; padding: .1rem .42rem; border-radius: 99px; white-space: nowrap;
             opacity: 0; transform: scale(.6);
             animation: cd-pill var(--cyc) infinite; animation-delay: calc(var(--i) * .28s); }
  .cd-pill.ok { background: rgba(74, 222, 128, .14); color: #4ADE80; }
  .cd-pill.warn { background: rgba(250, 204, 21, .13); color: #FACC15; }
  .cd-pill.over { background: rgba(248, 113, 113, .14); color: #F87171; }
  .cd-method { margin: .8rem 0 0; font-size: .55rem; color: #56618A; opacity: 0; animation: cd-fade var(--cyc) infinite; }

  /* Choreography on a shared 14s cycle (percentages of 14s):
     0-2%  drop chip in · 5% parsed note · 6-10% KPIs rise · 10-20% count-up
     11-22% rows+bars+pills (staggered by --i) · 93-100% everything fades for the loop */
  @keyframes cd-drop   { 0% { opacity: 0; transform: translateY(-6px); } 2%, 93% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; } }
  @keyframes cd-parsed { 0%, 4% { opacity: 0; } 6%, 93% { opacity: 1; } 98%, 100% { opacity: 0; } }
  @keyframes cd-rise   { 0%, 6% { opacity: 0; transform: translateY(8px); } 10%, 93% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; } }
  /* Holds 4858 across the loop seam: the staggered rows outlive the KPI card
     by up to ~1.1s at restart, so the reset to 0 must happen only inside the
     0-6% window where cd-rise keeps the card invisible. */
  @keyframes cd-count  { 0% { --cdn: 4858; } 4%, 8% { --cdn: 0; } 10% { --cdn: 512; } 12% { --cdn: 1489; } 14% { --cdn: 2704; } 16% { --cdn: 3651; } 18% { --cdn: 4310; } 20%, 100% { --cdn: 4858; } }
  @keyframes cd-row    { 0%, 11% { opacity: 0; transform: translateY(8px); } 14%, 93% { opacity: 1; transform: none; } 98%, 100% { opacity: 0; } }
  @keyframes cd-bar    { 0%, 13% { transform: scaleX(0); } 19%, 93% { transform: scaleX(var(--w)); } 100% { transform: scaleX(var(--w)); } }
  @keyframes cd-pill   { 0%, 19% { opacity: 0; transform: scale(.6); } 22%, 93% { opacity: 1; transform: scale(1); } 98%, 100% { opacity: 0; } }
  @keyframes cd-fade   { 0%, 20% { opacity: 0; } 24%, 93% { opacity: 1; } 98%, 100% { opacity: 0; } }

  /* Play only in view; hold the finished frame when motion is reduced. */
  .cdemo :is(.cd-drop, .cd-parsed, .cd-kpi, .cd-count, .cd-row, .cd-bar, .cd-pill, .cd-method) { animation-play-state: paused; }
  .cdemo.play :is(.cd-drop, .cd-parsed, .cd-kpi, .cd-count, .cd-row, .cd-bar, .cd-pill, .cd-method) { animation-play-state: running; }
  @media (prefers-reduced-motion: reduce) {
    .cdemo :is(.cd-drop, .cd-parsed, .cd-kpi, .cd-row, .cd-method) { animation: none; opacity: 1; transform: none; }
    .cdemo .cd-bar { animation: none; transform: scaleX(var(--w)); }
    .cdemo .cd-pill { animation: none; opacity: 1; transform: none; }
    .cdemo .cd-count { animation: none; --cdn: 4858; }
  }
</style>

<script>
  const demos = document.querySelectorAll('[data-console-demo]');
  if (demos.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.target.classList.toggle('play', e.isIntersecting);
    }, { threshold: 0.25 });
    demos.forEach((d) => io.observe(d));
  }
</script>
