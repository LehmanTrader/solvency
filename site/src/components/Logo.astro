---
/**
 * The Solvency mark: the drawn balance (operator's pick J1, 2026-08-26 —
 * round-4 fine-line candidate, shipped from the candidate sheet; original in
 * docs/logo-2026-08-26/logo4-scurve-1.png, extracted to ink-on-transparency).
 *
 * Raster interim of a generated drawing, so it cannot take `currentColor`
 * the way the old inline-SVG bars did. Two prepared variants swap by theme
 * instead: ink on the light ground, paper on the dark — the CSS below keys
 * off the same `data-theme` attribute the theme toggle writes (light is the
 * default when no attribute is set). A vector redraw can replace both files
 * without touching this component.
 */
interface Props { size?: number; class?: string; }
const { size = 20, class: cls = '' } = Astro.props;
---
<span class={`logo-mark ${cls}`} aria-hidden="true" style={`width:${size}px;height:${size}px`}>
  <img class="logo-mark-ink" src="/brand/mark-j1-ink.png" width={size} height={size} alt="" />
  <img class="logo-mark-paper" src="/brand/mark-j1-paper.png" width={size} height={size} alt="" />
</span>

<style is:global>
  .logo-mark { display: inline-flex; flex: none; }
  .logo-mark img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .logo-mark .logo-mark-paper { display: none; }
  [data-theme="dark"] .logo-mark .logo-mark-ink { display: none; }
  [data-theme="dark"] .logo-mark .logo-mark-paper { display: block; }
</style>
