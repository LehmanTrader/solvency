---
/**
 * The Solvency mark: a balance — beam, fulcrum, and the weight that settles it.
 *
 * Inlined rather than served as <img> so it themes itself. The brand ships two
 * variants of the same artwork (mark.svg on light, mark-inverted.svg on dark)
 * whose only difference is the bar colour, so the bars take `currentColor` and
 * follow the surrounding text, while the amber weight stays fixed — it is the
 * one colour that is constant across both supplied variants.
 *
 * BRAND_AMBER is deliberately not a theme token: the site accent shifts between
 * themes for contrast, and a logo that changes hue with the page is not a logo.
 */
interface Props { size?: number; class?: string; }
const { size = 20, class: cls = '' } = Astro.props;
const BRAND_AMBER = '#E0A02E';
---
<svg
  class={`logo-mark ${cls}`}
  width={size} height={size} viewBox="0 0 100 100"
  aria-hidden="true" focusable="false"
>
  <rect x="18" y="10" width="64" height="18" fill="currentColor" />
  <rect x="10" y="44" width="80" height="7" fill="currentColor" />
  <rect x="42" y="66" width="16" height="18" fill={BRAND_AMBER} />
</svg>
