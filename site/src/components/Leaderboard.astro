---
/**
 * The headline leaderboard. Two tables, never one: measured rows carry a cost
 * the benchmark observed; modelled rows carry Solvency's loop-model estimate.
 * Ranking one against the other is invalid, so they are never interleaved.
 */
import { leaderboard, money } from '../lib/headline.ts';
import { sourceFor, shortSourceName } from '../lib/data.ts';
import Provenance from './Provenance.astro';
interface Props { tier?: 'light' | 'moderate' | 'heavy'; limit?: number; }
const { tier = 'heavy', limit } = Astro.props;
const lb = leaderboard(tier);
const measured = limit ? lb.measured.slice(0, limit) : lb.measured;
const modelled = [...lb.modelled, ...lb.historical];
const aa = sourceFor('aa-coding-agent-index');
const harness = (label: string) => label.split(' - ')[0];
---
<div class="card overflow-hidden">
  <div class="card-head">
    <div>
      <h3 class="h-card"><span class="text-[var(--color-accent)]">Measured</span> · cost per solved task</h3>
      <p class="mt-1 small">The benchmark ran the model and observed the cost. No Solvency assumption is inside these figures.</p>
    </div>
    <span class="pill pill-accent">{measured.length} harness + model pairs</span>
  </div>
  <div class="tbl-wrap">
    <table class="tbl">
      <thead><tr>
        <th class="rank">#</th><th>Model</th><th>Harness</th>
        <th class="r">Index</th><th class="r">$ / task</th><th class="r">$ / solved task</th>
      </tr></thead>
      <tbody>
        {measured.map((x, i) => (
          <tr class={i === 0 ? 'lead' : ''}>
            <td class="rank">{i + 1}</td>
            <td class="ink"><a href={`/models/${x.m.model_id}`}>{x.m.display_name}</a></td>
            <td class="muted">{harness(x.r.entry_label)}</td>
            <td class="r">{Math.round(x.r.pass_rate * 100)}</td>
            <td class="r">{x.perTask === null ? <span class="missing">missing</span> : money(x.perTask)}</td>
            <td class={`r ${i === 0 ? 'accent' : 'ink'}`}>{money(x.cost)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="px-5 pb-4">
    <Provenance source={aa?.attribution} href={aa?.attribution_url} verified={aa?.last_verified}
      note={`Coding Agent Index ${aa?.version}, ${aa?.tasks_n} tasks, ${aa?.attempts_per_task} attempts each. Rows are harness + model pairs, not bare models. $ / solved task = $ / task ÷ (index ÷ 100).`} />
  </div>
</div>

{modelled.length > 0 && (
  <div class="card overflow-hidden mt-6">
    <div class="card-head">
      <div>
        <h3 class="h-card"><span class="text-[var(--color-warn)]">Modelled</span> · pass rate published, cost estimated</h3>
        <p class="mt-1 small">These sources publish no cost. Cost is Solvency's loop model at today's verified prices — an assumption, labelled as one. Not comparable with the measured table.</p>
      </div>
      <span class="pill pill-warn">{tier} tier</span>
    </div>
    <div class="tbl-wrap">
      <table class="tbl">
        <thead><tr>
          <th class="rank">#</th><th>Model</th><th>Source</th><th>Pass rate from</th>
          <th class="r">Pass</th><th class="r">$ / solved task</th>
        </tr></thead>
        <tbody>
          {modelled.map((x, i) => (
            <tr>
              <td class="rank">{i + 1}</td>
              <td class="ink"><a href={`/models/${x.m.model_id}`}>{x.m.display_name}</a></td>
              <td class="muted">{shortSourceName(x.r.benchmark)}</td>
              <td class="muted">{x.r.run_date}{x.basisKey === 'historical_at_run_date' ? ' · stale' : ''}</td>
              <td class="r">{Math.round(x.r.pass_rate * 100)}%</td>
              <td class="r ink">{money(x.cost)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="px-5 pb-4">
      <Provenance source="Sources: Scale SEAL (SWE-bench Pro) and Aider polyglot" href="/methodology" verified={aa?.last_verified}
        note="Aider pass rates predate 2026 and are marked stale. Loop model and frontier-efficiency assumptions are listed in the methodology." />
    </div>
  </div>
)}

{lb.missing.length > 0 && (
  <p class="small mt-4">Not ranked — no published pass rate, reported as missing rather than estimated: {lb.missing.map((m) => m.display_name).join(', ')}.</p>
)}
