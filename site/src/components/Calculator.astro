---
/**
 * The product: one question, two controls, the ranked answer.
 * Rendered at build with the defaults (wide and narrow layouts, CSS picks one)
 * so the page is complete without JavaScript and nothing shifts when the
 * island takes over. The island re-renders from compute() on every input.
 */
import { TIER_NAMES, sources, models } from '../lib/data.ts';
import { DEFAULTS, compute, groupsHtml, calloutHtml, projectTotalHtml, missingHtml, TIER_HELP, allChartRows, GROUP_TABS } from '../lib/calc.ts';
import { scatterPareto } from '../lib/charts.ts';
import { TASK_BUCKETS, bucketById, provenanceHtml, bucketArticle } from '../lib/tasks.ts';
import { CLERK_ENABLED } from '../lib/clerk.ts';
import { GATE_MODE } from '../lib/gate.ts';
// The "token price predicts almost nothing" finding — moved here from the
// old index.astro collapsed frontier section (stage 1.2, Roy's note 6) when
// the Frontier view was promoted into this card's Ranking | Frontier toggle.
import { headline, fmtX } from '../lib/headline.ts';
const h = headline();
const { rows, missing } = compute(DEFAULTS);
// the result card's inner width at the site's one container width (72rem − padding − card padding)
const WIDE = 1046, NARROW = 350;
// Stage 2 ("Sortable Ranking table", deferred from stage 1): sortable:true
// renders each group's header as real <button>s (aria-sort); no `sort` here
// means each group keeps rankedBars' own default (cost ascending), the same
// order this page has always shipped with. The client script below owns the
// live sort state per basis group and re-renders through this same
// groupsHtml/patchRanked path on every click — one authority, not a DOM
// shuffle (site/src/lib/charts.ts's rankedBars/patchRanked doc comments).
const defaultBucket = bucketById('mobile')!;
const wide = groupsHtml(rows, DEFAULTS, { width: WIDE, compact: false, sortable: true, only: GROUP_TABS[0].key, project: defaultBucket.label });
const narrow = groupsHtml(rows, DEFAULTS, { width: NARROW, compact: true, sortable: true, only: GROUP_TABS[0].key, project: defaultBucket.label });
// Stage 1.2 (Roy's note 6): the Frontier view of the same leaderboard —
// pulled forward from stage 2's plan, replacing the old collapsed scatter
// section on the homepage. Same allChartRows(rows, settings) the old
// index.astro card used; the rail (site/src/lib/charts.ts's
// frontierRailHtml) only renders on the wide layout, per the founder's
// "skip it at narrow widths" note.
const frontierAll = allChartRows(rows, DEFAULTS);
const frontierLead = frontierAll.find((r) => r.basis === 'measured')?.id;
const frontierWide = scatterPareto(frontierAll, { width: WIDE, compact: false, lead: frontierLead, rail: true });
const frontierNarrow = scatterPareto(frontierAll, { width: NARROW, height: NARROW, compact: true, lead: frontierLead });
// The hero defaults to bucket mode (owner's approved design): "I want to ship
// a [bucket]" with the working task count set to that bucket's published
// median, re-derived from data/task-study/final_table.csv by ../lib/tasks.ts.
// Monthly mode (the previous "I build [tier] tasks, about [n] a month."
// sentence) is a quiet secondary affordance for existing users and links —
// see the #c-mode-toggle wiring below and the URL-compat note there.
// Stage 1.2 (Roy's note 2): "the drop down should just be the type of
// project without a in front a should be part of the sentence" — the
// visible article sits in the sentence text (#c-bucket-article), not baked
// into each option's label, and switches a/an per selection automatically.
const defaultArticle = bucketArticle(TASK_BUCKETS, defaultBucket.id);
// calloutHtml(rows, DEFAULTS.volume) is what #c-callout falls back to in
// monthly mode; the client script recomputes it there, so it isn't needed
// at build time — the SSR default is bucket mode's project total below.
const project = projectTotalHtml(rows, defaultBucket.median);
const provenance = provenanceHtml(defaultBucket);
const aa = sources.find((s) => s.benchmark === 'aa-coding-agent-index');
const verified = aa?.last_verified;
const fresh = verified ? (Date.now() - Date.parse(verified)) / 86_400_000 <= 30 : false;
const names = models.slice().sort((a, b) => a.display_name.localeCompare(b.display_name));
const tierHelp = (t: string) => `${TIER_HELP[t as keyof typeof TIER_HELP]} · Tier: ${t}; measured rows unchanged.`;
---
<section id="calc" aria-labelledby="q-h" data-gated={CLERK_ENABLED ? '1' : '0'} data-gate-mode={GATE_MODE}>
  <h1 id="q-h" class="h-display max-w-[30ch] text-balance">Which model is cheapest for what you actually ship?</h1>

  <!-- Stage 1.1 (founder review of stage-1 screenshots): the lede paragraph
       and the metadata row that used to sit here are both gone. The lede's
       closing line was the project-wide banned self-validating sentence
       (direction.md §8 — a trust-assertion the founder ruled out everywhere
       reader-facing); the metadata row went for a separate reason, in his
       words: "this isnt some academic paper it's a product stop trying to
       source everything and validate it all." Verification/sourcing stays an
       internal discipline (Provenance labels and card footers still show the
       receipt, direction.md §8) — it just doesn't get a headline sentence or
       a counter row anymore. The headline + picker carry the page, per
       direction §5's radical-subtraction brief. -->

  <div id="hero-modes">
    <p class="sentence mode-bucket mt-6">
      I want to ship{' '}<span id="c-bucket-article">{defaultArticle}</span><select id="c-bucket" class="ctl ctl-inline" aria-label="What are you shipping?" data-ctl="bucket">
        {TASK_BUCKETS.map((b) => <option value={b.id} selected={b.id === defaultBucket.id}>{b.label}</option>)}
        <option value="other">something else</option>
      </select>.
    </p>
    <!-- Founder note (screenshot review, 2026-08-26): this row used to be
         `.small` mono, comically undersized against the hero sentence above
         it. It now continues the hero's own grammar one step down. -->
    <p id="c-other-row" class="mode-bucket sentence sentence-sub mt-2 hidden">
      How many tasks?{' '}<input id="c-taskcount" class="ctl ctl-inline" type="number" inputmode="numeric" min="1" max="1000000" step="1" value={defaultBucket.median} aria-label="Task count" data-ctl="taskcount" />
    </p>

    <p class="sentence mode-monthly hidden mt-6">
      I build{' '}<select id="c-tier" class="ctl ctl-inline" aria-label="Task tier: what you build" aria-describedby="c-tier-help" data-ctl="tier">{TIER_NAMES.map((t) => <option value={t} selected={t === DEFAULTS.tier}>{t}</option>)}</select>{' '}tasks,<br class="sm:hidden" /> about{' '}<input id="c-volume" class="ctl ctl-inline" type="number" inputmode="numeric" min="1" max="10000000" step="1" value={DEFAULTS.volume} aria-label="Tasks per month" data-ctl="volume" />{' '}a month.
    </p>
    <div class="mode-monthly hidden mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-[minmax(0,26rem)_minmax(0,20rem)] items-center">
      <p id="c-tier-help" class="small" aria-live="polite">{tierHelp(DEFAULTS.tier)}</p>
      <div>
        <input id="c-volume-range" class="ctl-range" type="range" min="0" max="1000" step="1" value="325"
          aria-label="Tasks per month, slider" aria-valuetext={`${DEFAULTS.volume} tasks a month`} data-ctl="volume" />
        <!-- One label per decade. The track is log10 over VOL_MIN..VOL_MAX, so a
             label every decade is exactly evenly spaced, which is what the flex
             does. Dropping one (as an earlier 10/1k/10k/100k set did) leaves the
             labels at 0/33/66% while those values sit at 0/50/75%, and the handle
             then reads a decade off: 200 tasks appeared to sit on "1k". -->
        <div class="ticks small" aria-hidden="true"><span>10</span><span>100</span><span>1k</span><span>10k</span><span>100k</span></div>
      </div>
    </div>
  </div>

  <!-- Stage 1.1: the visible "Task tier:" row is gone from the hero flow —
       "this isnt some academic paper it's a product stop trying to source
       everything and validate it all" applied here too, read as "unnecessary
       clutter" for a control most visitors never touch (bucket mode already
       picks a sensible tier from the task type). The control itself isn't
       deleted — it still drives real state (CTRL.tierBucket in the script
       below) — it moves into the Assumptions disclosure below, where a
       visitor who does want to change it can find it. The mode-switch link
       stays here on its own line: it's a navigation affordance, not the
       clutter that was called out. -->
  <p class="small mt-3">
    <button type="button" id="c-mode-toggle" class="link-btn" aria-describedby="c-mode-toggle-help">pricing ongoing work instead?</button>
  </p>
  <p id="c-mode-toggle-help" class="sr-only">Switches to a tasks-per-month slider for pricing an ongoing volume of work instead of a single project.</p>

  <div class="card mt-6 overflow-hidden" id="c-result" role="region" aria-label="Result">
    <div class="px-5 py-4 sm:py-5 border-b border-[var(--color-rule)]">
      <p id="c-callout" class="text-[var(--color-ink)] text-[1rem] sm:text-[1.1rem] leading-relaxed" aria-live="polite" aria-atomic="true" set:html={project}></p>
      <p id="c-provenance" class="small mt-2" aria-live="polite" set:html={provenance}></p>
    </div>
    <a href="#c-actions" class="sr-only focus:not-sr-only focus:block focus:m-3 btn">Skip the ranked rows</a>
    <!-- TASK_BUCKETS, computed server-side from data/task-study/final_table.csv
         by ../lib/tasks.ts (node:fs — build-only). The client island cannot
         import that module (no node:fs in the browser), so it reads the same
         already-computed data from here and formats it with the pure helpers
         in ../lib/tasks-shared.ts — one computation, no client-side drift. -->
    <script type="application/json" id="task-buckets-data" is:inline set:html={JSON.stringify(TASK_BUCKETS)}></script>
    <!-- Stage 1.2 (Roy's note 6): the frontier chart pulled forward from
         stage 2 and promoted to a view of the leaderboard itself, Arena-
         grammar "View as: Ranking | Pareto" (direction.md's recon notes).
         Instant swap — a plain aria-pressed toggle, no anchor/scroll — see
         the #c-view-ranking / #c-view-frontier wiring below. Ranking stays
         the default; the old collapsed "Show the frontier chart" disclosure
         on the homepage (site/src/pages/index.astro) is gone, replaced by
         this. -->
    <div class="px-5 pt-4 pb-1 flex flex-wrap gap-3 items-center">
      <!-- Population toggle (operator, 2026-08-26): one visible list,
           switched between populations — the stacked groups read as clutter.
           Populations still never merge into one ranking; the toggle changes
           which one is on screen, arena-style. -->
      <div class="view-toggle" role="group" aria-label="Population" id="c-pop-toggle">
        {GROUP_TABS.map((t, i) => (
          <button type="button" data-pop={t.key} aria-pressed={i === 0 ? 'true' : 'false'}>{t.label}</button>
        ))}
      </div>
      <div class="view-toggle" role="group" aria-label="Leaderboard view">
        <button type="button" id="c-view-ranking" aria-pressed="true">Ranking</button>
        <button type="button" id="c-view-frontier" aria-pressed="false">Frontier</button>
      </div>
    </div>
    <!-- Stage 2: announces a header sort click for screen-reader users; the
         clicked <button>'s own aria-sort already carries the state for
         anyone inspecting that control directly. -->
    <p id="c-sort-status" class="sr-only" role="status" aria-live="polite"></p>
    <div id="c-groups" class="relative" data-wide={WIDE} data-narrow={NARROW}>
      <form id="c-find" class="find" role="search" autocomplete="off">
        <label for="c-find-q" class="sr-only">Find a model</label>
        <input id="c-find-q" class="ctl find-q" type="search" list="c-find-list" placeholder="Find a model" aria-describedby="c-find-msg" enterkeyhint="search" />
        <datalist id="c-find-list">{names.map((m) => <option value={m.display_name} />)}</datalist>
        <p id="c-find-msg" class="small find-msg" role="status"></p>
      </form>
      <div class="hidden sm:block" data-layout="wide" data-bars-animate set:html={wide}></div>
      <div class="sm:hidden" data-layout="narrow" data-bars-animate set:html={narrow}></div>
    </div>
    <div id="c-frontier" class="relative px-5 pb-4 hidden" data-wide={WIDE} data-narrow={NARROW}>
      <p class="text-[var(--color-body)] leading-relaxed max-w-[64ch] text-[0.875rem] mb-3">
        Token price predicts almost nothing: {h.cheap.m.display_name} is {fmtX(h.outX)} cheaper per output token than{' '}
        {h.dear.m.display_name} — and <strong class="text-[var(--color-ink)]">{fmtX(h.solvedX)} cheaper per solved task</strong>.
        Lower cost and higher pass rate is better; the purple line joins the measured models nobody beats on both.
      </p>
      <div class="hidden sm:block" data-chart data-layout="wide" data-w={WIDE} set:html={frontierWide}></div>
      <div class="sm:hidden" data-chart data-layout="narrow" data-w={NARROW} set:html={frontierNarrow}></div>
      <div class="tip" id="c-frontier-tip" role="presentation" aria-hidden="true"></div>
      <div class="mt-3 flex flex-wrap items-center justify-end gap-3">
        <a class="link small" href="/methodology#frontier">See how the frontier is computed →</a>
      </div>
    </div>

    <div id="c-gate" class="gate px-5 py-4 border-t border-[var(--color-rule)] hidden" role="region" aria-labelledby="c-gate-h" aria-live="polite" tabindex="-1">
      <div class="grid gap-x-8 gap-y-3 md:grid-cols-[minmax(0,1fr)_auto] items-center">
        <div class="min-w-0">
          <p id="c-gate-h" class="h-card">Keep these assumptions.</p>
          <p class="mt-1 text-[0.875rem] leading-relaxed text-[var(--color-body)]"><span id="c-gate-delta"></span> Create a free account to keep assumptions and save this scenario.</p>
          <p class="small mt-1">GitHub, Google or email. Assumptions move modeled rows only; measured rows never change.</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center md:flex-col md:items-stretch">
          <button id="c-gate-signin" type="button" class="btn btn-accent" data-analytics="gate-signup">Create free account</button>
          <button id="c-gate-skip" type="button" class="btn btn-quiet">Keep exploring without it →</button>
        </div>
      </div>
    </div>

    <section class="px-5 py-4 border-t border-[var(--color-rule)]" id="c-missing-d" aria-labelledby="c-missing-h">
      <p class="ghead" id="c-missing-h">Priced, awaiting measurement (<span data-count>{missing.length}</span>) · verified prices for every listed model; cost per solved task stays missing until a benchmark measures it — shown in full, never estimated.</p>
      <p id="c-missing-find" class="small mt-2 text-[var(--color-ink)]" role="status"></p>
      <div id="c-missing" class="small mt-3" set:html={missingHtml(missing)}></div>
    </section>

    <div id="c-actions" class="px-5 py-3 border-t border-[var(--color-rule)]">
      <div class="flex flex-wrap gap-x-6 gap-y-3 items-start justify-between">
        <p class="small min-w-0">
          <a class="link small-sans" href={aa?.attribution_url} rel="noopener">{aa?.attribution}</a>{' '}
          · verified <span class={fresh ? 't-fresh' : 'text-[var(--color-ink)]'}>{verified}</span>{' '}
          · <a class="link" href="/methodology#sources">Sources</a>
        </p>
        <div class="flex flex-col gap-1 items-start sm:items-end">
          <div class="flex flex-wrap gap-2 items-center">
            <button id="c-share" type="button" class="btn btn-copy" aria-live="polite">Copy link</button>
            {CLERK_ENABLED && <button id="c-save" type="button" class="btn" data-ctl="save" data-analytics="save-scenario" aria-live="polite" aria-describedby="c-save-why">Save scenario</button>}
          </div>
          {CLERK_ENABLED && <p id="c-save-why" class="small">Keeps this scenario URL in your free account.</p>}
        </div>
      </div>
      <!-- Stage 1.2 (Roy's note 5): the Composer-vs-Pro cross-sell paragraph
           that used to sit here — the custom-prices claim plus its planned-
           Pro pitch and "Share interest" pro-notify button — removed
           entirely per the founder's note: "what is this line ... remove
           that whole section." No replacement copy: the calculator's job is
           the ranked answer above; a Pro pitch doesn't belong in this card.
           (See test/design-remediation.test.ts for the moved pin that now
           guards this section staying gone.) -->
    </div>

    <details class="disc px-5 py-3 border-t border-[var(--color-rule)]" id="c-assume">
      <summary>Assumptions (4) · move modeled rows only</summary>
      <!-- Task tier, relocated from the hero (stage 1.1, see the note above
           #c-mode-toggle): not one of the 4 assumptions below — it doesn't
           move modeled rows, it picks which tier's rows are shown — so it
           gets its own line above that grid rather than a 5th tile in it.
           mode-bucket keeps it in step with the hero: hidden in monthly mode,
           where #c-tier (in the "I build [tier] tasks…" sentence) already
           covers the same control. -->
      <p class="mode-bucket small mb-4">
        Task tier:{' '}<select id="c-tier-bucket" class="ctl ctl-inline" aria-label="Task tier: what you build" aria-describedby="c-tier-help-bucket">{TIER_NAMES.map((t) => <option value={t} selected={t === DEFAULTS.tier}>{t}</option>)}</select>{' '}<span id="c-tier-help-bucket">{tierHelp(DEFAULTS.tier)}</span>
      </p>
      <div class="assume mt-4 grid gap-x-6 gap-y-5 sm:grid-cols-2 lg:grid-cols-4">
        <label class="block">
          <span class="label">Retry model</span>
          <select id="c-variant" class="ctl ctl-row mt-2 w-full" data-ctl="variant">
            <option value="naive">naive — cost ÷ pass rate</option>
            <option value="capped">capped — max 3 attempts</option>
            <option value="truncatedGeometric">truncated geometric</option>
          </select>
        </label>
        <label class="block">
          <span class="label">Cache hit rate <span id="c-cache-v" class="text-[var(--color-ink)]">0%</span></span>
          <input id="c-cache" type="range" min="0" max="90" step="10" value="0" class="ctl-range ctl-row mt-2" data-ctl="cache" aria-label="Cache hit rate, percent" />
        </label>
        <label class="block">
          <span class="label">Human takeover cost, $</span>
          <input id="c-residual" type="number" inputmode="numeric" min="0" max="1000000" step="10" value="0" class="ctl ctl-row mt-2 w-full" data-ctl="residual" />
        </label>
        <label class="block">
          <span class="label">Frontier efficiency</span>
          <span class="ctl-row mt-2 flex items-center gap-3"><input id="c-frontier" type="checkbox" checked class="chk" data-ctl="frontier" /><span class="text-[0.875rem] text-[var(--color-body)]">0.6× loops on heavy, frontier-class models</span></span>
        </label>
      </div>
      <p id="c-assume-note" class="small mt-3 text-[var(--color-ink)]" role="status"></p>
      <p class="mt-4 text-[0.8rem] leading-relaxed text-[var(--color-muted)] max-w-[70ch]">These move modeled rows only. A model with no published cached-input price is computed uncached and says so in its row, rather than dropping out of its group. Measured rows carry a cost the benchmark observed and cannot be changed by any assumption. Frontier efficiency has no published source and is applied only to modeled rows — untick it to see unadjusted results. <a class="link" href="/methodology">Methodology</a>.</p>
    </details>
  </div>
</section>

<script>
  import { compute, groupsHtml, calloutHtml, projectTotalHtml, missingHtml, gateDelta, TIER_HELP, validModelId, allChartRows, GROUP_TABS, type Settings, type Row } from '../lib/calc.ts';
  // ../lib/tasks.ts reads data/task-study/final_table.csv via node:fs at
  // import time and must never reach a browser bundle. The server already
  // computed TASK_BUCKETS from it and embedded the result as #task-buckets-data
  // (see Calculator.astro's markup); only the pure formatting helpers are
  // imported here, from the node:fs-free ../lib/tasks-shared.ts.
  import { type TaskBucket, bucketById as bucketByIdIn, provenanceHtml, otherProvenanceHtml, bucketArticle } from '../lib/tasks-shared.ts';
  const TASK_BUCKETS: TaskBucket[] = JSON.parse(document.getElementById('task-buckets-data')!.textContent!);
  const bucketById = (id: string) => bucketByIdIn(TASK_BUCKETS, id);
  import { patchRanked, scatterPareto, VOL_MIN, VOL_MAX, type RankSort, type RankSortKey, type Basis } from '../lib/charts.ts';
  import { gateFor, GATE_SEEN_KEY, type Control, type GateMode } from '../lib/gate.ts';
  import { signedIn, onClerk, openSignUp, wireSave } from '../lib/clerk-client.ts';
  const scenarioName = () => `${CTRL.tier.value} · ${Number(CTRL.volume.value).toLocaleString()}/mo`;
  import { wireCopy } from '../lib/copy.ts';
  import { models } from '../lib/data.ts';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const section = $('calc')!;
  const CTRL = {
    tier: $<HTMLSelectElement>('c-tier')!,
    tierBucket: $<HTMLSelectElement>('c-tier-bucket')!,
    volume: $<HTMLInputElement>('c-volume')!,
    range: $<HTMLInputElement>('c-volume-range')!,
    bucket: $<HTMLSelectElement>('c-bucket')!,
    taskcount: $<HTMLInputElement>('c-taskcount')!,
    variant: $<HTMLSelectElement>('c-variant')!,
    cache: $<HTMLInputElement>('c-cache')!,
    residual: $<HTMLInputElement>('c-residual')!,
    frontier: $<HTMLInputElement>('c-frontier')!,
  };
  const groupsEl = $('c-groups')!;
  // ---- population toggle: one list on screen at a time -------------------
  let currentPop: string = GROUP_TABS[0].key;
  const popToggle = $('c-pop-toggle')!;
  const setPop = (key: string) => {
    if (!GROUP_TABS.some((t) => t.key === key)) return;
    currentPop = key;
    popToggle.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', (b as HTMLButtonElement).dataset.pop === key ? 'true' : 'false'));
  };
  popToggle.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-pop]');
    if (!btn || btn.dataset.pop === currentPop) return;
    setPop(btn.dataset.pop!);
    render();
  });
  // First-load bar entrance: the SSR wrapper carries data-bars-animate (see
  // global.css). Drop it once the entrance has played, so settings changes
  // and sorts never replay the animation.
  setTimeout(() => groupsEl.querySelectorAll('[data-bars-animate]').forEach((el) => el.removeAttribute('data-bars-animate')), 1800);

  // ---- Sortable Ranking table (stage 2, deferred from stage 1) ------------
  // One sort state per basis group ("sort state per basis group" in the
  // brief) — clicking a header in the Measured group never touches Modeled
  // or Stale. Default matches what rankedBars already does with no `sort`
  // passed (cost ascending), so the very first render is pixel-identical to
  // before this feature existed.
  const SORT_DEFAULT = (): RankSort => ({ key: 'cost', dir: 'asc' });
  const groupSort: Record<Basis, RankSort> = { measured: SORT_DEFAULT(), modelled: SORT_DEFAULT(), stale: SORT_DEFAULT() };
  const SORT_LABEL: Record<RankSortKey, string> = { name: 'model name', pass: 'pass rate', cost: '$ / solved task', month: '$ / month' };
  const sortStatus = $('c-sort-status');
  groupsEl.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('button.rank-h');
    if (!btn) return;
    const key = btn.dataset.sortKey as RankSortKey | undefined;
    const basis = btn.closest<HTMLElement>('[data-group]')?.dataset.group as Basis | undefined;
    if (!key || !basis) return;
    const prev = groupSort[basis];
    // Clicking the active column reverses it; clicking a new column picks a
    // sensible first direction — pass rate defaults to highest-first (desc),
    // everything else to lowest/A-first (asc), matching what a first click
    // on that column should mean.
    groupSort[basis] = prev.key === key ? { key, dir: prev.dir === 'asc' ? 'desc' : 'asc' } : { key, dir: key === 'pass' ? 'desc' : 'asc' };
    render(false);
    const next = groupSort[basis];
    if (sortStatus) sortStatus.textContent = `${basis.charAt(0).toUpperCase()}${basis.slice(1)} rows sorted by ${SORT_LABEL[next.key]}, ${next.dir === 'asc' ? 'lowest first' : 'highest first'}.`;
  });
  // Enter/Space on a focused header button already dispatches a native
  // click (native <button> behavior) — no extra keydown handling needed;
  // this is the "button semantics" half of the brief's a11y requirement.

  const otherRow = $('c-other-row')!;
  const bucketArticleEl = $('c-bucket-article')!;
  const syncBucketArticle = () => { bucketArticleEl.textContent = bucketArticle(TASK_BUCKETS, CTRL.bucket.value); };
  const modeToggle = $<HTMLButtonElement>('c-mode-toggle')!;
  const BUCKET_IDS = TASK_BUCKETS.map((b) => b.id).concat('other');
  const TIERS = ['light', 'moderate', 'heavy'], VARIANTS = ['naive', 'capped', 'truncatedGeometric'];

  // ---- volume: number box and a log-scale slider, bound both ways --------
  const L0 = Math.log10(VOL_MIN), L1 = Math.log10(VOL_MAX);
  const sliderToVolume = (t: number) => {
    const v = Math.pow(10, L0 + (t / 1000) * (L1 - L0));
    const mag = Math.pow(10, Math.floor(Math.log10(v)) - 1);
    return Math.max(VOL_MIN, Math.round(v / mag) * mag);
  };
  const volumeToSlider = (v: number) => Math.round(((Math.log10(Math.min(VOL_MAX, Math.max(VOL_MIN, v))) - L0) / (L1 - L0)) * 1000);
  const syncSlider = () => {
    const v = Number(CTRL.volume.value) || 1;
    CTRL.range.value = String(volumeToSlider(v));
    CTRL.range.setAttribute('aria-valuetext', `${v.toLocaleString()} tasks a month`);
    CTRL.range.style.setProperty('--fill', `${volumeToSlider(v) / 10}%`);
  };
  // content-sized sentence controls where field-sizing is unsupported
  const sizeInline = () => {
    if (CSS.supports('field-sizing', 'content')) return;
    CTRL.volume.style.width = `${Math.max(3, CTRL.volume.value.length) + 0.4}ch`;
    const opt = CTRL.tier.selectedOptions[0]?.text ?? '';
    CTRL.tier.style.width = `${opt.length * 0.62 + 1.2}em`;
  };

  // ---- URL state is the single source of truth ---------------------------
  // Every value is validated: a crafted link must not be able to throw inside
  // the engine or leave a select with no option chosen. Out-of-range values
  // keep the default rather than clamping to a number nobody asked for.
  const q = new URLSearchParams(location.search);
  const num = (v: string | null, lo: number, hi: number) => { const n = Number(v); return v !== null && v !== '' && Number.isFinite(n) && n >= lo && n <= hi ? Math.round(n) : null; };
  if (TIERS.includes(q.get('tier') ?? '')) CTRL.tier.value = q.get('tier')!;
  CTRL.tierBucket.value = CTRL.tier.value;
  if (VARIANTS.includes(q.get('variant') ?? '')) CTRL.variant.value = q.get('variant')!;
  const vol = num(q.get('volume'), 1, 10_000_000); if (vol) CTRL.volume.value = String(vol);
  const cache = num(q.get('cache'), 0, 90); if (cache !== null) CTRL.cache.value = String(Math.round(cache / 10) * 10);
  const res = num(q.get('residual'), 0, 1_000_000); if (res !== null) CTRL.residual.value = String(res);
  if (q.get('frontier') === '0' || q.get('frontier') === '1') CTRL.frontier.checked = q.get('frontier') === '1';
  let highlight = validModelId(q.get('highlight'));
  if (q.get('pop')) setPop(q.get('pop')!);

  // ---- hero mode: "I want to ship a [bucket]" (default) vs the legacy
  // "I build [tier] tasks, about [n] a month." slider. A link that already
  // encodes a monthly volume (?volume=…) but no explicit ?mode= is an old or
  // externally shared link — it keeps opening in monthly mode so the volume
  // it encodes is what the visitor sees, never silently reinterpreted.
  const modeParam = q.get('mode');
  let mode: 'bucket' | 'monthly' = modeParam === 'monthly' || modeParam === 'bucket' ? modeParam : (q.has('volume') ? 'monthly' : 'bucket');
  if (BUCKET_IDS.includes(q.get('bucket') ?? '')) CTRL.bucket.value = q.get('bucket')!;
  const taskcountParam = num(q.get('taskcount'), 1, 1_000_000);
  if (CTRL.bucket.value === 'other' && taskcountParam !== null) CTRL.taskcount.value = String(taskcountParam);
  else { const b0 = bucketById(CTRL.bucket.value); if (b0) CTRL.taskcount.value = String(b0.median); }
  otherRow.classList.toggle('hidden', CTRL.bucket.value !== 'other');
  syncBucketArticle();

  function applyMode(next: 'bucket' | 'monthly') {
    mode = next;
    document.querySelectorAll<HTMLElement>('.mode-bucket').forEach((el) => el.classList.toggle('hidden', mode !== 'bucket'));
    document.querySelectorAll<HTMLElement>('.mode-monthly').forEach((el) => el.classList.toggle('hidden', mode !== 'monthly'));
    // otherRow carries .mode-bucket (hidden outright in monthly mode) but is
    // also conditional on the "something else" bucket being picked — the
    // blanket rule above must not force it open just because bucket mode is active.
    if (mode === 'bucket') otherRow.classList.toggle('hidden', CTRL.bucket.value !== 'other');
    modeToggle.textContent = mode === 'bucket' ? 'pricing ongoing work instead?' : 'pricing one project instead?';
  }
  applyMode(mode);
  syncSlider(); sizeInline();

  const settings = (): Settings => ({
    tier: CTRL.tier.value as Settings['tier'],
    volume: Math.min(10_000_000, Math.max(1, Math.round(Number(CTRL.volume.value)) || 1)),
    variant: CTRL.variant.value as Settings['variant'],
    cache: Number(CTRL.cache.value) / 100,
    residual: Math.max(0, Number(CTRL.residual.value) || 0),
    frontier: CTRL.frontier.checked,
  });

  /** Median for the selected bucket, or the visitor's own count for "something else". */
  const effectiveTaskCount = (): number =>
    CTRL.bucket.value === 'other'
      ? Math.max(1, Math.round(Number(CTRL.taskcount.value)) || 1)
      : (bucketById(CTRL.bucket.value)?.median ?? 1);

  // ---- render -------------------------------------------------------------
  const widthOf = (el: Element) => Math.max(300, Math.round(el.getBoundingClientRect().width));
  function patchGroups(layout: HTMLElement, html: string) {
    const tpl = document.createElement('template'); tpl.innerHTML = html;
    const next = Array.from(tpl.content.querySelectorAll<HTMLElement>('[data-group]'));
    const cur = Array.from(layout.querySelectorAll<HTMLElement>('[data-group]'));
    if (next.length !== cur.length || next.some((n, i) => n.dataset.group !== cur[i].dataset.group)) { layout.innerHTML = html; return; }
    next.forEach((n, i) => {
      patchRanked(cur[i].querySelector('[data-chart]')!, n.querySelector('[data-chart]')!.innerHTML);
      const nc = n.querySelector('[data-count]'), cc = cur[i].querySelector('[data-count]');
      if (nc && cc) cc.textContent = nc.textContent;
    });
  }

  let last: Settings | null = null;
  let lastRows: Row[] = [];
  function render(pushUrl = true) {
    const s = settings();
    last = s;
    $('c-cache-v')!.textContent = `${CTRL.cache.value}%`;
    CTRL.cache.style.setProperty('--fill', `${(Number(CTRL.cache.value) / 90) * 100}%`);
    const tierHelpText = `${TIER_HELP[s.tier]} · Tier: ${s.tier} — measured rows unchanged.`;
    $('c-tier-help')!.textContent = tierHelpText;
    $('c-tier-help-bucket')!.textContent = tierHelpText;
    const { rows, missing } = compute(s);
    lastRows = rows;
    if (mode === 'bucket') {
      const taskCount = effectiveTaskCount();
      $('c-callout')!.innerHTML = projectTotalHtml(rows, taskCount);
      const b = bucketById(CTRL.bucket.value);
      $('c-provenance')!.innerHTML = b ? provenanceHtml(b) : otherProvenanceHtml(taskCount);
    } else {
      $('c-callout')!.innerHTML = calloutHtml(rows, s.volume);
      $('c-provenance')!.innerHTML = '';
    }
    const wideEl = groupsEl.querySelector<HTMLElement>('[data-layout="wide"]')!;
    const narrowEl = groupsEl.querySelector<HTMLElement>('[data-layout="narrow"]')!;
    const visible = wideEl.offsetParent ? wideEl : narrowEl;
    const w = widthOf(visible.querySelector('[data-chart]') ?? visible);
    const projectLabel = mode === 'bucket' ? (bucketById(CTRL.bucket.value)?.label ?? (CTRL.bucket.value === 'other' ? 'your project' : undefined)) : undefined;
    patchGroups(wideEl, groupsHtml(rows, s, { width: visible === wideEl ? w : Number(groupsEl.dataset.wide), compact: false, highlight, sort: groupSort, sortable: true, only: currentPop, project: projectLabel }));
    patchGroups(narrowEl, groupsHtml(rows, s, { width: visible === narrowEl ? w : Number(groupsEl.dataset.narrow), compact: true, highlight, sort: groupSort, sortable: true, only: currentPop, project: projectLabel }));
    $('c-missing')!.innerHTML = missingHtml(missing, highlight ? models.find((m) => m.model_id === highlight)?.display_name : undefined);
    $('c-missing-d')!.querySelector('[data-count]')!.textContent = String(missing.length);
    renderScatter(rows, s);
    sizeInline();
    if (pushUrl) {
      const p = new URLSearchParams({ tier: s.tier, volume: String(s.volume), variant: s.variant,
        cache: CTRL.cache.value, residual: String(s.residual), frontier: s.frontier ? '1' : '0',
        mode, bucket: CTRL.bucket.value });
      if (CTRL.bucket.value === 'other') p.set('taskcount', CTRL.taskcount.value);
      if (highlight) p.set('highlight', highlight);
      if (currentPop !== GROUP_TABS[0].key) p.set('pop', currentPop);
      history.replaceState(null, '', `${location.pathname}?${p}`);
    }
  }

  // The Frontier view of the leaderboard (stage 1.2, Roy's note 6) follows
  // the same settings as the Ranking view; it only needs to actually
  // re-render while visible (view === 'frontier'), same instant-swap
  // discipline as the toggle itself.
  const frontier = document.querySelector<HTMLElement>('#c-frontier');
  function renderScatter(rows: Row[], s: Settings) {
    if (!frontier || frontier.classList.contains('hidden')) return;
    const all = allChartRows(rows, s);
    const lead = all.find((r) => r.basis === 'measured')?.id;
    frontier.querySelectorAll<HTMLElement>('[data-chart]').forEach((slot) => {
      const compact = slot.dataset.layout === 'narrow';
      const w = slot.offsetParent ? widthOf(slot) : Number(slot.dataset.w);
      slot.innerHTML = scatterPareto(all, { width: w, height: compact ? w : undefined, compact, lead, rail: !compact });
    });
  }

  // ---- Ranking | Frontier toggle: instant swap, no scrolling --------------
  const viewRankingBtn = $<HTMLButtonElement>('c-view-ranking')!, viewFrontierBtn = $<HTMLButtonElement>('c-view-frontier')!;
  function setView(next: 'ranking' | 'frontier') {
    const isFrontier = next === 'frontier';
    groupsEl.classList.toggle('hidden', isFrontier);
    frontier?.classList.toggle('hidden', !isFrontier);
    viewRankingBtn.setAttribute('aria-pressed', String(!isFrontier));
    viewFrontierBtn.setAttribute('aria-pressed', String(isFrontier));
    if (isFrontier) renderScatter(lastRows, last ?? settings());
  }
  viewRankingBtn.addEventListener('click', () => setView('ranking'));
  viewFrontierBtn.addEventListener('click', () => setView('frontier'));

  // The designed hover tooltip for frontier points (moved from the old
  // index.astro scatter section, stage 1.2): name / $ / pass / harness, 8px
  // off the pointer. The aria-label on each point carries the same sentence
  // for assistive tech; this is the sighted copy.
  const frontierTip = document.getElementById('c-frontier-tip');
  if (frontier && frontierTip) {
    const showTip = (a: Element, x: number, y: number) => {
      const d = (a as HTMLElement).dataset;
      const name = document.createElement('b'); name.textContent = d.name ?? '';
      const detail = document.createTextNode(`${d.basis} · ${d.cost} per solved task`);
      const br = document.createElement('br');
      const pass = document.createTextNode(`pass ${d.pass}${d.harness ? ` · ${d.harness}` : ''}`);
      frontierTip.replaceChildren(name, detail, br, pass);
      const r = frontier.getBoundingClientRect();
      let left = x - r.left + 8, top = y - r.top + 8;
      frontierTip.style.left = '0'; frontierTip.style.top = '0';
      const tw = (frontierTip as HTMLElement).offsetWidth, th = (frontierTip as HTMLElement).offsetHeight;
      if (left + tw > r.width - 8) left = x - r.left - tw - 8;
      if (top + th > r.height - 8) top = y - r.top - th - 8;
      (frontierTip as HTMLElement).style.left = `${Math.max(0, left)}px`; (frontierTip as HTMLElement).style.top = `${Math.max(0, top)}px`;
      frontierTip.setAttribute('data-show', '1');
    };
    const hideTip = () => frontierTip.removeAttribute('data-show');
    frontier.addEventListener('pointerover', (e) => { const a = (e.target as Element).closest('a.pt'); if (a) showTip(a, e.clientX, e.clientY); });
    frontier.addEventListener('pointermove', (e) => { const a = (e.target as Element).closest('a.pt'); if (a && frontierTip.hasAttribute('data-show')) showTip(a, e.clientX, e.clientY); });
    frontier.addEventListener('pointerout', (e) => { if ((e.target as Element).closest('a.pt')) hideTip(); });
    frontier.addEventListener('focusin', (e) => { const a = (e.target as Element).closest('a.pt'); if (a) { const b = a.getBoundingClientRect(); showTip(a, b.right, b.top); } });
    frontier.addEventListener('focusout', hideTip);
  }

  // ---- find a model: expands the right group and pins the row -------------
  const findQ = $<HTMLInputElement>('c-find-q')!, findMsg = $('c-find-msg')!;
  const byName = (query: string) => {
    const s = query.trim().toLowerCase(); if (!s) return null;
    return models.find((m) => m.display_name.toLowerCase() === s) ?? models.find((m) => m.display_name.toLowerCase().startsWith(s)) ?? models.find((m) => m.display_name.toLowerCase().includes(s)) ?? null;
  };
  const missingFind = $('c-missing-find')!;
  function pin(query: string) {
    const m = byName(query);
    missingFind.textContent = '';
    if (!m) { if (query.trim()) findMsg.textContent = `No tracked model called “${query.trim()}”.`; else { findMsg.textContent = ''; highlight = undefined; render(); } return; }
    highlight = m.model_id; render();
    const visible = groupsEl.querySelector<HTMLElement>('[data-layout="wide"]')!.offsetParent ? 'wide' : 'narrow';
    const row = groupsEl.querySelector<SVGGElement>(`[data-layout="${visible}"] .row.hl`);
    if (row) {
      const d = row.closest('details'); if (d) d.open = true;
      findMsg.textContent = `${m.display_name} is pinned in the ${row.closest<HTMLElement>('[data-group]')!.dataset.group} group.`;
      row.scrollIntoView({ block: 'center' });
    } else {
      // the message is rendered at the destination, not beside the input
      const missingD = $('c-missing-d')!;
      findMsg.textContent = '';
      missingFind.textContent = `${m.display_name} has no published pass rate — listed below with its verified prices, awaiting measurement.`;
      missingD.scrollIntoView({ block: 'center' });
    }
  }
  $('c-find')!.addEventListener('submit', (e) => { e.preventDefault(); pin(findQ.value); });
  // fires on a datalist pick (an input event with no inputType) and, debounced, while typing
  let findTimer = 0;
  findQ.addEventListener('input', (e) => {
    clearTimeout(findTimer);
    const picked = !(e as InputEvent).inputType;
    if (picked || !findQ.value.trim()) { pin(findQ.value); return; }
    findTimer = window.setTimeout(() => pin(findQ.value), 300);
  });
  findQ.addEventListener('change', () => { clearTimeout(findTimer); pin(findQ.value); });

  // ---- gate (docs/landing-spec.md §3; one switch in src/lib/gate.ts) ------
  // Soft gate, demo first: the first assumption change is applied so the
  // visitor sees the rows move, then the card beneath them names the concrete
  // delta. "Keep exploring" reverts to the values before the touch. Once per
  // session; after that an assumption touch opens the sign-up modal directly.
  const gated = section.dataset.gated === '1';
  const MODE = section.dataset.gateMode as GateMode;
  const ss = { get: (k: string) => { try { return sessionStorage.getItem(k) === '1'; } catch { return false; } },
               set: (k: string) => { try { sessionStorage.setItem(k, '1'); } catch {} } };
  const gateCard = $('c-gate')!;
  let demo: { before: Settings; beforeRows: Row[]; trigger: HTMLElement } | null = null;
  const CONTROL_LABEL = (el: HTMLInputElement | HTMLSelectElement): string => {
    switch (el.dataset.ctl as Control) {
      case 'cache': return `Cache ${CTRL.cache.value}%`;
      case 'residual': return `Takeover $${Number(CTRL.residual.value || 0).toLocaleString()}`;
      case 'frontier': return `Frontier efficiency ${CTRL.frontier.checked ? 'on' : 'off'}`;
      default: return 'That change';
    }
  };
  const applySettings = (s: Settings) => {
    CTRL.tier.value = s.tier; CTRL.volume.value = String(s.volume); syncSlider();
    CTRL.variant.value = s.variant; CTRL.cache.value = String(Math.round(s.cache * 100));
    CTRL.residual.value = String(s.residual); CTRL.frontier.checked = s.frontier;
  };
  const restore = (el: HTMLInputElement | HTMLSelectElement) => {
    if (!last) return;
    switch (el.dataset.ctl as Control) {
      case 'tier': el.value = last.tier; break;
      case 'volume': CTRL.volume.value = String(last.volume); syncSlider(); break;
      case 'variant': el.value = last.variant; break;
      case 'cache': el.value = String(Math.round(last.cache * 100)); break;
      case 'residual': el.value = String(last.residual); break;
      case 'frontier': (el as HTMLInputElement).checked = last.frontier; break;
    }
  };
  /** true = let the change through; sets up the demo card on a first soft touch */
  function allow(el: HTMLInputElement | HTMLSelectElement, ev: Event): boolean {
    if (!gated || signedIn()) return true;
    const cls = gateFor(el.dataset.ctl as Control, MODE);
    if (cls === 'free') return true;
    if (demo) return true;                         // the demo is running: keep showing the effect
    if (cls === 'hard' || ss.get(GATE_SEEN_KEY)) { // seen this session: the modal, directly
      ev.stopImmediatePropagation(); restore(el); gateSignUp(); return false;
    }
    demo = { before: last ?? settings(), beforeRows: lastRows, trigger: el };
    return true;
  }
  const assumeNote = $('c-assume-note')!;
  const NOOP_NOTE = (el: HTMLInputElement | HTMLSelectElement, text: string) =>
    el.dataset.ctl === 'frontier' ? 'Frontier efficiency only applies on the heavy tier; nothing moves here.' : text;
  function afterRender(el: HTMLInputElement | HTMLSelectElement) {
    if (gateFor(el.dataset.ctl as Control, MODE) === 'free') return;
    if (!demo) { assumeNote.textContent = ''; return; }
    const d = gateDelta(demo.beforeRows, lastRows, CONTROL_LABEL(el), highlight);
    if (!d.moved && gateCard.classList.contains('hidden')) {
      // a change that moves no row is not gated: a quiet note, the control stays free
      demo = null;
      assumeNote.textContent = NOOP_NOTE(el, d.text);
      return;
    }
    assumeNote.textContent = '';
    $('c-gate-delta')!.textContent = d.text;
    if (gateCard.classList.contains('hidden')) {
      ss.set(GATE_SEEN_KEY);
      gateCard.classList.remove('hidden');
      document.body.setAttribute('data-gate-open', '1');
      gateCard.scrollIntoView({ block: 'nearest' });
      $('c-gate-signin')?.focus({ preventScroll: true });
    }
  }
  function closeGate(revert: boolean) {
    const d = demo; demo = null;
    gateCard.classList.add('hidden');
    document.body.removeAttribute('data-gate-open');
    if (d && revert) { applySettings(d.before); render(); }
    d?.trigger.focus();
  }
  const gateSignUp = () => openSignUp('gate', `Keep these assumptions — save “${scenarioName()}” to your free account.`);
  $('c-gate-signin')?.addEventListener('click', gateSignUp);
  $('c-gate-skip')?.addEventListener('click', () => closeGate(true));
  gateCard.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); closeGate(true); } });
  wireSave($<HTMLButtonElement>('c-save'), 'Save scenario', scenarioName);
  onClerk(() => { if (signedIn()) { demo = null; gateCard.classList.add('hidden'); document.body.removeAttribute('data-gate-open'); } });

  // ---- wiring -------------------------------------------------------------
  const inputs = [CTRL.tier, CTRL.volume, CTRL.variant, CTRL.cache, CTRL.residual, CTRL.frontier];
  for (const el of inputs) {
    el.addEventListener('input', (ev) => { if (!allow(el, ev)) return; if (el === CTRL.volume) syncSlider(); render(); afterRender(el); });
    el.addEventListener('change', (ev) => { if (!allow(el, ev)) return; });
  }
  CTRL.range.addEventListener('input', (ev) => {
    if (!allow(CTRL.range, ev)) return;
    const v = sliderToVolume(Number(CTRL.range.value));
    CTRL.volume.value = String(v);
    syncSlider();
    render();
  });

  // ---- bucket-mode controls: tier select is mirrored between the hero's
  // monthly-mode sentence (#c-tier) and the bucket-mode answer row
  // (#c-tier-bucket) — one value, two positions, same pattern as the
  // volume number box and range slider above.
  CTRL.tier.addEventListener('input', () => { CTRL.tierBucket.value = CTRL.tier.value; });
  CTRL.tierBucket.addEventListener('input', (ev) => {
    CTRL.tier.value = CTRL.tierBucket.value;
    if (!allow(CTRL.tier, ev)) return;
    render();
    afterRender(CTRL.tier);
  });
  CTRL.bucket.addEventListener('input', () => {
    const isOther = CTRL.bucket.value === 'other';
    otherRow.classList.toggle('hidden', !isOther);
    syncBucketArticle();
    if (!isOther) {
      const b = bucketById(CTRL.bucket.value);
      if (b) CTRL.taskcount.value = String(b.median);
    } else {
      CTRL.taskcount.focus();
    }
    render();
  });
  CTRL.taskcount.addEventListener('input', () => { if (CTRL.bucket.value === 'other') render(); });
  modeToggle.addEventListener('click', () => { applyMode(mode === 'bucket' ? 'monthly' : 'bucket'); render(); });

  wireCopy($<HTMLButtonElement>('c-share')!, () => location.href);

  // re-layout on resize (width changes only; row heights are fixed)
  let raf = 0, lastW = 0;
  new ResizeObserver(() => {
    const w = widthOf(groupsEl);
    if (w === lastW) return; lastW = w;
    cancelAnimationFrame(raf); raf = requestAnimationFrame(() => render(false));
  }).observe(groupsEl);
  // The Frontier view isn't part of groupsEl's box (it's hidden while
  // Ranking is active, so it never drives the observer above) — its own
  // observer keeps it in step whenever it's the visible tab; renderScatter
  // already no-ops while #c-frontier is hidden.
  if (frontier) {
    let frontierRaf = 0, frontierLastW = 0;
    new ResizeObserver(() => {
      const w = widthOf(frontier);
      if (w === frontierLastW) return; frontierLastW = w;
      cancelAnimationFrame(frontierRaf); frontierRaf = requestAnimationFrame(() => renderScatter(lastRows, last ?? settings()));
    }).observe(frontier);
  }
  render(false);
  if (highlight) {
    const row = document.querySelector('.row.hl');
    const d = row?.closest('details'); if (d) d.open = true;
    row?.scrollIntoView({ block: 'center' });
  }
</script>
