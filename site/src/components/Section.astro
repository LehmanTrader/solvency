---
/** A chart-led section: eyebrow, title, one-line caption, then the figure. */
interface Props { id: string; eyebrow?: string; title: string; caption?: string; class?: string; }
const { id, eyebrow, title, caption, class: cls = '' } = Astro.props;
---
<section id={id} class={`mt-16 ${cls}`} aria-labelledby={`${id}-h`}>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2 border-b border-[var(--color-rule)] pb-4">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={`${id}-h`} class="h-section mt-1">{title}</h2>
      {caption && <p class="mt-1.5 text-sm text-[var(--color-muted)] max-w-2xl">{caption}</p>}
    </div>
    <slot name="aside" />
  </div>
  <div class="mt-6"><slot /></div>
</section>
