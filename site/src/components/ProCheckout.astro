---
/**
 * Production checkout surface for Solvency Pro.
 *
 * Importer: site/src/pages/pricing.astro, exclusively behind
 * `{CHECKOUT_UI_ENABLED && <ProCheckout />}` where
 * `CHECKOUT_UI_ENABLED = import.meta.env.PUBLIC_STRIPE_CHECKOUT_ENABLED === 'true'`.
 * That flag is hardcoded 'false' in .github/workflows/deploy.yml and wired
 * from the resolve-rollout checkout output in deploy-preview.yml, so this
 * component is dark (never instantiated, never present in dist) unless the
 * paid-launch checklist in docs/handoff-harness-and-paid-tier.md is approved.
 *
 * Contracts matched, read from site/functions/api/checkout.ts and
 * site/functions/api/billing-portal.ts -> site/src/lib/server/billing-api.ts:
 *   POST /api/checkout       body exactly { interval: 'month' | 'year' }
 *                            -> 200 { data: { url } } (Stripe Checkout URL)
 *                            -> 503 SERVICE_UNAVAILABLE when the route is
 *                               disabled server-side; 409 IDEMPOTENCY_CONFLICT
 *                               when an existing subscription must be
 *                               managed in the portal or an attempt is
 *                               already in flight.
 *   POST /api/billing-portal body exactly {} (no keys)
 *                            -> 200 { data: { url } } (Stripe portal URL)
 *                            -> 404 RESOURCE_NOT_FOUND when no billing
 *                               customer exists yet; 503 when disabled.
 * Both require a same-origin POST, `Content-Type: application/json`, a
 * Clerk session bearer token and a valid `Idempotency-Key` header
 * (`/^[A-Za-z0-9._:-]{16,128}$/`) — see pro-checkout-runtime.js.
 *
 * A signed-in user's subscribed state (#pro-checkout-choice hidden,
 * #pro-checkout-subscribed shown) is read from GET /api/entitlement ->
 * site/src/lib/server/entitlement-api.ts, which on success returns 200
 * { data: OwnerEntitlement } (site/src/lib/server/entitlement-store.ts) —
 * `{ tier: 'free'|'pro', active, source, status, billingInterval, ... }`.
 * Any fetch error (auth failure, network, malformed response) or a result
 * that is not exactly `tier: 'pro'` and `active: true` is treated as
 * not-subscribed. This bearer-authenticated GET reuses authenticatedJsonFetch,
 * exactly like createCheckout/createPortal below.
 *
 * The client runtime is imported as raw text (`?raw`) and rendered through
 * `<script is:inline set:html>`, exactly like StripeSandbox.astro /
 * stripe-sandbox-runtime.js: when this component is not instantiated, Astro
 * emits neither this markup nor a dormant JS chunk that could reference
 * /api/checkout or /api/billing-portal in a dark build (see
 * scripts/verify-production-artifact-dark.mjs).
 *
 * Sign-in is triggered the same way the header's #auth-signup button does
 * (openSignIn in clerk-client.ts) — reimplemented locally in the runtime
 * script because an inlined raw-text module script cannot resolve a
 * relative .ts import specifier in the browser.
 */
import proCheckoutRuntime from '../scripts/pro-checkout-runtime.js?raw';
import { CLERK_ENABLED } from '../lib/clerk.ts';

// Final billing disclosure copy, decided at launch. Adapted from the reviewed
// draft in docs/billing-policy-drafts.md — that draft's recommended
// time-limited refund windows were superseded by the owner's decided
// no-refund stance below. Mirrored in /terms and /privacy.
const DISCLOSURE = [
  { label: 'Amount and cadence', copy: 'The exact USD amount and billing cadence ($19/month or $190/year, billed in advance) is confirmed on the Stripe Checkout page before you pay.' },
  { label: 'Auto-renewal', copy: 'The subscription auto-renews at the end of each billing period until cancelled.' },
  { label: 'Cancellation', copy: 'Cancel any time from Manage billing below; Pro access continues through the end of the period already paid for.' },
  { label: 'Refunds', copy: 'All sales are final except where required by law.' },
  { label: 'Tax', copy: 'Prices exclude tax; Solvency does not collect tax at Checkout, and you are responsible for any tax your jurisdiction imposes.' },
  { label: 'Immediate access', copy: 'By subscribing you get immediate access to Pro.' },
];
---
<article class="card card-pad" id="pro-checkout" data-clerk-enabled={CLERK_ENABLED ? 'true' : 'false'} aria-labelledby="pro-checkout-title">
  <p class="label">Pro · subscribe</p>
  <p class="tile-v mt-3">$19/month <span class="text-base font-normal text-[var(--color-muted)]">or $190/year</span></p>

  <div class="mt-4 border-t border-b border-[var(--color-rule)] py-4" id="pro-checkout-funding">
    <p class="text-sm leading-relaxed"><strong>Pro funds the measurements.</strong> Solvency's benchmark runs, the measured cost-per-solved-task data this site exists to publish, are paid for by subscriptions, not by model vendors. One full run of a 90-task-per-model batch costs about $2,700: roughly 142 subscriber-months. You are not just buying software; you are funding independent measurement.</p>
  </div>

  <h3 class="h-card mt-6" id="pro-checkout-title">Keep the budget current</h3>
  <ul class="mt-3 list-disc pl-5 text-sm leading-relaxed">
    <li>Full Composer: up to 24 roles, with custom or contract rates</li>
    <li>Sensitivity, break-even and scenario deltas</li>
    <li>Versioned account saves: 20 plans, 100 versions per plan</li>
    <li>Unlisted share links and JSON, CSV and PNG exports</li>
    <li>Founding rate lock: your rate never increases while subscribed</li>
  </ul>
  <p class="small mt-3">Roadmap, not sold as active features: a re-priced digest email, reusable rate profiles, usage import and an API. Model-price and budget monitoring (alerts) is not sold until it exists. Newly planned (2026-08-27), same rule: the AI spend audit, saved-stack re-pricing alerts, the data API, custom benchmark runs and verified harness-arena badges.</p>

  <div class="mt-5 grid gap-2 sm:grid-cols-2" role="group" aria-label="Subscribe to Solvency Pro" id="pro-checkout-choice">
    <button type="button" class="btn btn-accent min-w-0 w-full whitespace-normal text-center" id="pro-checkout-month" disabled>Upgrade to Pro — $19/month</button>
    <button type="button" class="btn btn-accent min-w-0 w-full whitespace-normal text-center" id="pro-checkout-year" disabled>Upgrade to Pro — $190/year</button>
  </div>
  <div class="mt-5" id="pro-checkout-subscribed" hidden>
    <p class="small" id="pro-checkout-subscribed-status" role="status" aria-live="polite" aria-atomic="true">You're subscribed; Pro is active.</p>
  </div>
  <button type="button" class="btn btn-quiet mt-3" id="pro-checkout-portal" disabled>Manage billing</button>
  <p class="small mt-3" id="pro-checkout-status" role="status" aria-live="polite" aria-atomic="true">Account controls are loading.</p>
  <p class="small mt-2 text-[var(--color-worse)]" id="pro-checkout-error" role="alert" aria-atomic="true"></p>

  <div class="mt-5 border-t border-[var(--color-rule)] pt-4">
    <h4 class="text-sm font-semibold text-[var(--color-ink)]">Before you subscribe</h4>
    <ul class="mt-2 list-disc pl-5 text-sm leading-relaxed">
      {DISCLOSURE.map((item) => (
        <li><strong>{item.label}:</strong> {item.copy}</li>
      ))}
    </ul>
    <p class="small mt-2">Full terms are at <a class="link" href="/terms">Terms</a> and <a class="link" href="/privacy">Privacy policy</a>.</p>
  </div>
</article>

<!-- `?raw` plus an inline module is intentional: when the build-time gate is
     false, ProCheckout is never instantiated, so Astro emits neither this
     markup nor a dormant JS chunk referencing /api/checkout or
     /api/billing-portal. -->
<script is:inline type="module" set:html={proCheckoutRuntime}></script>

<style>
  /* Same technique as #auth-signup:disabled in global.css (kept local here
     because global.css is owned by another change in flight): an amber
     btn-accent commit action must stay amber while SSR'd disabled, so the
     page never flashes dark -> amber once Clerk finishes loading. */
  #pro-checkout-month:disabled, #pro-checkout-month:disabled:hover, #pro-checkout-month:disabled:active,
  #pro-checkout-year:disabled, #pro-checkout-year:disabled:hover, #pro-checkout-year:disabled:active {
    background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); cursor: not-allowed;
  }
</style>
