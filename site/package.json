{
  "name": "solvency-site",
  "type": "module",
  "private": true,
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node --experimental-strip-types scripts/render-security-headers.ts && npm run check:links",
    "build:functions": "wrangler pages functions build functions --outdir .wrangler/functions-build --project-directory . --build-output-directory dist",
    "check:migrations": "node scripts/verify-migration-checksums.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify:production-dark": "node scripts/verify-production-dark.mjs",
    "smoke:account-preview": "node scripts/smoke-account-plans.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/sitemap": "^3.7.3",
    "@clerk/backend": "3.16.10",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^7.2.4",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.28",
    "@playwright/test": "1.62.1",
    "wrangler": "4.125.0"
  }
}
