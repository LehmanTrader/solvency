/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://clerk.solvency.dev https://static.cloudflareinsights.com https://challenges.cloudflare.com https://*.protect.clerk.com; connect-src 'self' https://clerk.solvency.dev https://clerk-telemetry.com https://*.clerk-telemetry.com https://cloudflareinsights.com https://*.protect.clerk.com:*; img-src 'self' data: https://img.clerk.com; font-src 'self'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; frame-src https://challenges.cloudflare.com https://*.protect.clerk.com; upgrade-insecure-requests

# The embed widget exists to be framed by third-party pages.
/embed/table
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'
/embed/table/*
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors *; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'
