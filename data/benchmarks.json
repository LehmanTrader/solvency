{
  "$schema_version": "2.0.0",
  "description": "Public benchmark results used as pass-rate inputs. Solvency needs only pass_rate from a benchmark; cost is normally recomputed from current verified prices in models.json. Sources that publish their own measured per-task cost are marked cost_basis='measured_by_source' and bypass Solvency's loop model entirely.",
  "redistribution_policy": "Every row here is THIRD-PARTY data, ingested by reference. None of it may be republished in Solvency's CC-BY /data export. Rows carry redistributable=false and must be surfaced as attributed, linked citations only. Only Solvency's own Phase 3 measured runs are published as open data.",
  "cost_bases": {
    "measured_by_source": "The source ran the model and observed the cost. Uses real token usage; no Solvency loop-count assumption applies. Priced at the source's own pricing snapshot, which Solvency cannot recompute without per-model token counts.",
    "modelled_by_solvency": "The source publishes only a pass rate. Cost comes from Solvency's loop model (an ASSUMPTION) times current verified prices.",
    "historical_at_run_date": "The source published a cost, but at the prices in force on run_date. Never displayed as a current figure."
  },
